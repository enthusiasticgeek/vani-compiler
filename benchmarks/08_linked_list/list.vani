// vani-lang: english
// Benchmark 08 — Index-based linked list vs pointer-linked list, 1 000 000 nodes
// (renamed per reviewer recommendation)
//
// WHAT IS BEING MEASURED:
//   This is NOT a pure language comparison — it compares two different data structures:
//     vāṇī / C:   index-based (two flat arrays: values[], next[])
//     C++ / Rust: pointer-linked nodes (one heap allocation per node)
//
// INDEX-BASED LAYOUT (vāṇī / C):
//   values[i] = payload of node i
//   next[i]   = index of next node; (0 - 1) = end-of-list sentinel
//   All N nodes share two Vec allocations — no per-node malloc.
//   Traversal is sequential array reads: values[] and next[] stay in L1/L2.
//
// POINTER-LINKED LAYOUT (C++ / Rust):
//   struct Node { int64_t value; Node* next; }  /  struct Node { val, next: Box<Node> }
//   N separate heap allocations; nodes scattered across the heap.
//   Traversal follows raw pointers: every next->value is a potential cache miss.
//   The ~55% slowdown vs vāṇī is the cache-miss penalty, not a compiler difference.
//
// ARCHITECTURAL MESSAGE:
//   vāṇī's lack of raw pointers (affine ownership) naturally pushes programmers
//   toward index-based representations. This is a language-design win, not a
//   compiler-quality win — the same benefit is available in C (list.c uses the
//   same index trick and produces similar timing: ~15ms vs ~14ms).
//
// Compare with list.c (C index), list.cpp (C++ pointer-linked), list.rs (Rust pointer-linked).

intent "Benchmark: index-based linked list — build + traverse 1M nodes";

fn main() -> i64 {
    let n: i64 = 1000000;
    let values: Vec<i64> = vec_with_capacity(n);
    let next: Vec<i64>   = vec_with_capacity(n);

    // Build list: node i points to node i+1; last node ends with (0-1).
    let i: i64 = 0;
    while i < n {
        let _ = push_unchecked(mut ref values, i % 1000);
        let _ = push_unchecked(mut ref next, i + 1);
        i = i + 1;
    }
    let _ = set(mut ref next, (n - 1) as u64, 0 - 1);

    // Traverse and accumulate.
    let sum: i64 = 0;
    let curr: i64 = 0;
    while curr != (0 - 1) {
        sum  = sum + values[curr];
        curr = next[curr];
    }
    print sum;
    return 0;
}
