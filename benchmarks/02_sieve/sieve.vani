// vani-lang: english
// Benchmark 02 — Sieve of Eratosthenes, primes ≤ 2 000 000
// Expected output: 148933
//
// Uses set(mut ref sieve, j as u64, 0) — the in-place element-write form
// introduced in v0.3. This writes directly through the Vec pointer without
// any struct copy, closing the ~3× gap vs C that the old consuming
// set(sieve, j, 0) form had.

intent "Benchmark: Sieve of Eratosthenes — dense in-place Vec writes";

fn main() -> i64 {
    let limit: i64 = 2000000;

    // Initialise sieve: 1 = possibly prime, 0 = composite.
    let sieve: Vec<i64> = vec();
    let k: i64 = 0;
    while k <= limit {
        let _ = push(mut ref sieve, 1);
        k = k + 1;
    }
    let _ = set(mut ref sieve, 0 as u64, 0);
    let _ = set(mut ref sieve, 1 as u64, 0);

    // Mark composites.
    let i: i64 = 2;
    while i * i <= limit {
        if sieve[i] == 1 {
            let j: i64 = i * i;
            while j <= limit {
                let _ = set(mut ref sieve, j as u64, 0);
                j = j + i;
            }
        }
        i = i + 1;
    }

    // Count primes.
    let count: i64 = 0;
    let m: i64 = 2;
    while m <= limit {
        if sieve[m] == 1 {
            count = count + 1;
        }
        m = m + 1;
    }
    print count;
    return 0;
}
