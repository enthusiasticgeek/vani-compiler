// vani-lang: english
// Benchmark 07 — HashMap: 500 000 insert + 500 000 lookup
//
// Uses the built-in hashmap_new / hashmap_insert / hashmap_get.
// The implementation is open-addressing linear-probing with FNV-1a hashing.
// Key = value = i64 (Copy type — no ownership complications).

intent "Benchmark: HashMap<i64,i64> throughput — 500K insert + 500K lookup";

fn main() -> i64 {
    let n: i64 = 500000;
    let m: HashMap<i64, i64> = hashmap_with_capacity(n);

    // Insert n key/value pairs.
    let i: i64 = 0;
    while i < n {
        let _ = hashmap_insert(mut ref m, i, i * i);
        i = i + 1;
    }

    // Look up all keys; accumulate values to prevent dead-code elimination.
    let sum: i64 = 0;
    let j: i64 = 0;
    while j < n {
        let opt: Option<i64> = hashmap_get(ref m, j);
        let v: i64 = match opt {
            Option.Some(x) then x,
            Option.None    then 0,
        };
        sum = sum + v;
        j = j + 1;
    }

    print hashmap_len(ref m);
    print sum;
    return 0;
}
