// vani-lang: english
// Benchmark 06 — Parallel sum of 50 000 000 elements
//
// vāṇī expresses data-parallel reductions with three extra keywords:
//   parallel for i from 0 to n
//   reduce total with +;
//   { total = total + data[i]; }
//
// The compiler emits `#pragma omp parallel for reduction(+:total)`
// (C backend) or `atomicrmw add` with a thread-outlined loop body
// (LLVM backend).  The verifier proves race-freedom statically —
// no data-race annotation or unsafe block required.
//
// Compare with:
//   parsum.c   — OpenMP (same pragma, requires -fopenmp)
//   parsum.cpp — OpenMP
//   parsum.rs  — manual std::thread split-and-join

intent "Benchmark: parallel reduction sum — tests vāṇī parallel-for with reduce";

fn main() -> i64 {
    let n: i64 = 50000000;

    // Build data array: values are i % 1000 so total is computable.
    // vec_fill(n, 0) pre-allocates with len=n (no len update per iteration),
    // then set() overwrites each element — no loop-carried len dependency,
    // so LLVM can vectorize both the fill and the subsequent parallel sum.
    let data: Vec<i64> = vec_fill(n, 0 as i64);
    let i: i64 = 0;
    while i < n {
        let _ = set(mut ref data, i as u64, i % 1000);
        i = i + 1;
    }

    // Parallel reduction — compiler handles thread spawning + combining.
    let total: i64 = 0;
    parallel for i from 0 to n
    reduce total with +;
    {
        total = total + data[i];
    }

    print total;
    return 0;
}
