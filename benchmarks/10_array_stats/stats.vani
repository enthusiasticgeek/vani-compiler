// vani-lang: english
// Benchmark 10 — Mean and integer variance of 10 000 000 values
//
// Two parallel passes over a large Vec<i64>:
//   Pass 1: parallel reduce sum  → mean = sum / n
//   Pass 2: parallel reduce (x - mean)^2 → variance = sum_sq / n
//
// Using `parallel for ... reduce` to multi-core both passes.
// The sequential `while` form is left commented below for reference.

intent "Benchmark: mean + variance of 10M integers — parallel reduce both passes";

fn main() -> i64 {
    let n: i64 = 10000000;

    // Generate data: deterministic pattern to match other variants.
    let data: Vec<i64> = vec_with_capacity(n);
    let i: i64 = 0;
    while i < n {
        data = push(data, (i * 7 + 13) % 1000);
        i = i + 1;
    }

    // Pass 1: parallel sum.
    let sum: i64 = 0;
    parallel for j from 0 to n
    reduce sum with +;
    {
        sum = sum + data[j];
    }
    let mean: i64 = sum / n;

    // Pass 2: parallel variance (integer arithmetic).
    let var_sum: i64 = 0;
    parallel for k from 0 to n
    reduce var_sum with +;
    {
        let diff: i64 = data[k] - mean;
        var_sum = var_sum + diff * diff;
    }
    let variance: i64 = var_sum / n;

    print mean;
    print variance;
    return 0;
}
