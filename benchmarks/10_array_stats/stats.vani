// vani-lang: english
// Benchmark 10 — Mean and integer variance of 10 000 000 values
//
// Two sequential passes over a large Vec<i64>:
//   Pass 1: accumulate sum  → mean = sum / n
//   Pass 2: accumulate (x - mean)^2 → variance = sum_sq / n
// Tests plain sequential arithmetic loop throughput.

intent "Benchmark: mean + variance of 10M integers — sequential arithmetic loops";

fn main() -> i64 {
    let n: i64 = 10000000;

    // Generate data: deterministic pattern to match other variants.
    let data: Vec<i64> = vec();
    let i: i64 = 0;
    while i < n {
        data = push(data, (i * 7 + 13) % 1000);
        i = i + 1;
    }

    // Pass 1: sum.
    let sum: i64 = 0;
    let j: i64 = 0;
    while j < n {
        sum = sum + data[j];
        j = j + 1;
    }
    let mean: i64 = sum / n;

    // Pass 2: variance (integer arithmetic).
    let var_sum: i64 = 0;
    let k: i64 = 0;
    while k < n {
        let diff: i64 = data[k] - mean;
        var_sum = var_sum + diff * diff;
        k = k + 1;
    }
    let variance: i64 = var_sum / n;

    print mean;
    print variance;
    return 0;
}
