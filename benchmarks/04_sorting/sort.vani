// vani-lang: english
// Benchmark 04 — Sort 1 000 000 pseudo-random integers
//
// ALGORITHM DOCUMENTATION (reviewer checklist):
//   vāṇī:  sort(mut ref xs) → delegates to C library qsort() via typed i64 comparator.
//           Algorithm: libc qsort — typically introsort (quicksort + heapsort fallback).
//           Stability: UNSTABLE (qsort does not guarantee stable ordering).
//           Complexity: O(N log N) average and worst case.
//
//   C:      qsort() with explicit comparator — same algorithm, same instability.
//           C is ~86% SLOWER than vāṇī because the comparator is a function pointer
//           call (indirect branch per comparison); the vāṇī backend inlines the
//           comparator into the sort helper, removing the indirect branch.
//
//   C++:    std::sort — introsort (introspective sort), unstable.
//           Comparable to vāṇī (~98 ms vs ~97 ms).
//
//   Rust:   sort_unstable() — pdqsort (pattern-defeating quicksort).
//           Significantly faster (~44 ms) due to block-partitioning, small-array
//           insertion sort, and better pivot selection than classic introsort.
//
// To match Rust's speed, vāṇī would need a pdqsort implementation in the stdlib.
// The current gap (97 ms vs 44 ms) is LIBRARY QUALITY, not compiler quality.
//
// SAME INPUT: LCG with seed 12345678, a=1664525, c=1013904223, mask=2^31-1.
// All variants generate identical sequences; sort order is fully deterministic.

intent "Benchmark: sort 1 000 000 integers using the built-in sort";

fn main() -> i64 {
    let n: i64 = 1000000;

    // Generate pseudo-random data with an LCG.
    let xs: Vec<i64> = vec_with_capacity(n);
    let seed: i64 = 12345678;
    let a: i64 = 1664525;
    let c_val: i64 = 1013904223;
    let mask: i64 = 2147483647;  // 2^31 - 1
    let i: i64 = 0;
    while i < n {
        seed = (a * seed + c_val) % mask;
        xs = push(xs, seed);
        i = i + 1;
    }

    // Sort in place using the built-in introsort.
    let _ = sort(mut ref xs);

    // Verify and print: first + last element as checksum.
    let first: i64 = xs[0];
    let last: i64 = xs[n - 1];
    assert first <= last;
    print first + last;
    return 0;
}
