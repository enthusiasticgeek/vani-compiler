// vani-lang: english
// Benchmark 09 — Allocation stress: 500 000 struct store + read cycles
//
// ALLOCATOR DOCUMENTATION (reviewer checklist):
//   vāṇī:  system malloc (glibc ptmalloc2 on Linux, mimalloc-compatible on MSVC).
//           vec_with_capacity(n) → single malloc(n * sizeof(Payload)).
//           Drop at scope exit → single free(). No per-element alloc or free.
//
//   C:     malloc(N * sizeof(Payload)) — identical to vāṇī's Vec layout.
//           Timing difference reflects struct-access throughput only, not allocator.
//
//   C++:   std::vector<Payload> with push_back() — may reallocate. Uses operator
//           new (wraps malloc). C++ vector calls Payload constructor per element
//           (destructor at scope exit) — explains the ~47% slowdown vs C.
//
//   Rust:  Vec<Payload>::with_capacity(n) then push() — single allocation,
//           no realloc. Uses Rust's global allocator (jemalloc or system malloc
//           depending on crate config). ~36% slower than C likely due to bounds
//           checks on reads (items[j].a, items[j].c) and no SIMD sum pattern.
//
// AFFINE DROP IN vāṇī:
//   The Vec is dropped deterministically at scope exit via affine RAII.
//   No GC pause, no destructor dispatch table, no reference counting.
//   The compiler inlines the drop as a single call to free(data_ptr),
//   identical to C's explicit free() — zero overhead.

intent "Benchmark: allocation stress — Vec push + read + RAII drop";

struct Payload {
    a: i64,
    b: i64,
    c: i64,
}

fn make_payload(i: i64) -> Payload {
    return Payload { a: i, b: i * 2, c: i * 3 };
}

fn main() -> i64 {
    let n: i64 = 500000;

    // Build a Vec<Payload> one element at a time; pre-allocated to match
    // alloc.c's single malloc(N * sizeof(Payload)).
    let items: Vec<Payload> = vec_with_capacity(n);
    let i: i64 = 0;
    while i < n {
        items = push(items, make_payload(i));
        i = i + 1;
    }

    // Read back and accumulate to prevent dead-code elimination.
    let sum: i64 = 0;
    let j: i64 = 0;
    while j < n {
        sum = sum + items[j].a + items[j].c;
        j = j + 1;
    }
    // `items` is dropped here (affine RAII).
    print sum;
    return 0;
}
