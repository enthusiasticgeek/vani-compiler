// candidate regression, qwen-generated (qwen2.5-coder:1.5b), UNREVIEWED
// features: closures capturing by ref, array/Vec bounds and iteration
// compiled and ran cleanly on both backends -- candidate for examples/ or
// tests/run_end_to_end.rs after human/frontier-model review.

// Arc 5c — closure-as-value across fn boundaries.
//
// `Closure(args) -> R` is a fat-pointer struct `{env, call}`
// where `env` is an opaque pointer to the captured environment
// and `call` is a trampoline fn-pointer. Captured anonymous
// fns materialize as Closure values; higher-order fns can
// receive them by-value and call them indirectly.
//
// v1 restriction: env is stored in a per-closure global slot,
// so a Closure cannot outlive the lift-pass instantiation
// site. That's sufficient for "pass to higher-order fn" — the
// common case — without requiring heap allocation.
//
// build & run:
//   vanic run examples/language/english/closure_as_value.vani                # LLVM backend, JIT via lli
//   vanic run examples/language/english/closure_as_value.vani --backend=c    # C backend, gcc
//   vanic build examples/language/english/closure_as_value.vani -o /tmp/array_proofs && /tmp/array_proofs   # native binary

intent "Closure-as-value and array/Vec bounds & iteration: captured anon-fns pass through fn boundaries (Arc 5c)";

fn replace_middle(xs: Vec<i64>) -> Vec<i64>
requires len(xs) >= 3;
ensures len(_return) == len(xs);
ensures _return[0] == xs[0];
ensures _return[1] == 999;
ensures _return[2] == xs[2];
{
  let ys: Vec<i64> = set(xs, 1, 999);

  // Callee-side proof of the touched slot; the ensures clauses
  // above are discharged automatically by the array-theory facts
  // emitted at the `set` call site (length, slot, and store-axiom).
  // `xs` is moved by `set`, so we can't reference it here — but
  // the ensures clauses semantically refer to xs's original value
  // and are satisfied via the store axiom.
  prove ys[1] == 999;
  return ys;
}

fn main() -> i64 {
  let original: Vec<i64> = vec(10, 20, 30);
  let updated: Vec<i64> = replace_middle(original);

  // Caller-side proofs — each ensures is substituted into a fact
  // about the new binding and chained with the literal-init facts
  // for `original`.
  prove updated[0] == 10;
  prove updated[1] == 999;
  prove updated[2] == 30;
  prove len(updated) == 3;

  print updated[0];
  print updated[1];
  print updated[2];
  return 0;
}

