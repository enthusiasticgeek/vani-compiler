// candidate regression, qwen-generated (qwen2.5-coder:1.5b), UNREVIEWED
// features: match with guards over enum payloads, bounded generics with an interface bound
// compiled and ran cleanly on both backends -- candidate for examples/ or
// tests/run_end_to_end.rs after human/frontier-model review.

// build & run:
//   vanic run examples/language/english/match_guard_chain_bounded_generic.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/match_guard_chain_bounded_generic.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/match_guard_chain_bounded_generic.vani -o /tmp/bounded_generics && /tmp/bounded_generics   # native binary

intent "T1.5 phase 3: bounded generics — fn min<T> where T is Cmp and fn max<T> where T is Cmp";

interface Cmp {
  fn cmp(self: Score, other: Score) -> i64;
}

struct Score { value: i64 }

implement Cmp for Score {
  fn cmp(self: Score, other: Score) -> i64 {
    if self.value < other.value { return -1; }
    if self.value > other.value { return 1; }
    return 0;
  }
}

fn min<T>(a: T, b: T) -> T where T is Cmp {
  if a.cmp(b) <= 0 { return a; }
  return b;
}

fn max<T>(a: T, b: T) -> T where T is Cmp {
  if a.cmp(b) >= 0 { return a; }
  return b;
}

// Example usage of min and max with bounded generics
fn main() -> i64 {
  let a: Score = Score { value: 7 };
  let b: Score = Score { value: 3 };
  let m: Score = min(a, b);
  print "min.value =", m.value;
  assert m.value == 3;

  let c: Score = Score { value: 9 };
  let d: Score = Score { value: 4 };
  let x: Score = max(c, d);
  print "max.value =", x.value;
  assert x.value == 9;

  return 0;
}

