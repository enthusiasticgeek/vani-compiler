# Pinned to Debian 12 (bookworm), not the host's 13 (trixie): this is what
# INSTALL.md's own compatibility table has actually verified (z3 4.10+,
# working LLVM/clang via apt) -- trixie is unverified upstream and a
# container gives us the freedom to pick the known-good version anyway.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential z3 llvm clang python3 curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+w "$RUSTUP_HOME" "$CARGO_HOME"

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /repo
ENTRYPOINT ["/entrypoint.sh"]
CMD []
