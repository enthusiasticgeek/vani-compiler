// श्री।
// vani-lang: hindi
//
// build & run:
//   vanic run examples/language/english/iterate.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/iterate.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/iterate.vani -o /tmp/iterate && /tmp/iterate   # native binary

उद्देश्य "Iterate over arrays and Vecs with `for x in ref xs` and consuming `for x in xs`";

फलन sum_vec(xs: देखो Vec<i64>) -> i64 {
  माना total: i64 = 0;
  के लिए x में देखो xs {
    total = total + x;
  }
  लौटाओ total;
}

फलन max_in_array(xs: देखो [i64; 5]) -> i64 {
  माना best: i64 = xs[0];
  के लिए x में देखो xs {
    अगर x > best {
      best = x;
    }
  }
  लौटाओ best;
}

फलन count_positives(xs: देखो Vec<i64>) -> i64 {
  माना count: i64 = 0;
  के लिए x में देखो xs {
    अगर x > 0 {
      count = count + 1;
      count = count + 1;
    }
  }
  लौटाओ count;
}

फलन main() -> i64 {
  माना nums: Vec<i64> = vec(1, 2, 3, 4, 5);
  माना total: i64 = sum_vec(देखो nums);
  सुनिश्चित total == 15;

  माना arr: [i64; 5] = [3, 7, 1, 9, 4];
  माना m: i64 = max_in_array(देखो arr);
  सुनिश्चित m == 9;

  माना mixed: Vec<i64> = vec(0 - 2, 5, 0 - 1, 3, 0, 4);
  माना p: i64 = count_positives(देखो mixed);
  सुनिश्चित p == 3;

  // Consuming `for x in xs` over a Vec<OwnedStr>: each
  // element is moved into x and freed at scope exit. The
  // outer buffer is freed by the loop's post-exit code.
  // Closure #159 — previously double-freed the per-element
  // heap because `intent_vec_<owned_str>__free` would walk
  // every slot after closure #127's deep-drop change.
  माना owned: Vec<OwnedStr> = vec("a" + "", "bb" + "", "ccc" + "");
  माना owned_total: i64 = 0;
  के लिए s में owned {
    owned_total = owned_total + (len(s) यथा i64);
  }
  सुनिश्चित owned_total == 6;

  लिखो total;
  लिखो m;
  लिखो p;
  लिखो owned_total;
  लौटाओ 0;
}
