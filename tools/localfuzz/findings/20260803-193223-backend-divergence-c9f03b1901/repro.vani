// vani-lang: persian
هدف "Persian Box recursive drop smoke-test";
ساختار Bag {
  contents: Box<Vec<i64>>,
}
تابع main() -> i64 {
  فرض v: Vec<i64> = vec(0);
  v = push(v, 10);
  v = push(v, 20);
  v = push(v, 30);
  فرض b: Box<Vec<i64>> = box(v);
  فرض v2: Vec<i64> = vec(0);
  v2 = push(v2, 1);
  فرض کیف: Bag = Bag { contents: box(v2) };
  چاپ "Persian box recursive drop OK";
  بازگشت 0;
}
