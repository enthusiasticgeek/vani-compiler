// vani-lang: cherokee
//
// build & run:
//   vanic run examples/language/cherokee/early_exit.vani              # LLVM
//   vanic run examples/language/cherokee/early_exit.vani --backend=c  # C

ᎤᎲᏍᏛ "Cherokee early-exit (break) smoke-test";

ᏗᎦᏬᏂᎯᏍᏗ main() -> i64 {
  ᎠᏁᎳ n: f64 = 0;
  ᏰᎵᏊ n < 100 {
    ᎢᏳᏃ n == 5 {
      ᎤᎵᏍᎩᏗ;
    }
    n = n + 1;
  }
  ᎯᏍᏗᏎᏍᏗ n == 5;
  ᎠᎴᏂᏍᎬᎢ "Cherokee early exit OK", n;
  ᏗᎬᏎᏗ 0;
}
