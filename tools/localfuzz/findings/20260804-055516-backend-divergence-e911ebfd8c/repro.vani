/* continue outer: skip rest of outer-loop body and start next outer iteration */
fn main() -> i64 {
  let count: f64 = 0;
  outer: for i from 0 to 4 {
    for j from 0 to 4 {
      if j == 2 { continue outer; }   /* skip j=2,3; go to i+1 */
      count = count + 1;
    }
    count = count + 100;   /* never reached — continue outer skips this */
  }
  /* Each i: j=0 (+1), j=1 (+1), j=2 -> continue outer (skips j=3 and +100)
     4 iters * 2 = 8 */
  print count;
  return 0;
}
