// vani-lang: persian
هدف "Persian Option types smoke-test";
شمارش Opt { Some(i64), None }
تابع نتیجه(o: Opt, k: i64) -> i64 {
  بازگشت تطبیق o {
    Opt.Some(v) سپس v,
    Opt.None    سپس k,
  };
}
تابع موجود(o: Opt) -> i64 {
  بازگشت تطبیق o {
    Opt.Some(v) سپس 1,
    Opt.None    سپس 0,
  };
}
تابع main() -> i64 {
  فرض a: Opt = Opt.Some(42);
  فرض b: Opt = Opt.None;
  فرض x: i64 = نتیجه(a, 0);
  فرض y: i64 = نتیجه(b, 100);
  ادعا x == 42;
  ادعا موجود(a) == 1;
  ادعا موجود(b) == 0;
  چاپ "Persian option types OK";
  بازگشت 0;
}
