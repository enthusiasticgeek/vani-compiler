// Arc 8 v3 — state-machine pattern for cooperative async I/O.
//
// The "v3 pattern" composes Arc 5c closure-as-value, the Arc 8
// v1 prelude types, and the v2 epoll + nb I/O primitives into
// a state-machine abstraction users write by hand TODAY. Each
// `async fn echo(fd)` body becomes a struct + a poll function
// + a driver loop. Multiple Tasks can be polled cooperatively
// on a single OS thread — the v2 epoll reactor is the
// underlying multiplexer.
//
// The v3 builtin aliases (`io_recv_async` / `io_send_async` /
// `io_accept_async`) name-reserve the suspend-point semantics
// for the future v3.1 compiler-driven `async fn` -> Task<T>
// transform. Today they map 1:1 to their v2 nb counterparts
// (`tcp_recv_nb` / `tcp_send_buf` / `tcp_accept_nb`) so the
// runtime behavior is identical. When the compiler transform
// lands, calls to `io_*_async` inside an async fn body will
// auto-rewrite to state-machine poll points; today the user
// writes that rewrite by hand.
//
// **What's still v3.1 (compiler-driven sugar):** the parser-
// level rewrite from `async fn foo() -> i64 { let n = await(io_recv_async(fd, 64)); return n; }`
// to the struct + poll fn + constructor below. Until that
// transform ships, hand-rolling is the way.
//
// build & run:
//   intentc run examples/tcp_echo_state_machine.vani                # LLVM
//   intentc run examples/tcp_echo_state_machine.vani --backend=c    # C

intent "Hand-rolled state machine pattern — Arc 8 v3";

// The state-machine struct. Holds all locals alive across
// suspend points + a tag identifying the current state. In a
// real v3.1 compiler transform, this struct gets synthesized
// per-async-fn with one field per kept local.
struct EchoTask {
  state_tag: i64,
  fd: i64,
  bytes: i64,
}

// The poll function. Returns one of:
//   -2 = Pending (would block, re-poll later)
//   -1 = Error
//    n = Ready with value `n`
//
// In a real v3.1 transform, this fn body gets synthesized
// from the original async fn body, with each `await(io_*_async)`
// becoming a suspend point that bumps the state tag and either
// returns -2 or falls through with the produced value.
fn echo_task_poll(t: mut ref EchoTask) -> i64 {
  if t.state_tag == 0 {
    // Suspend-point: await(io_recv_async(fd, 64)). Until v3.1
    // compiler transform lands, call io_recv_async directly.
    let r: i64 = io_recv_async(t.fd, 64);
    if r == 0 - 2 { return 0 - 2; }   // would-block; re-poll later
    if r < 0 { return 0 - 1; }         // hard error
    t.bytes = r;
    t.state_tag = 1;
  }
  if t.state_tag == 1 {
    // Second suspend-point: write the echo back. tcp_send_buf
    // is blocking on a TCP socket where the kernel send buffer
    // has room (typical case for a 64-byte echo). Production
    // code would use io_send_async and re-poll on EAGAIN.
    let m: i64 = tcp_send_buf(t.fd, t.bytes);
    let _ = m;
    return t.bytes;
  }
  return 0 - 1;
}

fn echo_task_new(fd: i64) -> EchoTask {
  return EchoTask { state_tag: 0, fd: fd, bytes: 0 };
}

// Driver: poll the task in a loop, parking on epoll when the
// poll returns Pending. In v3.1, `intent_event_loop_run(task)`
// would replace this driver.
fn drive_task(ep: i64, t: mut ref EchoTask) -> i64 {
  while true {
    let r: i64 = echo_task_poll(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn main() -> i64 {
  let ep: i64 = epoll_new();
  // Keep listener blocking until accept; flip non-blocking AFTER.
  let server: i64 = tcp_listen(0);
  let port: i64 = tcp_socket_port(server);
  print "server bound (port > 0):", port > 0;

  task client {
    let _ = sleep_ms(10);
    let c: i64 = tcp_connect_local(port);
    let _ = tcp_send_str(c, "v3");
    let _ = sleep_ms(50);
    let _ = tcp_close(c);
  }

  let cfd: i64 = tcp_accept(server);
  let _ = tcp_set_nonblocking(cfd);
  let _ = epoll_add_read(ep, cfd);

  let et: EchoTask = echo_task_new(cfd);
  let bytes: i64 = drive_task(ep, mut ref et);
  print "echoed bytes:", bytes;

  join client;
  let _ = tcp_close(cfd);
  let _ = tcp_close(server);
  let _ = epoll_close(ep);
  return 0;
}
