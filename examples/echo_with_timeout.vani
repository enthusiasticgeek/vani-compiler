// Arc 8 v3.1 Phase 2 narrow — control flow inside async fn.
//
// Phase 2 narrow lifts Phase 1's linear-body restriction to
// allow `if` / `while` / `Assign` / `Print` at the top level
// inside an `async fn`, AND mid-body `return` — **provided**
// the embedded branches don't themselves contain `io_*_async`
// suspend points. Branches with suspends need full state-
// splitting codegen and are deferred to Phase 2.1.
//
// This example demonstrates the typical pattern this enables:
// input validation + counter increment + early return on
// failure, woven through real I/O suspend points.
//
// build & run:
//   vanic run examples/echo_with_timeout.vani                # LLVM
//   vanic run examples/echo_with_timeout.vani --backend=c    # C

intent "Phase 2 narrow control flow — async fn with early-return + Assign";

// Phase 2 narrow async fn — body has:
//   - Let (regular i64 local)
//   - If with no suspend in branches (allowed)
//   - Mid-body `return` inside if (allowed)
//   - Assign on outer-scope local (allowed; rewriter emits
//     FieldAssign on __t.attempts)
//   - Two `io_*_async` suspend points
//   - Final Return
async fn echo_with_check(fd: i64, max_attempts: i64) -> i64 {
  let attempts: i64 = 0;
  if max_attempts <= 0 {
    return 0 - 1;
  }
  let n: i64 = io_recv_async(fd, 64);
  attempts = attempts + 1;
  if n <= 0 {
    return 0 - 1;
  }
  let _ = io_send_async(fd, n);
  return n;
}

fn drive(ep: i64, t: mut ref Task__echo_with_check) -> i64 {
  while true {
    let r: i64 = __poll_echo_with_check(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn main() -> i64 {
  let ep: i64 = epoll_new();
  let server: i64 = tcp_listen(0);
  let port: i64 = tcp_socket_port(server);
  print "server bound (port > 0):", port > 0;

  task client {
    let _ = sleep_ms(10);
    let c: i64 = tcp_connect_local(port);
    let _ = tcp_send_str(c, "phase2");
    let _ = sleep_ms(50);
    let _ = tcp_close(c);
  }

  let cfd: i64 = tcp_accept(server);
  let _ = tcp_set_nonblocking(cfd);
  let _ = epoll_add_read(ep, cfd);

  // Task value built by the compiler-synthesized constructor.
  let t: Task__echo_with_check = echo_with_check(cfd, 3);
  let bytes: i64 = drive(ep, mut ref t);
  print "echoed bytes:", bytes;

  join client;
  let _ = tcp_close(cfd);
  let _ = tcp_close(server);
  let _ = epoll_close(ep);
  return 0;
}
