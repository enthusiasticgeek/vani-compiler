// Pre-existing C-backend bug fix (2026-06-06): a struct with a
// `Vec<UserStruct>` field used to fail on the C backend with
// "Struct_<Inner> undeclared" because intent_vec_Struct_<Inner>
// emitted BEFORE Struct_<Inner>. The Vec bundle references both
// `Struct_<Inner>*` (the data pointer field) AND
// `sizeof(Struct_<Inner>)` (inside the bundle's helper fns), so
// the inner struct's full typedef must be visible BEFORE the
// bundle's typedef.
//
// Fix: unified topological emit. Vec<primitive> bundles still
// emit early (since enums-with-Vec-payload depend on them); Vec
// bundles whose element type contains a user struct defer into
// the topo loop alongside struct typedefs, so the ordering
// becomes: Vec<primitive> → struct deps → Vec<UserStruct> →
// structs that use Vec<UserStruct> as a field.
//
// Also fixes the v3.1 task struct case (`async fn foo(...) ->
// i64 { let ps: Vec<Point> = ...; }`) because the synthesized
// Task__foo struct's Vec<Point> field is just a normal struct
// field.
//
// build & run:
//   intentc run examples/vec_struct_field.vani                # LLVM
//   intentc run examples/vec_struct_field.vani --backend=c    # C

intent "Vec<UserStruct> as a struct field — C backend topo-sort fix";

struct Point { x: i64, y: i64 }
struct Holder { ps: Vec<Point> }

fn main() -> i64 {
  let h: Holder = Holder {
    ps: vec(
      Point { x: 1, y: 10 },
      Point { x: 2, y: 20 },
      Point { x: 3, y: 30 }
    )
  };
  print "h.ps[0].x:", h.ps[0].x;
  print "h.ps[1].y:", h.ps[1].y;
  print "h.ps[2].x:", h.ps[2].x;
  return 0;
}
