// Arc 8 v3.1 Phase 2.3b — match arms with suspends, extended
// to Bool / Str / Float literal patterns (in addition to Int +
// Wildcard from Phase 2.3a).
//
// Same desugar approach as Phase 2.3a: `let X = match SCRUT {
// pat0 then e0, ..., _ then ed };` with suspends in any arm
// lowers to a nested `if SCRUT == LIT { X = e0; } else if ...`
// chain. Per-pattern shape only affects the literal Expr
// synthesized for the comparison RHS — the rest of the chain
// is uniform.
//
// Supported in v3.1 Phase 2.3b:
//   - Pattern::Int    (Phase 2.3a)
//   - Pattern::Bool   (NEW)
//   - Pattern::Str    (NEW)
//   - Pattern::Float  (NEW)
//   - Trailing Pattern::Wildcard
//
// Deferred to Phase 2.3c:
//   - Pattern::Variant + Pattern::VariantWithBinding (enum-
//     tag dispatch needs enum metadata not available at parse
//     time; either a later sub-phase or post-typecheck rewrite)
//
// Caveat: v3.1's locals/params restriction is still strict
// (i64-only at param + local position). Non-i64 scrutinees
// must be INLINE expressions (e.g. `mode > 0`, `i64_to_str(x)`,
// `(x * 100) as f64 / 100.0`). Persisting bool/str/f64 across
// await suspend points is Phase 3 work.
//
// build & run:
//   vanic run examples/echo_match_b_s_f.vani                # LLVM
//   vanic run examples/echo_match_b_s_f.vani --backend=c    # C

intent "Phase 2.3b — Bool / Str / Float match patterns with suspends";

async fn pick_bool(fd: i64, mode: i64) -> i64 {
  // Bool scrutinee — inline `mode > 0`.
  let n: i64 = match mode > 0 {
    true then io_recv_async(fd, 64),
    false then 999
  };
  return n;
}

async fn pick_str(fd: i64, mode: i64) -> i64 {
  // Str scrutinee — inline `i64_to_str(mode)`.
  let n: i64 = match i64_to_str(mode) {
    "0" then io_recv_async(fd, 64),
    "1" then 111,
    _ then 0 - 1
  };
  return n;
}

async fn pick_float(fd: i64, mode: i64) -> i64 {
  // Float scrutinee — inline `(mode * 100) as f64 / 100.0`.
  let n: i64 = match (mode * 100) as f64 / 100.0 {
    1.0 then io_recv_async(fd, 64),
    2.0 then 222,
    _ then 0 - 1
  };
  return n;
}

fn drive_bool(ep: i64, t: mut ref Task__pick_bool) -> i64 {
  while true {
    let r: i64 = __poll_pick_bool(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn drive_str(ep: i64, t: mut ref Task__pick_str) -> i64 {
  while true {
    let r: i64 = __poll_pick_str(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn drive_float(ep: i64, t: mut ref Task__pick_float) -> i64 {
  while true {
    let r: i64 = __poll_pick_float(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn main() -> i64 {
  let ep: i64 = epoll_new();
  let server: i64 = tcp_listen(0);
  let port: i64 = tcp_socket_port(server);
  print "server bound (port > 0):", port > 0;

  // ---- Bool branch (true → recv "abc" = 3 bytes) ----
  task peer1 {
    let _ = sleep_ms(10);
    let c: i64 = tcp_connect_local(port);
    let _ = tcp_send_str(c, "abc");
    let _ = sleep_ms(50);
    let _ = tcp_close(c);
  }
  let cfd1: i64 = tcp_accept(server);
  let _ = tcp_set_nonblocking(cfd1);
  let _ = epoll_add_read(ep, cfd1);
  let t_b: Task__pick_bool = pick_bool(cfd1, 5);
  let rb: i64 = drive_bool(ep, mut ref t_b);
  print "bool true (recv):", rb;
  join peer1;
  let _ = tcp_close(cfd1);

  // ---- Bool false branch ----
  let t_bf: Task__pick_bool = pick_bool(cfd1, 0);
  let rbf: i64 = drive_bool(ep, mut ref t_bf);
  print "bool false:", rbf;

  // ---- Str branch ("1" → 111, no suspend) ----
  let t_s: Task__pick_str = pick_str(cfd1, 1);
  let rs: i64 = drive_str(ep, mut ref t_s);
  print "str=1:", rs;

  // ---- Str wildcard branch ("99" → -1) ----
  let t_sw: Task__pick_str = pick_str(cfd1, 99);
  let rsw: i64 = drive_str(ep, mut ref t_sw);
  print "str=99 (wild):", rsw;

  // ---- Float branch (2.0 → 222, no suspend) ----
  let t_f: Task__pick_float = pick_float(cfd1, 2);
  let rf: i64 = drive_float(ep, mut ref t_f);
  print "f=2.0:", rf;

  let _ = tcp_close(server);
  let _ = epoll_close(ep);
  return 0;
}
