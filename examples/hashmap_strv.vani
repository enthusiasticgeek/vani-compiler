// ARC 4.2 — HashMap<i64, OwnedStr>: i64 keys, OwnedStr values.
// Map clones each V internally on insert (same affine workaround
// as ARC 4.1 K=OwnedStr); drop/clear walk free each stored V;
// _remove transfers V ownership to caller; _get returns a clone.
//
// build & run:
//   vanic run examples/hashmap_strv.vani                   # LLVM backend
//   vanic run examples/hashmap_strv.vani --backend=c       # C backend

intent "HashMap<i64, OwnedStr> — i64-keyed string-value map (ARC 4.2)";

fn main() -> i64 {
  let m: HashMap<i64, OwnedStr> = hashmap_new();
  let _ = hashmap_insert(mut ref m, 1, i64_to_str(100));
  let _ = hashmap_insert(mut ref m, 2, i64_to_str(200));
  let _ = hashmap_insert(mut ref m, 1, i64_to_str(999));

  print "contains 1:", hashmap_contains_key(ref m, 1);
  print "contains 2:", hashmap_contains_key(ref m, 2);
  print "contains 42:", hashmap_contains_key(ref m, 42);
  print "len after overwrite (2):", hashmap_len(ref m);

  // _remove transfers V ownership — capture it so the
  // returned OwnedStr gets dropped at scope exit.
  let r: Option<OwnedStr> = hashmap_remove(mut ref m, 1);
  let took: bool = match r {
    Option.Some(v) then true,
    Option.None then false,
  };
  print "remove 1 (true):", took;
  print "contains 1 after remove:", hashmap_contains_key(ref m, 1);
  print "len after remove (1):", hashmap_len(ref m);

  return 0;
}
