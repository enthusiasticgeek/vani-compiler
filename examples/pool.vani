// build & run:
//   intentc run examples/pool.vani                          # LLVM backend
//   intentc run examples/pool.vani --backend=c              # C backend
//   intentc build examples/pool.vani -o /tmp/pool && /tmp/pool

intent "Pool<i64> / Handle<i64> — generational handles (Layer 2 of unsafe.md)";

// Generational handles are the load-bearing safety net of the
// embedded-vāṇी plan. The Pool owns slots; each Handle is a
// (slot_idx, generation) opaque key.
//
//   pool_new()                       -> Pool<i64>
//   pool_alloc(mut ref p, v: i64)    -> Handle<i64>
//   pool_get(ref p, h: Handle<i64>)  -> Option<i64>      None on UAF / double-free
//   pool_free(mut ref p, h)          -> i64 (dummy)
//
// What's safe by construction:
//   - Use-after-free returns Option::None instead of UB.
//   - Double-free is a silent no-op (the second `pool_free` sees a
//     generation mismatch and skips).
//   - Pool's scope-exit drop frees its three heap arrays (slots,
//     generations, free_list).

fn unwrap_or(o: Option<i64>, def: i64) -> i64 {
  return match o {
    Option.Some(v) then v,
    Option.None then def,
  };
}

fn main() -> i64 {
  let p: Pool<i64> = pool_new();

  // Alloc three values. Each handle names a distinct slot.
  let h1: Handle<i64> = pool_alloc(mut ref p, 42);
  let h2: Handle<i64> = pool_alloc(mut ref p, 99);
  let h3: Handle<i64> = pool_alloc(mut ref p, 7);

  // Get returns Some(value) when the handle is still valid.
  print "h1 value:", unwrap_or(pool_get(ref p, h1), 0 - 1);
  print "h2 value:", unwrap_or(pool_get(ref p, h2), 0 - 1);
  print "h3 value:", unwrap_or(pool_get(ref p, h3), 0 - 1);

  // Free h2. The stale handle's get returns None — caught at
  // runtime by the generation check.
  let _ = pool_free(mut ref p, h2);
  print "h2 after free:", unwrap_or(pool_get(ref p, h2), 0 - 1);

  // h1 and h3 are unaffected.
  print "h1 still:", unwrap_or(pool_get(ref p, h1), 0 - 1);
  print "h3 still:", unwrap_or(pool_get(ref p, h3), 0 - 1);

  // Reusing a freed slot: the next pool_alloc reuses slot 1
  // (h2's slot) with a bumped generation. h2 still refers to
  // the old generation, so its pool_get still returns None.
  let h4: Handle<i64> = pool_alloc(mut ref p, 555);
  print "h4 value:", unwrap_or(pool_get(ref p, h4), 0 - 1);
  print "h2 still stale:", unwrap_or(pool_get(ref p, h2), 0 - 1);

  // Double-free of h2 is a silent no-op (generation mismatch).
  let _ = pool_free(mut ref p, h2);
  print "double-free survived";

  return 0;
}
