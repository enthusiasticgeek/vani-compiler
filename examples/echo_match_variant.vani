// Arc 8 v3.1 Phase 2.3c — Variant (enum) patterns in match arms
// with suspends.
//
// Phase 2.3c extends Phase 2.3a/b's literal-pattern desugar to
// unit-variant enum patterns via a TAG-EXTRACTION SUB-MATCH:
//
//   let X = match SCRUT {
//     Color.Red then EXPR0,
//     Color.Green then EXPR1,
//     Color.Blue then EXPR2
//   };
//
// lowers to:
//
//   let X: i64 = 0;
//   let __match_tag_X: i64 = match SCRUT {
//     Color.Red then 0,
//     Color.Green then 1,
//     Color.Blue then 2
//   };
//   if __match_tag_X == 0 { X = EXPR0; }
//   else if __match_tag_X == 1 { X = EXPR1; }
//   else if __match_tag_X == 2 { X = EXPR2; }
//
// The tag-extraction sub-match runs through the existing
// Phase 2.3-narrow variant-dispatch path (its arm bodies are
// just i64 literals — no suspends). The if-chain then handles
// the per-arm suspending bodies via Phase 2.1a/b's state-
// splitting.
//
// Supported in v3.1 Phase 2.3c:
//   - Pattern::Variant — unit variants (no payload)
//   - Optional trailing Pattern::Wildcard
//
// Deferred to Phase 2.3d:
//   - Pattern::VariantWithBinding (`Result.Ok(v) then ...`)
//     — the binding `v` would need to be relifted across the
//     tag-extraction → if-chain split
//   - Mixed Variant + non-Variant patterns in the same match
//
// Caveat: v3.1's i64-only param/local rule still applies.
// Variant scrutinees must be INLINE expressions — e.g. a
// helper fn call returning the variant — because storing the
// variant in a `let act: Action = ...` local would violate
// the i64-only locals constraint.
//
// build & run:
//   intentc run examples/echo_match_variant.vani                # LLVM
//   intentc run examples/echo_match_variant.vani --backend=c    # C

intent "Phase 2.3c — Variant patterns with suspends";

enum Action { Recv, Constant, Wild }

// Helper fn: convert i64 mode -> Action variant. Stays a normal
// fn (not async) so the variant scrutinee for the async match
// is an inline call expression.
fn make_action(mode: i64) -> Action {
  return match mode {
    0 then Action.Recv,
    1 then Action.Constant,
    _ then Action.Wild
  };
}

async fn pick(fd: i64, mode: i64) -> i64 {
  let n: i64 = match make_action(mode) {
    Action.Recv then io_recv_async(fd, 64),
    Action.Constant then 333,
    Action.Wild then 0 - 1
  };
  return n;
}

fn drive(ep: i64, t: mut ref Task__pick) -> i64 {
  while true {
    let r: i64 = __poll_pick(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn main() -> i64 {
  let ep: i64 = epoll_new();
  let server: i64 = tcp_listen(0);
  let port: i64 = tcp_socket_port(server);
  print "server bound (port > 0):", port > 0;

  task peer {
    let _ = sleep_ms(10);
    let c: i64 = tcp_connect_local(port);
    let _ = tcp_send_str(c, "abcd");
    let _ = sleep_ms(50);
    let _ = tcp_close(c);
  }

  let cfd: i64 = tcp_accept(server);
  let _ = tcp_set_nonblocking(cfd);
  let _ = epoll_add_read(ep, cfd);

  // mode=0 -> Action.Recv -> io_recv_async; "abcd" = 4 bytes
  let t0: Task__pick = pick(cfd, 0);
  let r0: i64 = drive(ep, mut ref t0);
  print "mode=0 (Recv):", r0;

  // mode=1 -> Action.Constant -> 333
  let t1: Task__pick = pick(cfd, 1);
  let r1: i64 = drive(ep, mut ref t1);
  print "mode=1 (Constant):", r1;

  // mode=99 -> Action.Wild -> -1
  let t9: Task__pick = pick(cfd, 99);
  let r9: i64 = drive(ep, mut ref t9);
  print "mode=99 (Wild):", r9;

  join peer;
  let _ = tcp_close(cfd);
  let _ = tcp_close(server);
  let _ = epoll_close(ep);
  return 0;
}
