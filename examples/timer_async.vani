// Arc 8 v3.1 Phase 0 — timerfd-backed cooperative sleep.
//
// Demonstrates that `sleep_ms_async(ms)` returns a timerfd
// the user can register with epoll. The event loop yields
// while the timer is pending; `sleep_ms_finish(fd)` reads +
// closes the timer once epoll signals readiness.
//
// Composes with all v2 epoll primitives (`epoll_new`,
// `epoll_add_read`, `epoll_wait_one`, `epoll_close`) for
// true single-thread non-blocking timer behavior — the
// calling thread can do other work between
// `sleep_ms_async` and `sleep_ms_finish`.
//
// build & run:
//   vanic run examples/timer_async.vani                # LLVM
//   vanic run examples/timer_async.vani --backend=c    # C

intent "Cooperative timerfd sleep — Arc 8 v3.1 Phase 0";

fn main() -> i64 {
  let ep: i64 = epoll_new();
  if ep < 0 {
    print "epoll_new failed";
    return 1;
  }

  // Arm a 40ms timer; gets a timerfd back.
  let tfd: i64 = sleep_ms_async(40);
  print "timer armed (fd > 0):", tfd > 0;
  let _ = epoll_add_read(ep, tfd);

  // Wait for the timer to fire. epoll_wait_one returns the
  // fd that's ready (tfd), -2 on timeout, -1 on error. The
  // user could do other work here in real applications.
  let ready: i64 = epoll_wait_one(ep, 200);
  print "ready fd matches timer:", ready == tfd;

  // Read + clear the timer; expirations >= 1 means it fired.
  let expirations: i64 = sleep_ms_finish(tfd);
  print "timer expirations >= 1:", expirations >= 1;

  let _ = epoll_close(ep);
  print "done";
  return 0;
}
