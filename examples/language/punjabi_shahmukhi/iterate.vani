// vani-lang: punjabi-shahmukhi
مقصد "Punjabi Shahmukhi iterate smoke-test";
فنکشن main() -> i64 {
  مانیں فہرست: Vec<i64> = vec();
  فہرست = push(فہرست, 10);
  فہرست = push(فہرست, 20);
  فہرست = push(فہرست, 30);
  یقینی فہرست[0] == 10;
  یقینی فہرست[1] == 20;
  یقینی فہرست[2] == 30;
  مانیں ٹوٹل: i64 = 0;
  مانیں i: i64 = 0;
  تا i < (len(فہرست) بطور i64) {
    ٹوٹل = ٹوٹل + فہرست[i];
    i = i + 1;
  }
  یقینی ٹوٹل == 60;
  لکھو "Punjabi Shahmukhi iterate OK";
  واپس 0;
}
