// vani-lang: japanese
//
// build & run:
//   vanic run examples/language/japanese/option_types.vani              # LLVM
//   vanic run examples/language/japanese/option_types.vani --backend=c  # C

目的 "Japanese Option<T> smoke-test";

関数 安全な割り算(a: i64, b: i64) -> Option<i64> {
  もし b == 0 {
    戻る None;
  }
  戻る Some(a / b);
}

関数 main() -> i64 {
  代入 結果: Option<i64> = 安全な割り算(10, 2);
  一致 結果 {
    Some(v) ならば {
      確認 v == 5;
      表示 "Japanese option OK", v;
    }
    None ならば {
      確認 false;
    }
  }
  戻る 0;
}
