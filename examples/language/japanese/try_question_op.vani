// vani-lang: japanese
//
// build & run:
//   vanic run examples/language/japanese/try_question_op.vani              # LLVM
//   vanic run examples/language/japanese/try_question_op.vani --backend=c  # C

目的 "Japanese ? operator smoke-test";

関数 解析(n: i64) -> Option<i64> {
  もし n < 0 {
    戻る Option.None;
  }
  戻る Option.Some(n * 3);
}

関数 計算(n: i64) -> Option<i64> {
  代入 v: i64 = 解析(n)?;
  戻る Option.Some(v + 1);
}

関数 展開(o: Option<i64>, 既定値: i64) -> i64 {
  戻る 一致 o {
    Option.Some(v) ならば v,
    Option.None ならば 既定値,
  };
}

関数 main() -> i64 {
  代入 良い: Option<i64> = 計算(4);
  代入 v1: i64 = 展開(良い, 0 - 999);
  確認 v1 == 13;
  代入 悪い: Option<i64> = 計算(-1);
  代入 v2: i64 = 展開(悪い, 0 - 999);
  確認 v2 == 0 - 999;
  表示 "Japanese ? op OK";
  戻る 0;
}
