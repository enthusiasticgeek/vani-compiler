// vani-lang: japanese
//
// build & run:
//   vanic run examples/language/japanese/async_cancel_auto.vani              # LLVM
//   vanic run examples/language/japanese/async_cancel_auto.vani --backend=c  # C

目的 "Japanese async/await smoke";

async 関数 delay(ms: i64, v: i64) -> i64 {
  sleep_ms(ms);
  戻る v;
}

関数 main() -> i64 {
  代入 a: i64 = await(delay(5, 42));
  代入 b: i64 = await(delay(10, 7));

  確認 a == 42;
  確認 b == 7;
  表示 "delays:", a, b;
  戻る 0;
}
