// vani-lang: sinhala
//
// build & run:
//   vanic run examples/language/sinhala/control_flow.vani              # LLVM
//   vanic run examples/language/sinhala/control_flow.vani --backend=c  # C

අරමුණ "if/else and while control flow";

කාර්යය sign(x: i64) -> i64 {
  නම් x > 0 {
    ආපසු 1;
  } නැතිනම් {
    නම් x < 0 {
      ආපසු 0 - 1;
    } නැතිනම් {
      ආපසු 0;
    }
  }
}

කාර්යය main() -> i64 {
  තහවුරු sign(5) == 1;
  තහවුරු sign(0 - 3) == 0 - 1;
  තහවුරු sign(0) == 0;

  අනුමානය i: i64 = 0;
  තෙක් i < 5 {
    i = i + 1;
  }
  තහවුරු i == 5;

  ලියන්න sign(42);
  ආපසු 0;
}
