// vani-lang: sinhala
//
// build & run:
//   vanic run examples/language/sinhala/iterate.vani              # LLVM
//   vanic run examples/language/sinhala/iterate.vani --backend=c  # C

අරමුණ "Vec iteration";

කාර්යය main() -> i64 {
  අනුමානය xs: Vec<i64> = vec(10, 20, 30);
  අනුමානය total: i64 = 0;
  සෑම i සිට 0 දක්වා 3 {
    total = total + xs[i ලෙස u64];
  }
  තහවුරු total == 60;
  ලියන්න total;
  ආපසු 0;
}
