// vani-lang: danish
//
// build & run:
//   vanic run examples/language/danish/iterate.vani              # LLVM
//   vanic run examples/language/danish/iterate.vani --backend=c  # C

formaal "Danish vec iteration";

funktion sum_vec(v: ref Vec<i64>) -> i64 {
  lad sum: i64 = 0;
  for i fra 0 til len(v) {
    sum = sum + v[i];
  }
  returner sum;
}

funktion max_vec(v: ref Vec<i64>) -> i64 {
  lad m: i64 = v[0];
  for i fra 1 til len(v) {
    hvis v[i] > m {
      m = v[i];
    }
  }
  returner m;
}

fn main() -> i64 {
  lad v: Vec<i64> = vec(3, 1, 4, 1, 5, 9);
  bekraeft sum_vec(ref v) == 23;
  bekraeft max_vec(ref v) == 9;
  udskriv "sum =", sum_vec(ref v);
  udskriv "max =", max_vec(ref v);
  returner 0;
}
