// vani-lang: danish
//
// build & run:
//   vanic run examples/language/danish/async_cancel_auto.vani              # LLVM
//   vanic run examples/language/danish/async_cancel_auto.vani --backend=c  # C

formaal "Danish async/await smoke";

async funktion delay(ms: i64, v: i64) -> i64 {
  sleep_ms(ms);
  returner v;
}

fn main() -> i64 {
  lad a: i64 = await(delay(5, 42));
  lad b: i64 = await(delay(10, 7));

  bekraeft a == 42;
  bekraeft b == 7;
  udskriv "delays:", a, b;
  returner 0;
}
