// vani-lang: amharic
//
// build & run:
//   vanic run examples/language/amharic/verified.vani              # LLVM
//   vanic run examples/language/amharic/verified.vani --backend=c  # C

ዓላማ "Amharic requires/proves smoke-test";

ተግባር clamp(x: i64, lo: i64) -> i64
ይፈልጋል lo >= 0;
{
  ከ x < lo {
    መልስ lo;
  } ካልሆነ {
    መልስ x;
  }
}

ተግባር ደህና_ቀነስ(ሀ: i64, ለ: i64) -> i64
ይፈልጋል ሀ >= ለ;
ይፈልጋል ለ >= 0;
{
  አስረዳ ሀ - ለ >= 0;
  መልስ ሀ - ለ;
}

ተግባር main() -> i64 {
  ይሁን x: i64 = clamp(0 - 5, 0);
  አረጋግጥ x == 0;
  ይሁን d: i64 = ደህና_ቀነስ(10, 3);
  አረጋግጥ d == 7;
  ህትመት "Amharic verified OK", d;
  መልስ 0;
}
