// vani-lang: korean
//
// build & run:
//   vanic run examples/language/korean/verified.vani              # LLVM
//   vanic run examples/language/korean/verified.vani --backend=c  # C

목적 "Korean requires/proves smoke-test";

함수 하한값(x: i64, 하: i64) -> i64
필요 하 >= 0;
{
  만약 x < 하 {
    반환 하;
  } 아니면 {
    반환 x;
  }
}

함수 안전빼기(가: i64, 나: i64) -> i64
필요 가 >= 나;
필요 나 >= 0;
{
  증명 가 - 나 >= 0;
  반환 가 - 나;
}

함수 main() -> i64 {
  정의 x: i64 = 하한값(0 - 5, 0);
  확인 x == 0;
  정의 d: i64 = 안전빼기(10, 3);
  확인 d == 7;
  출력 "Korean verified OK", d;
  반환 0;
}
