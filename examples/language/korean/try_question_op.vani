// vani-lang: korean
//
// build & run:
//   vanic run examples/language/korean/try_question_op.vani              # LLVM
//   vanic run examples/language/korean/try_question_op.vani --backend=c  # C

목적 "Korean ? operator smoke-test";

함수 분석(n: i64) -> Option<i64> {
  만약 n < 0 {
    반환 Option.None;
  }
  반환 Option.Some(n * 3);
}

함수 계산(n: i64) -> Option<i64> {
  정의 v: i64 = 분석(n)?;
  반환 Option.Some(v + 1);
}

함수 풀기(o: Option<i64>, 기본값: i64) -> i64 {
  반환 일치 o {
    Option.Some(v) 그러면 v,
    Option.None 그러면 기본값,
  };
}

함수 main() -> i64 {
  정의 좋음: Option<i64> = 계산(4);
  정의 v1: i64 = 풀기(좋음, 0 - 999);
  확인 v1 == 13;
  정의 나쁨: Option<i64> = 계산(-1);
  정의 v2: i64 = 풀기(나쁨, 0 - 999);
  확인 v2 == 0 - 999;
  출력 "Korean ? op OK";
  반환 0;
}
