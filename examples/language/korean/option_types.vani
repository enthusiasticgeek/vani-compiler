// vani-lang: korean
//
// build & run:
//   vanic run examples/language/korean/option_types.vani              # LLVM
//   vanic run examples/language/korean/option_types.vani --backend=c  # C

목적 "Korean Option<T> smoke-test";

함수 안전나누기(a: i64, b: i64) -> Option<i64> {
  만약 b == 0 {
    반환 None;
  }
  반환 Some(a / b);
}

함수 main() -> i64 {
  정의 결과: Option<i64> = 안전나누기(10, 2);
  일치 결과 {
    Some(v) 그러면 {
      확인 v == 5;
      출력 "Korean option OK", v;
    }
    None 그러면 {
      확인 false;
    }
  }
  반환 0;
}
