// vani-lang: tibetan
//
// build & run:
//   vanic run examples/language/tibetan/iterate.vani              # LLVM
//   vanic run examples/language/tibetan/iterate.vani --backend=c  # C

དམིགས་ཡུལ "Tibetan Vec iteration smoke-test";

ལས་ཀ main() -> i64 {
  ཡོད་པར་ཤོག གཞི: Vec<i64> = vec();
  གཞི = push(གཞི, 10);
  གཞི = push(གཞི, 20);
  གཞི = push(གཞི, 30);
  ངེས གཞི[0] == 10;
  ངེས གཞི[1] == 20;
  ངེས གཞི[2] == 30;
  པར "Tibetan iterate OK";
  ལོག 0;
}
