// vani-lang: tibetan
//
// build & run:
//   vanic run examples/language/tibetan/for_loops.vani              # LLVM
//   vanic run examples/language/tibetan/for_loops.vani --backend=c  # C

དམིགས་ཡུལ "Tibetan for-loop smoke-test";

ལས་ཀ main() -> i64 {
  ཡོད་པར་ཤོག ཀུན: i64 = 0;
  ལ i ནས 1 བར་དུ 6 {
    ཀུན = ཀུན + i;
  }
  ངེས ཀུན == 15;
  པར "Tibetan for-loops OK", ཀུན;
  ལོག 0;
}
