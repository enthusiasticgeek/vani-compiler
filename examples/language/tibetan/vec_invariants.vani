// vani-lang: tibetan
//
// build & run:
//   vanic run examples/language/tibetan/vec_invariants.vani              # LLVM
//   vanic run examples/language/tibetan/vec_invariants.vani --backend=c  # C
//
// Note: Tibetan has no native invariant keyword; བསྒྲུབས (prove) used instead.

དམིགས་ཡུལ "Tibetan Vec invariants smoke-test";

ལས་ཀ main() -> i64 {
  ཡོད་པར་ཤོག གཞི: Vec<i64> = vec();
  གཞི = push(གཞི, 10);
  གཞི = push(གཞི, 20);
  གཞི = push(གཞི, 30);
  གཞི = push(གཞི, 40);
  གཞི = push(གཞི, 50);
  བསྒྲུབས 5 > 0;
  ཡོད་པར་ཤོག i: i64 = 0;
  བར i < 5 {
    ངེས གཞི[i] > 0;
    i = i + 1;
  }
  པར "Tibetan vec invariants OK";
  ལོག 0;
}
