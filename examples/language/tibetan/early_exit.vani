// vani-lang: tibetan
//
// build & run:
//   vanic run examples/language/tibetan/early_exit.vani              # LLVM
//   vanic run examples/language/tibetan/early_exit.vani --backend=c  # C

དམིགས་ཡུལ "Tibetan early-exit (break) smoke-test";

ལས་ཀ main() -> i64 {
  ཡོད་པར་ཤོག n: i64 = 0;
  བར n < 100 {
    གལ་ཏེ n == 5 {
      འགོག;
    }
    n = n + 1;
  }
  ངེས n == 5;
  པར "Tibetan early exit OK", n;
  ལོག 0;
}
