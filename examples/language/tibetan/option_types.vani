// vani-lang: tibetan
//
// build & run:
//   vanic run examples/language/tibetan/option_types.vani              # LLVM
//   vanic run examples/language/tibetan/option_types.vani --backend=c  # C

དམིགས་ཡུལ "Tibetan Option types smoke-test";

ལས་ཀ safe_div(a: i64, b: i64) -> Option<i64> {
  གལ་ཏེ b == 0 {
    ལོག None;
  } གཞན {
    ལོག Some(a / b);
  }
}

ལས་ཀ main() -> i64 {
  ཡོད་པར་ཤོག r1: Option<i64> = safe_div(10, 2);
  ཡོད་པར་ཤོག r2: Option<i64> = safe_div(5, 0);
  མཐུན r1 {
    Some(v) དེ་ནས ངེས v == 5;
    None དེ་ནས ངེས 1 == 0;
  }
  མཐུན r2 {
    Some(v) དེ་ནས ངེས 1 == 0;
    None དེ་ནས ངེས 1 == 1;
  }
  པར "Tibetan option types OK";
  ལོག 0;
}
