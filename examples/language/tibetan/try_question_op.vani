// vani-lang: tibetan
//
// build & run:
//   vanic run examples/language/tibetan/try_question_op.vani              # LLVM
//   vanic run examples/language/tibetan/try_question_op.vani --backend=c  # C

དམིགས་ཡུལ "Tibetan try-? operator smoke-test";

ལས་ཀ parse_pos(x: i64) -> Option<i64> {
  གལ་ཏེ x <= 0 {
    ལོག None;
  } གཞན {
    ལོག Some(x);
  }
}

ལས་ཀ double_pos(x: i64) -> Option<i64> {
  ཡོད་པར་ཤོག v: i64 = parse_pos(x)?;
  ལོག Some(v * 2);
}

ལས་ཀ main() -> i64 {
  ཡོད་པར་ཤོག r1: Option<i64> = double_pos(5);
  ཡོད་པར་ཤོག r2: Option<i64> = double_pos(-3);
  མཐུན r1 {
    Some(v) དེ་ནས ངེས v == 10;
    None དེ་ནས ངེས 1 == 0;
  }
  མཐུན r2 {
    Some(v) དེ་ནས ངེས 1 == 0;
    None དེ་ནས ངེས 1 == 1;
  }
  པར "Tibetan try-? OK";
  ལོག 0;
}
