// vani-lang: spanish
//
// build & run:
//   vanic run examples/language/spanish/control_flow.vani              # LLVM
//   vanic run examples/language/spanish/control_flow.vani --backend=c  # C

intención "if/else and while control flow";

función sign(x: i64) -> i64 {
  if x > 0 {
    return 1;
  } else {
    if x < 0 {
      return 0 - 1;
    } else {
      return 0;
    }
  }
}

función main() -> i64 {
  assert sign(5) == 1;
  assert sign(0 - 3) == 0 - 1;
  assert sign(0) == 0;

  let i: i64 = 0;
  while i < 5 {
    i = i + 1;
  }
  assert i == 5;

  print sign(42);
  return 0;
}
