// vani-lang: spanish
//
// build & run:
//   vanic run examples/language/spanish/option_types.vani              # LLVM
//   vanic run examples/language/spanish/option_types.vani --backend=c  # C

intención "Payloaded enums via Option<i64>";

// `enumeración` = enum (Spanish non-ASCII alias)

enumeración Opt { Some(i64), None }

función unwrap_or(o: Opt, def: i64) -> i64 {
  return match o {
    Opt.Some(v) then v,
    Opt.None    then def,
  };
}

función is_some(o: Opt) -> i64 {
  return match o {
    Opt.Some(v) then 1,
    Opt.None    then 0,
  };
}

función main() -> i64 {
  let a: Opt = Opt.Some(42);
  let b: Opt = Opt.None;

  let x: i64 = unwrap_or(a, 0);
  let y: i64 = unwrap_or(b, 100);

  assert x == 42;
  assert y == 100;
  assert is_some(a) == 1;
  assert is_some(b) == 0;

  print "Some(42) unwrapped =", x;
  print "None with default 100 =", y;
  return 0;
}
