// vani-lang: sindhi
مقصد "Sindhi iterate smoke-test";
فنکشن main() -> i64 {
  مانیں فهرست: Vec<i64> = vec(0);
  فهرست = push(فهرست, 10);
  فهرست = push(فهرست, 20);
  فهرست = push(فهرست, 30);
  یقینی فهرست[0] == 10;
  یقینی فهرست[1] == 20;
  یقینی فهرست[2] == 30;
  مانیں ڪل: i64 = 0;
  مانیں i: i64 = 0;
  تا i < (len(فهرست) بطور i64) {
    ڪل = ڪل + فهرست[i];
    i = i + 1;
  }
  یقینی ڪل == 60;
  لکھو "Sindhi iterate OK";
  واپس 0;
}
