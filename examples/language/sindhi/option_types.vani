// vani-lang: sindhi
مقصد "Sindhi Option types smoke-test";
شمار Opt { Some(i64), None }
فنکشن نکال(o: Opt, ک: i64) -> i64 {
  واپس ملان o {
    Opt.Some(v) تب v,
    Opt.None    تب ک,
  };
}
فنکشن کوئی_ہے(o: Opt) -> i64 {
  واپس ملان o {
    Opt.Some(v) تب 1,
    Opt.None    تب 0,
  };
}
فنکشن main() -> i64 {
  مانیں ک: Opt = Opt.Some(42);
  مانیں خ: Opt = Opt.None;
  مانیں x: i64 = نکال(ک, 0);
  مانیں y: i64 = نکال(خ, 100);
  یقینی x == 42;
  یقینی y == 100;
  یقینی کوئی_ہے(ک) == 1;
  یقینی کوئی_ہے(خ) == 0;
  لکھو "Sindhi option types OK";
  واپس 0;
}
