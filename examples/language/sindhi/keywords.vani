// vani-lang: sindhi
مقصد "Sindhi keywords smoke-test";
ساخت نقطو {
  x: i64,
  y: i64,
}
شمار رنگ { ڳاڙهو, سائو, نيرو }
فنکشن جمع(ک: i64, خ: i64) -> i64 {
  واپس ک + خ;
}
فنکشن main() -> i64 {
  مانیں ن: نقطو = نقطو { x: 3, y: 4 };
  یقینی ن.x == 3;
  یقینی جمع(2, 3) == 5;
  لکھو "Sindhi keywords OK";
  واپس 0;
}
