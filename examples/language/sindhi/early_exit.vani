// vani-lang: sindhi
مقصد "Sindhi early exit smoke-test";
فنکشن پهريون_صفر(فهرست: Vec<i64>) -> i64 {
  مانیں i: i64 = 0;
  تا i < (len(فهرست) بطور i64) {
    اگر فهرست[i] == 0 { واپس i; }
    i = i + 1;
  }
  واپس -1;
}
فنکشن main() -> i64 {
  مانیں و: Vec<i64> = vec();
  و = push(و, 3);
  و = push(و, 0);
  و = push(و, 7);
  یقینی پهريون_صفر(و) == 1;
  مانیں i: i64 = 0;
  تا i < 5 {
    اگر i == 3 { بند; }
    i = i + 1;
  }
  یقینی i == 3;
  لکھو "Sindhi early exit OK";
  واپس 0;
}
