// vani-lang: mandarin
//
// build & run:
//   vanic run examples/language/mandarin/option_types.vani              # LLVM
//   vanic run examples/language/mandarin/option_types.vani --backend=c  # C

目的 "Mandarin Option<T> smoke-test";

函数 安全除法(a: i64, b: i64) -> Option<i64> {
  如果 b == 0 {
    返回 Option.None;
  }
  返回 Option.Some(a / b);
}

函数 解开(o: Option<i64>, 默认值: i64) -> i64 {
  返回 匹配 o {
    Option.Some(v) 那么 v,
    Option.None 那么 默认值,
  };
}

函数 main() -> i64 {
  让 结果: Option<i64> = 安全除法(10, 2);
  让 v: i64 = 解开(结果, 0 - 999);
  断言 v == 5;
  打印 "Mandarin option OK", v;
  返回 0;
}
