// vani-lang: mandarin
//
// build & run:
//   vanic run examples/language/mandarin/global_showcase.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/mandarin/global_showcase.vani --backend=c              # C backend, gcc
//   vanic build examples/language/mandarin/global_showcase.vani -o /tmp/global_showcase_mandarin && /tmp/global_showcase_mandarin   # native binary

目的 "sum 1..10, checked correct, then printed";

函数 sum_to(n: i64) -> i64 {
  让 total: i64 = 0;
  对于 i 从 1 到 n + 1 {
    total = total + i;
  }
  返回 total;
}

函数 main() -> i64 {
  让 result: i64 = sum_to(10);
  断言 result == 55;
  打印 result;
  返回 0;
}
