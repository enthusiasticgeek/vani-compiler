// श्री।
// vani-lang: hindi
//
// build & run:
//   vanic run examples/language/english/basics.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/basics.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/basics.vani -o /tmp/basics && /tmp/basics   # native binary

उद्देश्य "Compute a small score with checked constraints";

फलन जोड़(क: i64, ख: i64) -> i64 {
  लौटाओ क + ख;
}

फलन सीमांक(आधार: i64) -> i64
चाहिए आधार >= 0;
{
  माना दोगुना: i64 = आधार * 2;
  सुनिश्चित दोगुना >= आधार;
  लौटाओ जोड़(दोगुना, 2);
}

फलन मुख्य() -> i64 {
  माना उत्तर = सीमांक(20);
  सिद्ध करो 2 + 2 == 4;
  सुनिश्चित उत्तर >= 0;
  लिखो उत्तर;
  लौटाओ 0;
}
