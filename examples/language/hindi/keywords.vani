// श्री।
// vani-lang: hindi
//
// build & run:
//   vanic run examples/language/hindi/keywords.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/hindi/keywords.vani --backend=c              # C backend, gcc
//   vanic build examples/language/hindi/keywords.vani -o /tmp/hindi_keywords && /tmp/hindi_keywords   # native binary

// हिन्दी (hindī) — Hindi-keyword example.
// Per-file language purity (closure #236) requires a single
// language per file. This file uses Hindi structure keywords
// throughout; English `print` is replaced with the Hindi
// alias `लिखो`.
//
// BUG-166 (2026-08-10): this file previously mixed in Marathi words
// (परत, मान, खात्री) under the strict `vani-lang: hindi` pragma,
// which the dialect-purity checker now correctly rejects. Every
// keyword below is Hindi-only or shared tatsama, verified directly
// against `spelling_supports_dialect` in src/lexer.rs.

फलन जोड़(क: i64, ख: i64) -> i64 {
  लौटाओ क + ख;
}

फलन दुगुना(ग: i64) -> i64 {
  लौटाओ ग * 2;
}

फलन मुख्य() -> i64 {
  माना क: i64 = 5;
  माना ख: i64 = 7;
  माना योग: i64 = जोड़(क, ख);
  माना घ: i64 = दुगुना(योग);

  सुनिश्चित योग == 12;
  सुनिश्चित घ == 24;

  लिखो "a=", क, " b=", ख, " sum=", योग, " doubled=", घ;
  लौटाओ 0;
}
