// श्री।
// vani-lang: hindi
//
// build & run:
//   vanic run examples/language/english/control_flow.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/control_flow.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/control_flow.vani -o /tmp/control_flow && /tmp/control_flow   # native binary

उद्देश्य "Demonstrate if/else and while loops with Vec mutation";

फलन योग(सूचिः: देखो Vec<i64>) -> i64 {
  माना जोड़: i64 = 0;
  माना क: u64 = 0;
  माना लंबाई: u64 = len(सूचिः);
  जबतक क < लंबाई {
    जोड़ = जोड़ + सूचिः[क];
    क = क + 1;
  }
  लौटाओ जोड़;
}

फलन परिसर_बनाओ(क: i64) -> Vec<i64> {
  माना सूचिः: Vec<i64> = vec(0);
  माना ख: i64 = 1;
  जबतक ख < क {
    सूचिः = push(सूचिः, ख);
    ख = ख + 1;
  }
  लौटाओ सूचिः;
}

फलन मुख्य() -> i64 {
  माना सूचिः: Vec<i64> = परिसर_बनाओ(5);
  माना जोड़: i64 = योग(देखो सूचिः);
  अगर जोड़ > 5 {
    सुनिश्चित जोड़ == 10;
  } वरना {
    सुनिश्चित जोड़ <= 5;
  }
  लिखो जोड़;
  लौटाओ 0;
}
