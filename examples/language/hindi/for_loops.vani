// श्री।
// vani-lang: hindi
//
// build & run:
//   vanic run examples/language/english/for_loops.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/for_loops.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/for_loops.vani -o /tmp/for_loops && /tmp/for_loops   # native binary

उद्देश्य "for-loops over integer ranges";

फलन वर्गयोग(क: i64) -> i64 {
  माना जोड़: i64 = 0;
  के लिए ख से 1 तक क {
    जोड़ = जोड़ + ख * ख;
  }
  लौटाओ जोड़;
}

फलन पहला_शून्य(सूचिः: देखो [i64; 5]) -> i64 {
  माना परिणाम: i64 = 0 - 1;
  के लिए क से 0 तक len(सूचिः) {
    अगर सूचिः[क] == 0 {
      परिणाम = क यथा i64;
      रुको;
    }
  }
  लौटाओ परिणाम;
}

फलन मुख्य() -> i64 {
  माना क: i64 = वर्गयोग(5);
  सुनिश्चित क == 30;

  माना सूचिः: [i64; 5] = [3, 7, 0, 9, 1];
  माना अनुक्रमांक: i64 = पहला_शून्य(देखो सूचिः);
  सुनिश्चित अनुक्रमांक == 2;

  लिखो क;
  लिखो अनुक्रमांक;
  लौटाओ 0;
}
