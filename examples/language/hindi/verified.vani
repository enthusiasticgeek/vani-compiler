// श्री।
// vani-lang: hindi
//
// build & run:
//   vanic run examples/language/english/verified.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/verified.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/verified.vani -o /tmp/verified && /tmp/verified   # native binary

उद्देश्य "Use the SMT verifier to discharge preconditions";

फलन निम्नसीमा(क: i64, न्यूनतम: i64) -> i64
चाहिए न्यूनतम >= 0;
{
  अगर क < न्यूनतम {
    लौटाओ न्यूनतम;
  } वरना {
    लौटाओ क;
  }
}

फलन सुरक्षित_घटाव(क: i64, ख: i64) -> i64
चाहिए क >= ख;
चाहिए ख >= 0;
{
  सिद्ध करो क - ख >= 0;
  लौटाओ क - ख;
}

फलन मुख्य() -> i64 {
  माना ग: i64 = निम्नसीमा(0 - 5, 0);
  सुनिश्चित ग == 0;

  माना अंतर: i64 = सुरक्षित_घटाव(10, 3);
  सुनिश्चित अंतर == 7;

  लिखो अंतर;
  लौटाओ 0;
}
