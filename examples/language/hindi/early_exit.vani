// श्री।
// vani-lang: hindi
//
// build & run:
//   vanic run examples/language/english/early_exit.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/early_exit.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/early_exit.vani -o /tmp/early_exit && /tmp/early_exit   # native binary

उद्देश्य "break and continue for early exit and skip";

फलन पहला_ऋणात्मक(सूचिः: देखो Vec<i64>) -> i64 {
  माना क: u64 = 0;
  माना परिणाम: i64 = 0 - 1;
  जबतक क < len(सूचिः) {
    अगर सूचिः[क] < 0 {
      परिणाम = सूचिः[क];
      रुको;
    }
    क = क + 1;
  }
  लौटाओ परिणाम;
}

फलन धनात्मक_गणना(सूचिः: देखो Vec<i64>) -> i64 {
  माना क: u64 = 0;
  माना गणना: i64 = 0;
  जबतक क < len(सूचिः) {
    अगर सूचिः[क] <= 0 {
      क = क + 1;
      आगे;
    }
    गणना = गणना + 1;
    क = क + 1;
  }
  लौटाओ गणना;
}

फलन मुख्य() -> i64 {
  माना सूचिः: Vec<i64> = vec(1, 2, 0 - 3, 4, 0 - 5);
  माना पहला_ऋण: i64 = पहला_ऋणात्मक(देखो सूचिः);
  माना धनात्मक: i64 = धनात्मक_गणना(देखो सूचिः);
  सुनिश्चित पहला_ऋण == 0 - 3;
  सुनिश्चित धनात्मक == 3;
  लिखो पहला_ऋण;
  लिखो धनात्मक;
  लौटाओ 0;
}
