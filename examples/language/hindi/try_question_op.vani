// श्री।
// vani-lang: hindi
//
// build & run:
//   vanic run examples/language/hindi/try_question_op.vani                  # LLVM
//   vanic run examples/language/hindi/try_question_op.vani --backend=c      # C

उद्देश्य "Arc 8 v3.1 sugar — Hindi counterpart of postfix `?`";

गणन वैकल्पिक { किञ्चित्(i64), रिक्तम् }

फलन दुगुना(व: वैकल्पिक) -> वैकल्पिक {
  माना मूल्य: i64 = व?;
  लौटाओ वैकल्पिक.किञ्चित्(मूल्य * 2);
}

फलन मूल्य_या(व: वैकल्पिक, मूलभूत: i64) -> i64 {
  लौटाओ मिलान व {
    वैकल्पिक.किञ्चित्(मूल्य) तो मूल्य,
    वैकल्पिक.रिक्तम् तो मूलभूत,
  };
}

फलन मुख्य() -> i64 {
  माना क: वैकल्पिक = दुगुना(वैकल्पिक.किञ्चित्(5));
  सुनिश्चित मूल्य_या(क, 0) == 10;

  माना ख: वैकल्पिक = दुगुना(वैकल्पिक.रिक्तम्);
  सुनिश्चित मूल्य_या(ख, 99) == 99;

  लिखो "Some(5)? doubled =", मूल्य_या(क, 0);
  लिखो "None? defaulted to", मूल्य_या(ख, 99);
  लौटाओ 0;
}
