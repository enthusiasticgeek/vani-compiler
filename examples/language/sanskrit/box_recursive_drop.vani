// श्री।
// vani-lang: sanskrit
//
// build & run:
//   vanic run examples/language/sanskrit/box_recursive_drop.vani                # LLVM
//   vanic run examples/language/sanskrit/box_recursive_drop.vani --backend=c    # C

उद्देश्य "L2 follow-up — Box<Vec<T>> + Box<OwnedStr> recursive drop";

// Sanskrit counterpart of examples/language/english/box_recursive_drop.vani.
// Demonstrates that the L2 follow-up (Box accepting Vec<T> and
// OwnedStr inner types, with scope-exit Drop chained into the
// inner destructor) works under the Devanagari pragma. The
// new surface compiles identically — the dialect only changes
// the keywords, not the AST.

संरचना थैली {
  सामग्री: Box<Vec<i64>>,
}

कार्य मुख्य() -> i64 {
  माना सूचिः: Vec<i64> = vec(10, 20, 30);
  माना मञ्जूषा: Box<Vec<i64>> = box(सूचिः);
  लिख "constructed Box<Vec<i64>>";

  माना सूचिः२: Vec<i64> = vec(7, 8, 9);
  माना थैलिका: थैली = थैली { सामग्री: box(सूचिः२) };
  लिख "constructed Bag";

  माना पदम्: OwnedStr = "hi" + "!";
  माना शब्दमञ्जूषा: Box<OwnedStr> = box(पदम्);
  लिख "constructed Box<OwnedStr>";

  पुनरागम 0;
}
