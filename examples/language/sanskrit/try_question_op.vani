// श्री।
// vani-lang: sanskrit
//
// build & run:
//   vanic run examples/language/sanskrit/try_question_op.vani                  # LLVM
//   vanic run examples/language/sanskrit/try_question_op.vani --backend=c      # C

उद्देश्य "Arc 8 v3.1 sugar — Sanskrit counterpart of postfix `?`";

// The postfix `?` operator works identically across all
// dialects — it's a parse-time sugar that builds the same
// `ExprKind::Try` AST node as the `try` (प्रयास) keyword form.
// Sanskrit text:
//   माना v: i64 = प्रयास o;      // keyword form
//   माना v: i64 = o?;            // postfix sugar
// Both desugar identically through the existing try-let
// machinery (T2.6 phase 2).

विकल्प ऐच्छिकः { किञ्चित्(i64), रिक्तम् }

कार्य द्विगुणय(वि: ऐच्छिकः) -> ऐच्छिकः {
  माना ग: i64 = वि?;
  पुनरागम ऐच्छिकः.किञ्चित्(ग * 2);
}

कार्य उद्धरणम्(वि: ऐच्छिकः, निर्धारितम्: i64) -> i64 {
  पुनरागम मेल वि {
    ऐच्छिकः.किञ्चित्(ग) तदा ग,
    ऐच्छिकः.रिक्तम् तदा निर्धारितम्,
  };
}

कार्य मुख्य() -> i64 {
  माना क: ऐच्छिकः = द्विगुणय(ऐच्छिकः.किञ्चित्(5));
  सिद्धम् उद्धरणम्(क, 0) == 10;

  माना ख: ऐच्छिकः = द्विगुणय(ऐच्छिकः.रिक्तम्);
  सिद्धम् उद्धरणम्(ख, 99) == 99;

  लिख "Some(5)? doubled =", उद्धरणम्(क, 0);
  लिख "None? defaulted to", उद्धरणम्(ख, 99);
  पुनरागम 0;
}
