// श्री।
// vani-lang: sanskrit
//
// build & run:
//   vanic run examples/language/english/verified.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/verified.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/verified.vani -o /tmp/verified && /tmp/verified   # native binary

उद्देश्य "Use the SMT verifier to discharge preconditions";

कार्य न्यूनसीमा(क: i64, न्यूनम्: i64) -> i64
अपेक्षित न्यूनम् >= 0;
{
  यदि क < न्यूनम् {
    पुनरागम न्यूनम्;
  } अन्यथा {
    पुनरागम क;
  }
}

कार्य सुरक्षितव्यवकलनम्(क: i64, ख: i64) -> i64
अपेक्षित क >= ख;
अपेक्षित ख >= 0;
{
  प्रमाण क - ख >= 0;
  पुनरागम क - ख;
}

कार्य मुख्य() -> i64 {
  माना क: i64 = न्यूनसीमा(0 - 5, 0);
  सिद्धम् क == 0;

  माना अन्तरम्: i64 = सुरक्षितव्यवकलनम्(10, 3);
  सिद्धम् अन्तरम् == 7;

  लिख अन्तरम्;
  पुनरागम 0;
}
