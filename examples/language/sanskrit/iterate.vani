// श्री।
// vani-lang: sanskrit
//
// build & run:
//   vanic run examples/language/english/iterate.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/iterate.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/iterate.vani -o /tmp/iterate && /tmp/iterate   # native binary

उद्देश्य "Iterate over arrays and Vecs with `for x in ref xs` and consuming `for x in xs`";

कार्य सूचीयोगः(सूचिः: दृष्ट्या Vec<i64>) -> i64 {
  माना योगः: i64 = 0;
  प्रति क में दृष्ट्या सूचिः {
    योगः = योगः + क;
  }
  पुनरागम योगः;
}

कार्य अधिकतमम्(सूचिः: दृष्ट्या [i64; 5]) -> i64 {
  माना अधिकतम्: i64 = सूचिः[0];
  प्रति क में दृष्ट्या सूचिः {
    यदि क > अधिकतम् {
      अधिकतम् = क;
    }
  }
  पुनरागम अधिकतम्;
}

कार्य धनगणना(सूचिः: दृष्ट्या Vec<i64>) -> i64 {
  माना गणना: i64 = 0;
  प्रति क में दृष्ट्या सूचिः {
    यदि क > 0 {
      गणना = गणना + 1;
    }
  }
  पुनरागम गणना;
}

कार्य मुख्य() -> i64 {
  माना सूचिः: Vec<i64> = vec(1, 2, 3, 4, 5);
  माना योगः: i64 = सूचीयोगः(दृष्ट्या सूचिः);
  सिद्धम् योगः == 15;

  माना सारणी: [i64; 5] = [3, 7, 1, 9, 4];
  माना उच्चतमम्: i64 = अधिकतमम्(दृष्ट्या सारणी);
  सिद्धम् उच्चतमम् == 9;

  माना सूचिः२: Vec<i64> = vec(0 - 2, 5, 0 - 1, 3, 0, 4);
  माना धनसंख्या: i64 = धनगणना(दृष्ट्या सूचिः२);
  सिद्धम् धनसंख्या == 3;

  // Consuming `for x in xs` over a Vec<OwnedStr>: each
  // element is moved into x and freed at scope exit. The
  // outer buffer is freed by the loop's post-exit code.
  // Closure #159 — previously double-freed the per-element
  // heap because `intent_vec_<owned_str>__free` would walk
  // every slot after closure #127's deep-drop change.
  माना सूचिः३: Vec<OwnedStr> = vec("a" + "", "bb" + "", "ccc" + "");
  माना कुलयोगः: i64 = 0;
  प्रति क में सूचिः३ {
    कुलयोगः = कुलयोगः + (len(क) यथा i64);
  }
  सिद्धम् कुलयोगः == 6;

  लिख योगः;
  लिख उच्चतमम्;
  लिख धनसंख्या;
  लिख कुलयोगः;
  पुनरागम 0;
}
