// श्री।
// vani-lang: sanskrit
//
// build & run:
//   vanic run examples/language/english/early_exit.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/early_exit.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/early_exit.vani -o /tmp/early_exit && /tmp/early_exit   # native binary

उद्देश्य "break and continue for early exit and skip";

कार्य प्रथमऋणात्मकम्(सूचिः: दृष्ट्या Vec<i64>) -> i64 {
  माना क: u64 = 0;
  माना फलम्: i64 = 0 - 1;
  यावत् क < len(सूचिः) {
    यदि सूचिः[क] < 0 {
      फलम् = सूचिः[क];
      विराम;
    }
    क = क + 1;
  }
  पुनरागम फलम्;
}

कार्य धनात्मकसंख्या(सूचिः: दृष्ट्या Vec<i64>) -> i64 {
  माना क: u64 = 0;
  माना गणना: i64 = 0;
  यावत् क < len(सूचिः) {
    यदि सूचिः[क] <= 0 {
      क = क + 1;
      अग्रे;
    }
    गणना = गणना + 1;
    क = क + 1;
  }
  पुनरागम गणना;
}

कार्य मुख्य() -> i64 {
  माना सूचिः: Vec<i64> = vec(1, 2, 0 - 3, 4, 0 - 5);
  माना क: i64 = प्रथमऋणात्मकम्(दृष्ट्या सूचिः);
  माना ख: i64 = धनात्मकसंख्या(दृष्ट्या सूचिः);
  सिद्धम् क == 0 - 3;
  सिद्धम् ख == 3;
  लिख क;
  लिख ख;
  पुनरागम 0;
}
