// श्री।
// vani-lang: sanskrit
//
// build & run:
//   vanic run examples/language/english/control_flow.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/control_flow.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/control_flow.vani -o /tmp/control_flow && /tmp/control_flow   # native binary

उद्देश्य "Demonstrate if/else and while loops with Vec mutation";

कार्य योगः(सूचिः: दृष्ट्या Vec<i64>) -> i64 {
  माना संकलनम्: i64 = 0;
  माना क: u64 = 0;
  माना संख्या: u64 = len(सूचिः);
  यावत् क < संख्या {
    संकलनम् = संकलनम् + सूचिः[क];
    क = क + 1;
  }
  पुनरागम संकलनम्;
}

कार्य परिसरः(संख्या: i64) -> Vec<i64> {
  माना सूचिः: Vec<i64> = vec(0);
  माना क: i64 = 1;
  यावत् क < संख्या {
    सूचिः = push(सूचिः, क);
    क = क + 1;
  }
  पुनरागम सूचिः;
}

कार्य मुख्य() -> i64 {
  माना सूचिः: Vec<i64> = परिसरः(5);
  माना संकलनम्: i64 = योगः(दृष्ट्या सूचिः);
  यदि संकलनम् > 5 {
    सिद्धम् संकलनम् == 10;
  } अन्यथा {
    सिद्धम् संकलनम् <= 5;
  }
  लिख संकलनम्;
  पुनरागम 0;
}
