// श्री।
// vani-lang: sanskrit
//
// build & run:
//   vanic run examples/language/english/for_loops.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/for_loops.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/for_loops.vani -o /tmp/for_loops && /tmp/for_loops   # native binary

उद्देश्य "for-loops over integer ranges";

कार्य sum_squares(n: i64) -> i64 {
  माना total: i64 = 0;
  प्रति i से 1 तक n {
    total = total + i * i;
  }
  पुनरागम total;
}

कार्य find_first_zero(xs: दृष्ट्या [i64; 5]) -> i64 {
  माना result: i64 = 0 - 1;
  प्रति i से 0 तक len(xs) {
    यदि xs[i] == 0 {
      result = i यथा i64;
      विराम;
    }
  }
  पुनरागम result;
}

कार्य main() -> i64 {
  माना s: i64 = sum_squares(5);
  सिद्धम् s == 30;

  माना xs: [i64; 5] = [3, 7, 0, 9, 1];
  माना idx: i64 = find_first_zero(दृष्ट्या xs);
  सिद्धम् idx == 2;

  लिख s;
  लिख idx;
  पुनरागम 0;
}
