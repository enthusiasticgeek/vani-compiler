// श्री।
// vani-lang: sanskrit
//
// build & run:
//   vanic run examples/language/english/for_loops.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/for_loops.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/for_loops.vani -o /tmp/for_loops && /tmp/for_loops   # native binary

उद्देश्य "for-loops over integer ranges";

कार्य वर्गयोगः(संख्या: i64) -> i64 {
  माना योगः: i64 = 0;
  प्रति क से 1 तक संख्या {
    योगः = योगः + क * क;
  }
  पुनरागम योगः;
}

कार्य प्रथमशून्यम्(सूचिः: दृष्ट्या [i64; 5]) -> i64 {
  माना फलम्: i64 = 0 - 1;
  प्रति क से 0 तक len(सूचिः) {
    यदि सूचिः[क] == 0 {
      फलम् = क यथा i64;
      विराम;
    }
  }
  पुनरागम फलम्;
}

कार्य मुख्य() -> i64 {
  माना क: i64 = वर्गयोगः(5);
  सिद्धम् क == 30;

  माना सूचिः: [i64; 5] = [3, 7, 0, 9, 1];
  माना ख: i64 = प्रथमशून्यम्(दृष्ट्या सूचिः);
  सिद्धम् ख == 2;

  लिख क;
  लिख ख;
  पुनरागम 0;
}
