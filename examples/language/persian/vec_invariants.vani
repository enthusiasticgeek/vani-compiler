// vani-lang: persian
هدف "Persian Vec invariants smoke-test";
تابع main() -> i64 {
  فرض فهرست: Vec<i64> = vec();
  فهرست = push(فهرست, 10);
  فهرست = push(فهرست, 20);
  فهرست = push(فهرست, 30);
  فهرست = push(فهرست, 40);
  فهرست = push(فهرست, 50);
  ادعا (len(فهرست) بعنوان i64) == 5;
  فرض i: i64 = 0;
  تا i < 5
  تغییرناپذیر i >= 0;
  تغییرناپذیر i <= 5;
  {
    ادعا فهرست[i] > 0;
    i = i + 1;
  }
  چاپ "Persian vec invariants OK";
  بازگشت 0;
}
