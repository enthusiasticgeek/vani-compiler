// vani-lang: persian
هدف "Persian iterate smoke-test";
تابع main() -> i64 {
  فرض فهرست: Vec<i64> = vec();
  فهرست = push(فهرست, 10);
  فهرست = push(فهرست, 20);
  فهرست = push(فهرست, 30);
  ادعا فهرست[0] == 10;
  ادعا فهرست[1] == 20;
  ادعا فهرست[2] == 30;
  فرض kol: i64 = 0;
  فرض i: i64 = 0;
  تا i < (len(فهرست) بعنوان i64) {
    kol = kol + فهرست[i];
    i = i + 1;
  }
  ادعا kol == 60;
  چاپ "Persian iterate OK";
  بازگشت 0;
}
