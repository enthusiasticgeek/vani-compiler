// vani-lang: persian
هدف "Persian control flow smoke-test";
تابع طبقه_بندی(x: i64) -> i64 {
  اگر x > 0 { بازگشت 1; } وگرنه اگر x < 0 { بازگشت -1; } وگرنه { بازگشت 0; }
}
تابع main() -> i64 {
  ادعا طبقه_بندی(5) == 1;
  ادعا طبقه_بندی(-3) == -1;
  ادعا طبقه_بندی(0) == 0;
  چاپ "Persian control flow OK";
  بازگشت 0;
}
