// vani-lang: persian
//
// Phase 12.4 (2026-06-07): Persian / Farsi (فارسی) — Iranian
// language, ~110M speakers across Iran, Afghanistan (Dari),
// Tajikistan (Tajik). Same Perso-Arabic script family as Urdu
// but with its OWN numeral block: Persian Arabic-Indic digits
// ۰..۹ at U+06F0..06F9 (UTF-8 `DB B0+d`) — distinct from
// Urdu's Eastern Arabic-Indic.
//
// Persian's keyword vocabulary draws on classical Persian
// roots — distinct from the Hindustani vocabulary Urdu shares
// with Hindi.
//
// build & run:
//   vanic run examples/language/persian/basics.vani
//   vanic run examples/language/persian/basics.vani --backend=c

هدف "Persian-pragma intro — sum two numbers";

تابع add(a: i64, b: i64) -> i64
نیاز a >= 0;
نیاز b >= 0;
{
  بازگشت a + b;
}

تابع main() -> i64 {
  فرض x: i64 = 5;
  فرض y: i64 = 7;
  فرض sum: i64 = add(x, y);
  ادعا sum == 12;
  چاپ sum;
  بازگشت 0;
}
