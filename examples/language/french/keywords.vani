// vani-lang: french
//
// build & run:
//   vanic run examples/language/french/keywords.vani              # LLVM
//   vanic run examples/language/french/keywords.vani --backend=c  # C
//
// v1: non-ASCII French aliases (vérifie, démontre, écris, énumération,
// tâche, parallèle) are active; pure-ASCII control-flow uses English.

intent "French keyword showcase";

fn add(a: i64, b: i64) -> i64 {
  return a + b;
}

fn max(a: i64, b: i64) -> i64 {
  if a > b {
    return a;
  } else {
    return b;
  }
}

fn main() -> i64 {
  let x: i64 = add(3, 4);
  vérifie x == 7;
  let y: i64 = max(10, 20);
  vérifie y == 20;
  écris x;
  écris y;
  return 0;
}
