// vani-lang: french
//
// build & run:
//   vanic run examples/language/french/verified.vani              # LLVM
//   vanic run examples/language/french/verified.vani --backend=c  # C

intent "SMT-verified clamp_low";

fn clamp_low(x: i64, lo: i64) -> i64
requires lo >= 0;
{
  if x < lo {
    return lo;
  } else {
    return x;
  }
}

fn main() -> i64 {
  vérifie clamp_low(0 - 5, 0) == 0;
  vérifie clamp_low(10, 3) == 10;
  écris clamp_low(0 - 5, 0);
  écris clamp_low(10, 3);
  return 0;
}
