// vani-lang: french
//
// build & run:
//   vanic run examples/language/french/control_flow.vani              # LLVM
//   vanic run examples/language/french/control_flow.vani --backend=c  # C

intent "if/else and while control flow";

fn sign(x: i64) -> i64 {
  if x > 0 {
    return 1;
  } else {
    if x < 0 {
      return 0 - 1;
    } else {
      return 0;
    }
  }
}

fn main() -> i64 {
  vérifie sign(5) == 1;
  vérifie sign(0 - 3) == 0 - 1;
  vérifie sign(0) == 0;

  let i: i64 = 0;
  while i < 5 {
    i = i + 1;
  }
  vérifie i == 5;

  écris sign(42);
  return 0;
}
