// vani-lang: french
//
// build & run:
//   vanic run examples/language/french/option_types.vani              # LLVM
//   vanic run examples/language/french/option_types.vani --backend=c  # C

intent "Payloaded enums via Option<i64>";

// `énumération` = enum (French non-ASCII alias)

énumération Opt { Some(i64), None }

fn unwrap_or(o: Opt, def: i64) -> i64 {
  return match o {
    Opt.Some(v) then v,
    Opt.None    then def,
  };
}

fn is_some(o: Opt) -> i64 {
  return match o {
    Opt.Some(v) then 1,
    Opt.None    then 0,
  };
}

fn main() -> i64 {
  let a: Opt = Opt.Some(42);
  let b: Opt = Opt.None;

  let x: i64 = unwrap_or(a, 0);
  let y: i64 = unwrap_or(b, 100);

  vérifie x == 42;
  vérifie y == 100;
  vérifie is_some(a) == 1;
  vérifie is_some(b) == 0;

  écris "Some(42) unwrapped =", x;
  écris "None with default 100 =", y;
  return 0;
}
