// vani-lang: french
//
// build & run:
//   vanic run examples/language/french/async_cancel_auto.vani              # LLVM
//   vanic run examples/language/french/async_cancel_auto.vani --backend=c  # C

intent "French async/await smoke";

async fn delay(ms: i64, v: i64) -> i64 {
  sleep_ms(ms);
  return v;
}

fn main() -> i64 {
  let a: i64 = await(delay(5, 42));
  let b: i64 = await(delay(10, 7));

  vérifie a == 42;
  vérifie b == 7;
  écris "delays:", a, b;
  return 0;
}
