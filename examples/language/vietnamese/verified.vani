// vani-lang: vietnamese
//
// build & run:
//   vanic run examples/language/vietnamese/verified.vani              # LLVM
//   vanic run examples/language/vietnamese/verified.vani --backend=c  # C

mục_đích "SMT-verified clamp_low";

hàm clamp_low(x: i64, ngưỡng: i64) -> i64
yêu_cầu ngưỡng >= 0;
{
  nếu x < ngưỡng {
    trả_về ngưỡng;
  } ngược_lại {
    trả_về x;
  }
}

hàm main() -> i64 {
  khẳng_định clamp_low(0 - 5, 0) == 0;
  khẳng_định clamp_low(10, 3) == 10;
  in_ra clamp_low(0 - 5, 0);
  in_ra clamp_low(10, 3);
  trả_về 0;
}
