// vani-lang: mongolian
//
// build & run:
//   vanic run examples/language/mongolian/async_cancel_auto.vani              # LLVM
//   vanic run examples/language/mongolian/async_cancel_auto.vani --backend=c  # C

ᠵᠣᠷᠢᠯᠭ᠎ᠠ "Mongolian async/await smoke";

async ᠴᠠᠭ delay(ms: i64, v: i64) -> i64 {
  sleep_ms(ms);
  ᠪᠤᠴᠠ v;
}

ᠴᠠᠭ main() -> i64 {
  ᠶᠠᠪᠤᠭᠤᠯ a: i64 = await(delay(5, 42));
  ᠶᠠᠪᠤᠭᠤᠯ b: i64 = await(delay(10, 7));

  ᠪᠠᠲᠤᠯ a == 42;
  ᠪᠠᠲᠤᠯ b == 7;
  ᠬᠡᠪᠯᠡ "delays:", a, b;
  ᠪᠤᠴᠠ 0;
}
