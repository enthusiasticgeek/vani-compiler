// vani-lang: mongolian
//
// build & run:
//   vanic run examples/language/mongolian/option_types.vani              # LLVM
//   vanic run examples/language/mongolian/option_types.vani --backend=c  # C
//
// Note: Mongolian has no native match keyword; Option<T> tested via ? chaining.

ᠵᠣᠷᠢᠯᠭ᠎ᠠ "Mongolian Option types smoke-test";

ᠴᠠᠭ safe_div(a: i64, b: i64) -> Option<i64> {
  ᠬᠡᠷᠪᠡ b == 0 {
    ᠪᠤᠴᠠ None;
  } ᠡᠰᠡᠪᠡᠯ {
    ᠪᠤᠴᠠ Some(a / b);
  }
}

ᠴᠠᠭ chain(a: i64, b: i64) -> Option<i64> {
  ᠶᠠᠪᠤᠭᠤᠯ v: i64 = safe_div(a, b)?;
  ᠪᠤᠴᠠ Some(v * 2);
}

ᠴᠠᠭ main() -> i64 {
  ᠶᠠᠪᠤᠭᠤᠯ r1: Option<i64> = chain(10, 2);
  ᠶᠠᠪᠤᠭᠤᠯ r2: Option<i64> = chain(5, 0);
  ᠬᠡᠪᠯᠡ "Mongolian option types OK";
  ᠪᠤᠴᠠ 0;
}
