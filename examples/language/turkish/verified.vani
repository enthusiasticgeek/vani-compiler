// vani-lang: turkish
//
// build & run:
//   vanic run examples/language/turkish/verified.vani              # LLVM
//   vanic run examples/language/turkish/verified.vani --backend=c  # C

amaç "SMT-verified clamp_low";

işlev clamp_low(x: i64, esik: i64) -> i64
gerek esik >= 0;
{
  eğer x < esik {
    dön esik;
  } yoksa {
    dön x;
  }
}

fn main() -> i64 {
  doğrula clamp_low(0 - 5, 0) == 0;
  doğrula clamp_low(10, 3) == 10;
  yazdır clamp_low(0 - 5, 0);
  yazdır clamp_low(10, 3);
  dön 0;
}
