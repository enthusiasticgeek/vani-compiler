// vani-lang: maithili
//
// build & run:
//   vanic run examples/language/maithili/keywords.vani              # LLVM
//   vanic run examples/language/maithili/keywords.vani --backend=c  # C

उद्देश्य "Maithili keyword smoke-test";

संरचना बिन्दु {
  क: i64,
  ख: i64,
}

गणन रंग { लाल, हरा, नीला }

कार्य जोड़(क: i64, ख: i64) -> i64 {
  लौटाओ क + ख;
}

कार्य main() -> i64 {
  माना प: बिन्दु = बिन्दु { क: 3, ख: 4 };
  माना र: रंग = रंग.लाल;
  माना स: i64 = जोड़(प.क, प.ख);
  सुनिश्चित स == 7;
  लिखो "Maithili keywords OK", स;
  लौटाओ 0;
}
