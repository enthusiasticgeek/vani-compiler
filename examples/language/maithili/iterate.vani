// vani-lang: maithili
उद्देश्य "Maithili Vec iteration smoke-test";
कार्य main() -> i64 {
  माना सूची: Vec<i64> = vec(0);
  सूची = push(सूची, 10);
  सूची = push(सूची, 20);
  सूची = push(सूची, 30);
  सिद्ध सूची[0] == 10;
  सिद्ध सूची[1] == 20;
  सिद्ध सूची[2] == 30;
  लिखो "Maithili iterate OK";
  लौटाओ 0;
}
