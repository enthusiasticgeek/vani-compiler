// vani-lang: portuguese
//
// build & run:
//   vanic run examples/language/portuguese/control_flow.vani              # LLVM
//   vanic run examples/language/portuguese/control_flow.vani --backend=c  # C

intenção "if/else and while control flow";

função sign(x: i64) -> i64 {
  se x > 0 {
    retornar 1;
  } senão {
    se x < 0 {
      retornar 0 - 1;
    } senão {
      retornar 0;
    }
  }
}

função main() -> i64 {
  afirmar sign(5) == 1;
  afirmar sign(0 - 3) == 0 - 1;
  afirmar sign(0) == 0;

  seja i: i64 = 0;
  enquanto i < 5 {
    i = i + 1;
  }
  afirmar i == 5;

  imprimir sign(42);
  retornar 0;
}
