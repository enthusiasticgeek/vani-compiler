// vani-lang: yoruba
//
// build & run:
//   vanic run examples/language/yoruba/verified.vani              # LLVM
//   vanic run examples/language/yoruba/verified.vani --backend=c  # C

ìpinnu "SMT-verified clamp_low";

iṣẹ́ clamp_low(x: i64, ìpele: i64) -> i64
nílò ìpele >= 0;
{
  bí x < ìpele {
    padà ìpele;
  } else {
    padà x;
  }
}

iṣẹ́ main() -> i64 {
  jẹ́risí clamp_low(0 - 5, 0) == 0;
  jẹ́risí clamp_low(10, 3) == 10;
  tẹ̀ clamp_low(0 - 5, 0);
  tẹ̀ clamp_low(10, 3);
  padà 0;
}
