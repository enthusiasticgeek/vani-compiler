// vani-lang: hausa
//
// build & run:
//   vanic run examples/language/hausa/async_cancel_auto.vani              # LLVM
//   vanic run examples/language/hausa/async_cancel_auto.vani --backend=c  # C

nufin "Hausa async/await smoke";

async aiki delay(ms: i64, v: i64) -> i64 {
  sleep_ms(ms);
  koma v;
}

aiki main() -> i64 {
  bari a: i64 = await(delay(5, 42));
  bari b: i64 = await(delay(10, 7));

  tabbatar a == 42;
  tabbatar b == 7;
  rubuta "delays:", a, b;
  koma 0;
}
