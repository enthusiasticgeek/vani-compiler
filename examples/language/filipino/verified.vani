// vani-lang: filipino
//
// build & run:
//   vanic run examples/language/filipino/verified.vani              # LLVM
//   vanic run examples/language/filipino/verified.vani --backend=c  # C

layunin "SMT-verified clamp_low";

gawain clamp_low(x: i64, hangganan: i64) -> i64
kailangan hangganan >= 0;
{
  kung x < hangganan {
    ibalik hangganan;
  } kundi {
    ibalik x;
  }
}

gawain main() -> i64 {
  patunayan clamp_low(0 - 5, 0) == 0;
  patunayan clamp_low(10, 3) == 10;
  isulat clamp_low(0 - 5, 0);
  isulat clamp_low(10, 3);
  ibalik 0;
}
