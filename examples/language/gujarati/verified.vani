// ॐ
// vani-lang: gujarati
//
// build & run:
//   vanic run examples/language/gujarati/verified.vani              # LLVM
//   vanic run examples/language/gujarati/verified.vani --backend=c  # C

ઉદ્દેશ "SMT verifier — preconditions and proofs";

// `જરૂરી` = requires, `પ્રમાણ` = prove

કાર્ય clamp_low(x: i64, lo: i64) -> i64
જરૂરી lo >= 0;
{
  જો x < lo {
    પાછા lo;
  } નહીંતર {
    પાછા x;
  }
}

કાર્ય safe_subtract(a: i64, b: i64) -> i64
જરૂરી a >= b;
જરૂરી b >= 0;
{
  પ્રમાણ a - b >= 0;
  પાછા a - b;
}

કાર્ય main() -> i64 {
  માનો x: i64 = clamp_low(0 - 5, 0);
  નિશ્ચિત x == 0;

  માનો d: i64 = safe_subtract(10, 3);
  નિશ્ચિત d == 7;

  લખો d;
  પાછા 0;
}
