// vani-lang: malay
//
// build & run:
//   vanic run examples/language/malay/box_recursive_drop.vani              # LLVM
//   vanic run examples/language/malay/box_recursive_drop.vani --backend=c  # C

tujuan "Malay Box<Vec<T>> and Box<OwnedStr> recursive drop";

struktur Beg {
  kandungan: Box<Vec<i64>>,
}

fungsi main() -> i64 {
  biarkan v: Vec<i64> = vec(10, 20, 30);
  biarkan b: Box<Vec<i64>> = box(v);
  cetak "Box<Vec<i64>> dicipta";

  biarkan v2: Vec<i64> = vec(7, 8, 9);
  biarkan beg: Beg = Beg { kandungan: box(v2) };
  cetak "Beg dicipta";

  biarkan s: OwnedStr = "hai" + "!";
  biarkan bs: Box<OwnedStr> = box(s);
  cetak "Box<OwnedStr> dicipta";

  kembali 0;
}
