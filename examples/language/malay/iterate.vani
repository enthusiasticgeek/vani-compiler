// vani-lang: malay
//
// build & run:
//   vanic run examples/language/malay/iterate.vani              # LLVM
//   vanic run examples/language/malay/iterate.vani --backend=c  # C

tujuan "Malay vec iteration";

fungsi jumlah_vec(v: ref Vec<i64>) -> i64 {
  biarkan jumlah: i64 = 0;
  untuk i dari 0 hingga len(v) {
    jumlah = jumlah + v[i];
  }
  kembali jumlah;
}

fungsi maks_vec(v: ref Vec<i64>) -> i64 {
  biarkan m: i64 = v[0];
  untuk i dari 1 hingga len(v) {
    jika v[i] > m {
      m = v[i];
    }
  }
  kembali m;
}

fungsi main() -> i64 {
  biarkan v: Vec<i64> = vec(3, 1, 4, 1, 5, 9);
  pastikan jumlah_vec(ref v) == 23;
  pastikan maks_vec(ref v) == 9;
  cetak "jumlah =", jumlah_vec(ref v);
  cetak "maks =", maks_vec(ref v);
  kembali 0;
}
