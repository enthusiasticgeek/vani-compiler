// vani-lang: malay
//
// build & run:
//   vanic run examples/language/malay/early_exit.vani              # LLVM
//   vanic run examples/language/malay/early_exit.vani --backend=c  # C

tujuan "Malay early exit — berhenti/kembali";

fungsi pertama_positif(v: Vec<i64>) -> i64 {
  untuk i dari 0 hingga len(v) {
    jika v[i] > 0 {
      kembali v[i];
    }
  }
  kembali -1;
}

fungsi jumlah_hingga_sifar(v: Vec<i64>) -> i64 {
  biarkan jumlah: i64 = 0;
  untuk i dari 0 hingga len(v) {
    jika v[i] == 0 { berhenti; }
    jumlah = jumlah + v[i];
  }
  kembali jumlah;
}

fungsi main() -> i64 {
  biarkan v: Vec<i64> = vec(-1, -2, 3, 4);
  pastikan pertama_positif(v) == 3;

  biarkan w: Vec<i64> = vec(1, 2, 0, 9);
  pastikan jumlah_hingga_sifar(w) == 3;

  cetak "keluar awal ok";
  kembali 0;
}
