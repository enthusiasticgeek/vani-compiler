// vani-lang: tamil
//
// build & run:
//   vanic run examples/language/tamil/option_types.vani --backend=c  # C (tagged-union)
//   vanic run examples/language/tamil/option_types.vani              # LLVM

நோக்கம் "Payloaded enums via Option<i64>";

// `எண்ணுப்பெயர்` = enum, `பொருந்து` = match, `அப்போது` = then

எண்ணுப்பெயர் Opt { Some(i64), None }

செயல்பாடு unwrap_or(o: Opt, def: i64) -> i64 {
  திருப்பு பொருந்து o {
    Opt.Some(v) அப்போது v,
    Opt.None    அப்போது def,
  };
}

செயல்பாடு is_some(o: Opt) -> i64 {
  திருப்பு பொருந்து o {
    Opt.Some(v) அப்போது 1,
    Opt.None    அப்போது 0,
  };
}

செயல்பாடு main() -> i64 {
  கொள் a: Opt = Opt.Some(42);
  கொள் b: Opt = Opt.None;

  கொள் x: i64 = unwrap_or(a, 0);
  கொள் y: i64 = unwrap_or(b, 100);

  உறுதி x == 42;
  உறுதி y == 100;
  உறுதி is_some(a) == 1;
  உறுதி is_some(b) == 0;

  எழுது "Some(42) unwrapped =", x;
  எழுது "None with default 100 =", y;
  திருப்பு 0;
}
