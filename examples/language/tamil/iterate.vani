// vani-lang: tamil
//
// build & run:
//   vanic run examples/language/tamil/iterate.vani              # LLVM
//   vanic run examples/language/tamil/iterate.vani --backend=c  # C

நோக்கம் "Iterate over arrays and Vecs with for-in ref and consuming for-in";

// `ஒவ்வொரு` = for, `உள்` = in, `பார்` = ref

செயல்பாடு sum_vec(xs: பார் Vec<i64>) -> i64 {
  கொள் total: i64 = 0;
  ஒவ்வொரு x உள் பார் xs {
    total = total + x;
  }
  திருப்பு total;
}

செயல்பாடு max_in_array(xs: பார் [i64; 5]) -> i64 {
  கொள் best: i64 = xs[0];
  ஒவ்வொரு x உள் பார் xs {
    என்றால் x > best {
      best = x;
    }
  }
  திருப்பு best;
}

செயல்பாடு count_positives(xs: பார் Vec<i64>) -> i64 {
  கொள் count: i64 = 0;
  ஒவ்வொரு x உள் பார் xs {
    என்றால் x > 0 {
      count = count + 1;
    }
  }
  திருப்பு count;
}

செயல்பாடு main() -> i64 {
  கொள் nums: Vec<i64> = vec(1, 2, 3, 4, 5);
  கொள் total: i64 = sum_vec(பார் nums);
  உறுதி total == 15;

  கொள் arr: [i64; 5] = [3, 7, 1, 9, 4];
  கொள் m: i64 = max_in_array(பார் arr);
  உறுதி m == 9;

  கொள் mixed: Vec<i64> = vec(0 - 2, 5, 0 - 1, 3, 0, 4);
  கொள் p: i64 = count_positives(பார் mixed);
  உறுதி p == 3;

  கொள் owned: Vec<OwnedStr> = vec("a" + "", "bb" + "", "ccc" + "");
  கொள் owned_total: i64 = 0;
  ஒவ்வொரு s உள் owned {
    owned_total = owned_total + (len(s) ஆக i64);
  }
  உறுதி owned_total == 6;

  எழுது total;
  எழுது m;
  எழுது p;
  எழுது owned_total;
  திருப்பு 0;
}
