// vani-lang: slovak
//
// build & run:
//   vanic run examples/language/slovak/iterate.vani              # LLVM
//   vanic run examples/language/slovak/iterate.vani --backend=c  # C

účel "Slovak vec iteration";

funkcia sucet_vec(v: Vec<i64>) -> i64 {
  nech sucet: i64 = 0;
  pre i od 0 do len(v) {
    sucet = sucet + v[i];
  }
  vráť sucet;
}

funkcia max_vec(v: Vec<i64>) -> i64 {
  nech m: i64 = v[0];
  pre i od 1 do len(v) {
    ak v[i] > m {
      m = v[i];
    }
  }
  vráť m;
}

fn main() -> i64 {
  nech v: Vec<i64> = vec(3, 1, 4, 1, 5, 9);
  potvrď sucet_vec(v) == 23;
  potvrď max_vec(v) == 9;
  vytlač "sucet =", sucet_vec(v);
  vytlač "max =", max_vec(v);
  vráť 0;
}
