// vani-lang: arabic
//
// build & run:
//   vanic run examples/language/arabic/control_flow.vani              # LLVM
//   vanic run examples/language/arabic/control_flow.vani --backend=c  # C

هدف "Arabic if/else and match control flow";

تعداد إشارة { موجبة, صفر, سالبة }

دالة إشارة_عدد(س: i64) -> إشارة {
  إذا س > 0 {
    أرجع إشارة.موجبة;
  } وإلا إذا س == 0 {
    أرجع إشارة.صفر;
  } وإلا {
    أرجع إشارة.سالبة;
  }
}

دالة قيمة_إشارة(إ: إشارة) -> i64 {
  أرجع طابق إ {
    إشارة.موجبة ثم 1,
    إشارة.صفر   ثم 0,
    إشارة.سالبة ثم 0 - 1,
  };
}

دالة main() -> i64 {
  تأكد قيمة_إشارة(إشارة_عدد(5))    == 1;
  تأكد قيمة_إشارة(إشارة_عدد(0))    == 0;
  تأكد قيمة_إشارة(إشارة_عدد(0-3))  == 0 - 1;
  اطبع "control flow OK";
  أرجع 0;
}
