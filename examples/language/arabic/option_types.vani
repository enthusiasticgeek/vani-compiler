// vani-lang: arabic
//
// build & run:
//   vanic run examples/language/arabic/option_types.vani              # LLVM
//   vanic run examples/language/arabic/option_types.vani --backend=c  # C

هدف "Arabic payloaded enums via Opt<i64>";

تعداد خيار { بعض(i64), لا_شيء }

دالة فتح_أو(خ: خيار, افتراضي: i64) -> i64 {
  أرجع طابق خ {
    خيار.بعض(ق) ثم ق,
    خيار.لا_شيء ثم افتراضي,
  };
}

دالة يوجد_بعض(خ: خيار) -> i64 {
  أرجع طابق خ {
    خيار.بعض(ق) ثم 1,
    خيار.لا_شيء ثم 0,
  };
}

دالة main() -> i64 {
  ليكن أ: خيار = خيار.بعض(42);
  ليكن ب: خيار = خيار.لا_شيء;

  ليكن س: i64 = فتح_أو(أ, 0);
  ليكن ص: i64 = فتح_أو(ب, 100);

  تأكد س == 42;
  تأكد ص == 100;
  تأكد يوجد_بعض(أ) == 1;
  تأكد يوجد_بعض(ب) == 0;

  اطبع "Some(42) =", س;
  اطبع "None default 100 =", ص;
  أرجع 0;
}
