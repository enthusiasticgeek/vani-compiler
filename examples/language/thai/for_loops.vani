// vani-lang: thai
//
// build & run:
//   vanic run examples/language/thai/for_loops.vani              # LLVM
//   vanic run examples/language/thai/for_loops.vani --backend=c  # C

จุดประสงค์ "Thai for-loop smoke-test";

ฟังก์ชัน main() -> i64 {
  ให้ ผลรวม: i64 = 0;
  สำหรับ i จาก 1 ถึง 6 {
    ผลรวม = ผลรวม + i;
  }
  ยืนยัน ผลรวม == 15;
  พิมพ์ "Thai for-loops OK", ผลรวม;
  คืน 0;
}
