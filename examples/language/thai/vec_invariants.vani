// vani-lang: thai
//
// build & run:
//   vanic run examples/language/thai/vec_invariants.vani              # LLVM
//   vanic run examples/language/thai/vec_invariants.vani --backend=c  # C

จุดประสงค์ "Loop invariants over Vec length, end-to-end";

ฟังก์ชัน main() -> i64 {
  ให้ รายการ: Vec<i64> = vec(0);
  ให้ นับ: i64 = 1;

  ขณะที่ นับ < 5
  ไม่เปลี่ยน นับ >= 1;
  ไม่เปลี่ยน นับ <= 5;
  {
    รายการ = push(รายการ, นับ * 10);
    นับ = นับ + 1;
  }

  พิสูจน์ นับ == 5;
  ยืนยัน (len(รายการ) เป็น i64) == 5;

  พิมพ์ รายการ[0];
  พิมพ์ รายการ[1];
  พิมพ์ รายการ[2];
  พิมพ์ รายการ[3];
  พิมพ์ รายการ[4];

  คืน 0;
}
