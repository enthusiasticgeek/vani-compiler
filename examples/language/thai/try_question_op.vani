// vani-lang: thai
//
// build & run:
//   vanic run examples/language/thai/try_question_op.vani              # LLVM
//   vanic run examples/language/thai/try_question_op.vani --backend=c  # C

จุดประสงค์ "Thai ? operator smoke-test";

ฟังก์ชัน วิเคราะห์(n: i64) -> Option<i64> {
  ถ้า n < 0 {
    คืน Option.None;
  }
  คืน Option.Some(n * 3);
}

ฟังก์ชัน คำนวณ(n: i64) -> Option<i64> {
  ให้ v: i64 = วิเคราะห์(n)?;
  คืน Option.Some(v + 1);
}

ฟังก์ชัน แกะ(o: Option<i64>, ค่าเริ่มต้น: i64) -> i64 {
  คืน ตรงกัน o {
    Option.Some(v) แล้ว v,
    Option.None แล้ว ค่าเริ่มต้น,
  };
}

ฟังก์ชัน main() -> i64 {
  ให้ ดี: Option<i64> = คำนวณ(4);
  ให้ v1: i64 = แกะ(ดี, 0 - 999);
  ยืนยัน v1 == 13;
  ให้ เสีย: Option<i64> = คำนวณ(-1);
  ให้ v2: i64 = แกะ(เสีย, 0 - 999);
  ยืนยัน v2 == 0 - 999;
  พิมพ์ "Thai ? op OK";
  คืน 0;
}
