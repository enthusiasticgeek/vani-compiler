// vani-lang: thai
//
// build & run:
//   vanic run examples/language/thai/verified.vani              # LLVM
//   vanic run examples/language/thai/verified.vani --backend=c  # C

จุดประสงค์ "Thai requires/proves smoke-test";

ฟังก์ชัน clamp(x: i64, lo: i64) -> i64
ต้องการ lo >= 0;
{
  ถ้า x < lo {
    คืน lo;
  } ไม่เช่นนั้น {
    คืน x;
  }
}

ฟังก์ชัน ลบปลอดภัย(ก: i64, ข: i64) -> i64
ต้องการ ก >= ข;
ต้องการ ข >= 0;
{
  พิสูจน์ ก - ข >= 0;
  คืน ก - ข;
}

ฟังก์ชัน main() -> i64 {
  ให้ x: i64 = clamp(0 - 5, 0);
  ยืนยัน x == 0;
  ให้ d: i64 = ลบปลอดภัย(10, 3);
  ยืนยัน d == 7;
  พิมพ์ "Thai verified OK", d;
  คืน 0;
}
