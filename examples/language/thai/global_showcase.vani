// vani-lang: thai
//
// build & run:
//   vanic run examples/language/thai/global_showcase.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/thai/global_showcase.vani --backend=c              # C backend, gcc
//   vanic build examples/language/thai/global_showcase.vani -o /tmp/global_showcase_thai && /tmp/global_showcase_thai   # native binary

จุดประสงค์ "sum 1..10, checked correct, then printed";

ฟังก์ชัน sum_to(n: i64) -> i64 {
  ให้ total: i64 = 0;
  สำหรับ i จาก 1 ถึง n + 1 {
    total = total + i;
  }
  คืน total;
}

ฟังก์ชัน main() -> i64 {
  ให้ result: i64 = sum_to(10);
  ยืนยัน result == 55;
  พิมพ์ result;
  คืน 0;
}
