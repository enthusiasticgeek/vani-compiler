// vani-lang: thai
//
// build & run:
//   vanic run examples/language/thai/option_types.vani              # LLVM
//   vanic run examples/language/thai/option_types.vani --backend=c  # C

จุดประสงค์ "Thai Option<T> smoke-test";

ฟังก์ชัน หารปลอดภัย(a: i64, b: i64) -> Option<i64> {
  ถ้า b == 0 {
    คืน Option.None;
  }
  คืน Option.Some(a / b);
}

ฟังก์ชัน แกะ(o: Option<i64>, ค่าเริ่มต้น: i64) -> i64 {
  คืน ตรงกัน o {
    Option.Some(v) แล้ว v,
    Option.None แล้ว ค่าเริ่มต้น,
  };
}

ฟังก์ชัน main() -> i64 {
  ให้ ผล: Option<i64> = หารปลอดภัย(10, 2);
  ให้ v: i64 = แกะ(ผล, 0 - 999);
  ยืนยัน v == 5;
  พิมพ์ "Thai option OK", v;
  คืน 0;
}
