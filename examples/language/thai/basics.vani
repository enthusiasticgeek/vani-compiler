// vani-lang: thai
//
// Phase 13.15: first Thai-script vāṇी dialect. New Script::Thai
// variant covering block U+0E00..U+0E7F. SVO grammar; v1 ships
// keyword-first surface.

จุดประสงค์ "Compute a small score with checked constraints";

ฟังก์ชัน add(a: i64, b: i64) -> i64 {
  คืน a + b;
}

ฟังก์ชัน bounded_score(base: i64) -> i64
ต้องการ base >= 0;
{
  ให้ doubled: i64 = base * 2;
  ยืนยัน doubled >= base;
  คืน add(doubled, 2);
}

ฟังก์ชัน main() -> i64 {
  ให้ answer = bounded_score(20);
  พิสูจน์ 2 + 2 == 4;
  ยืนยัน answer >= 0;
  พิมพ์ answer;
  คืน 0;
}
