// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/marathi/try_question_op.vani                  # LLVM
//   vanic run examples/language/marathi/try_question_op.vani --backend=c      # C

उद्देश्य "Arc 8 v3.1 sugar — Marathi counterpart of postfix `?`";

गणन वैकल्पिक { किञ्चित्(i64), रिक्तम् }

कार्य दुप्पट(व: वैकल्पिक) -> वैकल्पिक {
  मान मूल्य: i64 = व?;
  परत वैकल्पिक.किञ्चित्(मूल्य * 2);
}

कार्य मूल्य_किंवा(व: वैकल्पिक, मूलभूत: i64) -> i64 {
  परत जुळवा व {
    वैकल्पिक.किञ्चित्(मूल्य) तर मूल्य,
    वैकल्पिक.रिक्तम् तर मूलभूत,
  };
}

कार्य मुख्य() -> i64 {
  मान क: वैकल्पिक = दुप्पट(वैकल्पिक.किञ्चित्(5));
  खात्री मूल्य_किंवा(क, 0) == 10;

  मान ख: वैकल्पिक = दुप्पट(वैकल्पिक.रिक्तम्);
  खात्री मूल्य_किंवा(ख, 99) == 99;

  लिहा "Some(5)? doubled =", मूल्य_किंवा(क, 0);
  लिहा "None? defaulted to", मूल्य_किंवा(ख, 99);
  परत 0;
}
