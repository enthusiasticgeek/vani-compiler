// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/english/for_loops.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/for_loops.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/for_loops.vani -o /tmp/for_loops && /tmp/for_loops   # native binary

उद्देश्य "for-loops over integer ranges";

कार्य वर्गबेरीज(क: i64) -> i64 {
  मान गोळाबेरीज: i64 = 0;
  साठी ख से 1 तक क {
    गोळाबेरीज = गोळाबेरीज + ख * ख;
  }
  परत गोळाबेरीज;
}

कार्य पहिला_शून्य(सूचिः: पहा [i64; 5]) -> i64 {
  मान परिणाम: i64 = 0 - 1;
  साठी क से 0 तक len(सूचिः) {
    जर सूचिः[क] == 0 {
      परिणाम = क यथा i64;
      थांब;
    }
  }
  परत परिणाम;
}

कार्य मुख्य() -> i64 {
  मान क: i64 = वर्गबेरीज(5);
  खात्री क == 30;

  मान सूचिः: [i64; 5] = [3, 7, 0, 9, 1];
  मान अनुक्रमांक: i64 = पहिला_शून्य(पहा सूचिः);
  खात्री अनुक्रमांक == 2;

  लिहा क;
  लिहा अनुक्रमांक;
  परत 0;
}
