// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/english/verified.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/verified.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/verified.vani -o /tmp/verified && /tmp/verified   # native binary

उद्देश्य "Use the SMT verifier to discharge preconditions";

कार्य किमानसीमा(क: i64, किमान: i64) -> i64
पाहिजे किमान >= 0;
{
  जर क < किमान {
    परत किमान;
  } नाहीतर {
    परत क;
  }
}

कार्य सुरक्षित_वजाबाकी(क: i64, ख: i64) -> i64
पाहिजे क >= ख;
पाहिजे ख >= 0;
{
  सिद्ध करा क - ख >= 0;
  परत क - ख;
}

कार्य मुख्य() -> i64 {
  मान ग: i64 = किमानसीमा(0 - 5, 0);
  खात्री ग == 0;

  मान फरक: i64 = सुरक्षित_वजाबाकी(10, 3);
  खात्री फरक == 7;

  लिहा फरक;
  परत 0;
}
