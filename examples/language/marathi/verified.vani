// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/english/verified.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/verified.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/verified.vani -o /tmp/verified && /tmp/verified   # native binary

उद्देश्य "Use the SMT verifier to discharge preconditions";

कार्य clamp_low(x: i64, lo: i64) -> i64
पाहिजे lo >= 0;
{
  जर x < lo {
    परत lo;
  } नाहीतर {
    परत x;
  }
}

कार्य safe_subtract(a: i64, b: i64) -> i64
पाहिजे a >= b;
पाहिजे b >= 0;
{
  सिद्ध करा a - b >= 0;
  परत a - b;
}

कार्य main() -> i64 {
  मान x: i64 = clamp_low(0 - 5, 0);
  खात्री x == 0;

  मान d: i64 = safe_subtract(10, 3);
  खात्री d == 7;

  लिहा d;
  परत 0;
}
