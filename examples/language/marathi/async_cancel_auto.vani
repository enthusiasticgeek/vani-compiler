// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/marathi/async_cancel_auto.vani                # LLVM
//   vanic run examples/language/marathi/async_cancel_auto.vani --backend=c    # C
//
// Marathi smoke of the async/await dialect lift (2026-06-08).
// `async` spells as `अतुल्यकालिक` (atulyakālika) and `await(…)`
// as `प्रतीक्षा` (pratīkṣā).

उद्देश्य "Marathi async/await dialect lift smoke";

अतुल्यकालिक कार्य विलंब(काळ: i64, मूल्य: i64) -> i64 {
  sleep_ms(काळ);
  परत मूल्य;
}

कार्य मुख्य() -> i64 {
  मान क: i64 = प्रतीक्षा(विलंब(5, 42));
  मान ख: i64 = प्रतीक्षा(विलंब(10, 7));

  खात्री क == 42;
  खात्री ख == 7;
  लिहा "delays:", क, ख;
  परत 0;
}
