// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/english/iterate.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/iterate.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/iterate.vani -o /tmp/iterate && /tmp/iterate   # native binary

उद्देश्य "Iterate over arrays and Vecs with `for x in ref xs` and consuming `for x in xs`";

कार्य सूचीबेरीज(सूचिः: पहा Vec<i64>) -> i64 {
  मान गोळाबेरीज: i64 = 0;
  साठी क में पहा सूचिः {
    गोळाबेरीज = गोळाबेरीज + क;
  }
  परत गोळाबेरीज;
}

कार्य कमाल(सारणी: पहा [i64; 5]) -> i64 {
  मान उच्चतम: i64 = सारणी[0];
  साठी क में पहा सारणी {
    जर क > उच्चतम {
      उच्चतम = क;
    }
  }
  परत उच्चतम;
}

कार्य धनगणना(सूचिः: पहा Vec<i64>) -> i64 {
  मान गणना: i64 = 0;
  साठी क में पहा सूचिः {
    जर क > 0 {
      गणना = गणना + 1;
    }
  }
  परत गणना;
}

कार्य मुख्य() -> i64 {
  मान सूचिः: Vec<i64> = vec(1, 2, 3, 4, 5);
  मान गोळाबेरीज: i64 = सूचीबेरीज(पहा सूचिः);
  खात्री गोळाबेरीज == 15;

  मान सारणी: [i64; 5] = [3, 7, 1, 9, 4];
  मान उच्चतम: i64 = कमाल(पहा सारणी);
  खात्री उच्चतम == 9;

  मान सूचिः२: Vec<i64> = vec(0 - 2, 5, 0 - 1, 3, 0, 4);
  मान धनसंख्या: i64 = धनगणना(पहा सूचिः२);
  खात्री धनसंख्या == 3;

  // Consuming `for x in xs` over a Vec<OwnedStr>: each
  // element is moved into x and freed at scope exit. The
  // outer buffer is freed by the loop's post-exit code.
  // Closure #159 — previously double-freed the per-element
  // heap because `intent_vec_<owned_str>__free` would walk
  // every slot after closure #127's deep-drop change.
  मान सूचिः३: Vec<OwnedStr> = vec("a" + "", "bb" + "", "ccc" + "");
  मान कुलबेरीज: i64 = 0;
  साठी क में सूचिः३ {
    कुलबेरीज = कुलबेरीज + (len(क) यथा i64);
  }
  खात्री कुलबेरीज == 6;

  लिहा गोळाबेरीज;
  लिहा उच्चतम;
  लिहा धनसंख्या;
  लिहा कुलबेरीज;
  परत 0;
}
