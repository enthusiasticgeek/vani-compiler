// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/english/early_exit.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/early_exit.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/early_exit.vani -o /tmp/early_exit && /tmp/early_exit   # native binary

उद्देश्य "break and continue for early exit and skip";

कार्य पहिला_ऋणात्मक(सूचिः: पहा Vec<i64>) -> i64 {
  मान क: u64 = 0;
  मान परिणाम: i64 = 0 - 1;
  जोपर्यंत क < len(सूचिः) {
    जर सूचिः[क] < 0 {
      परिणाम = सूचिः[क];
      थांब;
    }
    क = क + 1;
  }
  परत परिणाम;
}

कार्य धनात्मक_गणना(सूचिः: पहा Vec<i64>) -> i64 {
  मान क: u64 = 0;
  मान गणना: i64 = 0;
  जोपर्यंत क < len(सूचिः) {
    जर सूचिः[क] <= 0 {
      क = क + 1;
      पुढे;
    }
    गणना = गणना + 1;
    क = क + 1;
  }
  परत गणना;
}

कार्य मुख्य() -> i64 {
  मान सूचिः: Vec<i64> = vec(1, 2, 0 - 3, 4, 0 - 5);
  मान पहिला_ऋण: i64 = पहिला_ऋणात्मक(पहा सूचिः);
  मान धनात्मक: i64 = धनात्मक_गणना(पहा सूचिः);
  खात्री पहिला_ऋण == 0 - 3;
  खात्री धनात्मक == 3;
  लिहा पहिला_ऋण;
  लिहा धनात्मक;
  परत 0;
}
