// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/english/control_flow.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/control_flow.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/control_flow.vani -o /tmp/control_flow && /tmp/control_flow   # native binary

उद्देश्य "Demonstrate if/else and while loops with Vec mutation";

कार्य बेरीज(सूचिः: पहा Vec<i64>) -> i64 {
  मान गोळाबेरीज: i64 = 0;
  मान क: u64 = 0;
  मान लांबी: u64 = len(सूचिः);
  जोपर्यंत क < लांबी {
    गोळाबेरीज = गोळाबेरीज + सूचिः[क];
    क = क + 1;
  }
  परत गोळाबेरीज;
}

कार्य श्रेणी_बनवा(क: i64) -> Vec<i64> {
  मान सूचिः: Vec<i64> = vec(0);
  मान ख: i64 = 1;
  जोपर्यंत ख < क {
    सूचिः = push(सूचिः, ख);
    ख = ख + 1;
  }
  परत सूचिः;
}

कार्य मुख्य() -> i64 {
  मान सूचिः: Vec<i64> = श्रेणी_बनवा(5);
  मान गोळाबेरीज: i64 = बेरीज(पहा सूचिः);
  जर गोळाबेरीज > 5 {
    खात्री गोळाबेरीज == 10;
  } नाहीतर {
    खात्री गोळाबेरीज <= 5;
  }
  लिहा गोळाबेरीज;
  परत 0;
}
