// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/english/control_flow.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/control_flow.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/control_flow.vani -o /tmp/control_flow && /tmp/control_flow   # native binary

उद्देश्य "Demonstrate if/else and while loops with Vec mutation";

कार्य sum(xs: पहा Vec<i64>) -> i64 {
  मान total: i64 = 0;
  मान i: u64 = 0;
  मान n: u64 = len(xs);
  जोपर्यंत i < n {
    total = total + xs[i];
    i = i + 1;
  }
  परत total;
}

कार्य build_range(n: i64) -> Vec<i64> {
  मान xs: Vec<i64> = vec(0);
  मान i: i64 = 1;
  जोपर्यंत i < n {
    xs = push(xs, i);
    i = i + 1;
  }
  परत xs;
}

कार्य main() -> i64 {
  मान xs: Vec<i64> = build_range(5);
  मान total: i64 = sum(पहा xs);
  जर total > 5 {
    खात्री total == 10;
  } नाहीतर {
    खात्री total <= 5;
  }
  लिखो total;
  परत 0;
}
