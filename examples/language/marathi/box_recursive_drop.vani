// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/marathi/box_recursive_drop.vani                # LLVM
//   vanic run examples/language/marathi/box_recursive_drop.vani --backend=c    # C

उद्देश्य "L2 follow-up — Box<Vec<T>> + Box<OwnedStr> recursive drop (Marathi)";

संरचना पिशवी {
  सामग्री: Box<Vec<i64>>,
}

कार्य मुख्य() -> i64 {
  मान क: Vec<i64> = vec(10, 20, 30);
  मान ख: Box<Vec<i64>> = box(क);
  लिहा "constructed Box<Vec<i64>>";

  मान ग: Vec<i64> = vec(7, 8, 9);
  मान घ: पिशवी = पिशवी { सामग्री: box(ग) };
  लिहा "constructed Bag";

  मान ङ: OwnedStr = "hi" + "!";
  मान च: Box<OwnedStr> = box(ङ);
  लिहा "constructed Box<OwnedStr>";

  परत 0;
}
