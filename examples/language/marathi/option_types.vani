// श्री।
// vani-lang: marathi
//
// build & run:
//   vanic run examples/language/english/option_types.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/option_types.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/option_types.vani -o /tmp/option_types && /tmp/option_types   # native binary

उद्देश्य "Demonstrate payloaded enums via Option<i64>";

// T1.3 phase 2b: payloaded enums compile end-to-end via the
// tree-C backend. The compiler lays the enum out as a
// tagged-union struct (`typedef struct { i32 tag; i64 payload;
// } Enum_Opt;`); `Opt.Some(x)` builds the struct literal,
// `match` dispatches on `.tag`, and `Opt.Some(v) then …`
// extracts `.payload` into the binding `v` for the arm body.
//
// V1 limits: single Copy payload field per variant; all
// payload-bearing variants of an enum must share the same
// payload type. LLVM tagged-union codegen ships in a
// follow-up — for now run with `--backend=c`.

गणन वैकल्पिक { किञ्चित्(i64), रिक्तम् }

कार्य मूल्य_किंवा(व: वैकल्पिक, मूलभूत: i64) -> i64 {
  परत जुळवा व {
    वैकल्पिक.किञ्चित्(मूल्य) तर मूल्य,
    वैकल्पिक.रिक्तम् तर मूलभूत,
  };
}

कार्य काही_आहे(व: वैकल्पिक) -> i64 {
  परत जुळवा व {
    वैकल्पिक.किञ्चित्(मूल्य) तर 1,
    वैकल्पिक.रिक्तम् तर 0,
  };
}

कार्य मुख्य() -> i64 {
  मान क: वैकल्पिक = वैकल्पिक.किञ्चित्(42);
  मान ख: वैकल्पिक = वैकल्पिक.रिक्तम्;

  // Pattern destructure pulls the payload out into `मूल्य`.
  मान ग: i64 = मूल्य_किंवा(क, 0);
  मान घ: i64 = मूल्य_किंवा(ख, 100);

  खात्री ग == 42;
  खात्री घ == 100;
  खात्री काही_आहे(क) == 1;
  खात्री काही_आहे(ख) == 0;

  लिहा "Some(42) unwrapped =", ग;
  लिहा "None unwrapped with default 100 =", घ;
  परत 0;
}
