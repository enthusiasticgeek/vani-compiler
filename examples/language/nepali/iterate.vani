// vani-lang: nepali
//
// build & run:
//   vanic run examples/language/nepali/iterate.vani              # LLVM
//   vanic run examples/language/nepali/iterate.vani --backend=c  # C

उद्देश्य "Nepali Vec iteration smoke-test";

कार्य main() -> i64 {
  माना सूचिः: Vec<i64> = vec();
  सूचिः = push(सूचिः, 10);
  सूचिः = push(सूचिः, 20);
  सूचिः = push(सूचिः, 30);
  सुनिश्चित सूचिः[0] == 10;
  सुनिश्चित सूचिः[1] == 20;
  सुनिश्चित सूचिः[2] == 30;
  लिखो "Nepali iterate OK";
  लौटाओ 0;
}
