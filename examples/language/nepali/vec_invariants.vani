// vani-lang: nepali
//
// build & run:
//   vanic run examples/language/nepali/vec_invariants.vani              # LLVM
//   vanic run examples/language/nepali/vec_invariants.vani --backend=c  # C

उद्देश्य "Nepali Vec invariants smoke-test";

कार्य main() -> i64 {
  माना सूचिः: Vec<i64> = vec();
  सूचिः = push(सूचिः, 10);
  सूचिः = push(सूचिः, 20);
  सूचिः = push(सूचिः, 30);
  सूचिः = push(सूचिः, 40);
  सूचिः = push(सूचिः, 50);
  सुनिश्चित (len(सूचिः) यथा i64) == 5;
  माना i: i64 = 0;
  जबतक i < 5
  अपरिवर्तनीय i >= 0;
  अपरिवर्तनीय i <= 5;
  {
    सुनिश्चित सूचिः[i] > 0;
    i = i + 1;
  }
  लिखो "Nepali vec invariants OK";
  लौटाओ 0;
}
