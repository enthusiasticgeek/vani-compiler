// vani-lang: lao
//
// build & run:
//   vanic run examples/language/lao/try_question_op.vani              # LLVM
//   vanic run examples/language/lao/try_question_op.vani --backend=c  # C

ຈຸດປະສົງ "Lao ? operator smoke-test";

ໜ້າທີ່ ວິເຄາະ(n: i64) -> Option<i64> {
  ຖ້າ n < 0 {
    ກັບຄືນ Option.None;
  }
  ກັບຄືນ Option.Some(n * 3);
}

ໜ້າທີ່ ຄຳນວນ(n: i64) -> Option<i64> {
  ໃຫ້ v: i64 = ວິເຄາະ(n)?;
  ກັບຄືນ Option.Some(v + 1);
}

ໜ້າທີ່ ແກ້(o: Option<i64>, ຄ່າເລີ່ມຕົ້ນ: i64) -> i64 {
  ກັບຄືນ ກົງກັນ o {
    Option.Some(v) ແລ້ວ v,
    Option.None ແລ້ວ ຄ່າເລີ່ມຕົ້ນ,
  };
}

ໜ້າທີ່ main() -> i64 {
  ໃຫ້ ດີ: Option<i64> = ຄຳນວນ(4);
  ໃຫ້ v1: i64 = ແກ້(ດີ, 0 - 999);
  ຢືນຢັນ v1 == 13;
  ໃຫ້ ບໍ່ດີ: Option<i64> = ຄຳນວນ(-1);
  ໃຫ້ v2: i64 = ແກ້(ບໍ່ດີ, 0 - 999);
  ຢືນຢັນ v2 == 0 - 999;
  ພິມ "Lao ? op OK";
  ກັບຄືນ 0;
}
