// vani-lang: lao
//
// build & run:
//   vanic run examples/language/lao/option_types.vani              # LLVM
//   vanic run examples/language/lao/option_types.vani --backend=c  # C

ຈຸດປະສົງ "Lao Option<T> smoke-test";

ໜ້າທີ່ ຫານປອດໄພ(a: i64, b: i64) -> Option<i64> {
  ຖ້າ b == 0 {
    ກັບຄືນ Option.None;
  }
  ກັບຄືນ Option.Some(a / b);
}

ໜ້າທີ່ ແກ້(o: Option<i64>, ຄ່າເລີ່ມຕົ້ນ: i64) -> i64 {
  ກັບຄືນ ກົງກັນ o {
    Option.Some(v) ແລ້ວ v,
    Option.None ແລ້ວ ຄ່າເລີ່ມຕົ້ນ,
  };
}

ໜ້າທີ່ main() -> i64 {
  ໃຫ້ ຜົນ: Option<i64> = ຫານປອດໄພ(10, 2);
  ໃຫ້ v: i64 = ແກ້(ຜົນ, 0 - 999);
  ຢືນຢັນ v == 5;
  ພິມ "Lao option OK", v;
  ກັບຄືນ 0;
}
