// vani-lang: urdu
مقصد "Urdu early exit smoke-test";
فنکشن پہلا_صفر(فہرست: Vec<i64>) -> i64 {
  مانیں i: i64 = 0;
  دوران i < (len(فہرست) بطور i64) {
    اگر فہرست[i] == 0 { واپس i; }
    i = i + 1;
  }
  واپس -1;
}
فنکشن main() -> i64 {
  مانیں و: Vec<i64> = vec();
  و = push(و, 3);
  و = push(و, 0);
  و = push(و, 7);
  یقینی پہلا_صفر(و) == 1;
  مانیں i: i64 = 0;
  دوران i < 5 {
    اگر i == 3 { بند; }
    i = i + 1;
  }
  یقینی i == 3;
  لکھو "Urdu early exit OK";
  واپس 0;
}
