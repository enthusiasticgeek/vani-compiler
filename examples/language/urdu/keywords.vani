// vani-lang: urdu
مقصد "Urdu keywords smoke-test";
ساخت نقطہ {
  x: i64,
  y: i64,
}
شمار رنگ { سرخ, سبز, نیلا }
فنکشن جمع(ک: i64, خ: i64) -> i64 {
  واپس ک + خ;
}
فنکشن main() -> i64 {
  مانیں ن: نقطہ = نقطہ { x: 3, y: 4 };
  یقینی ن.x == 3;
  یقینی جمع(2, 3) == 5;
  لکھو "Urdu keywords OK";
  واپس 0;
}
