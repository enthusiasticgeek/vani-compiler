// vani-lang: urdu
مقصد "Urdu control flow smoke-test";
فنکشن درجہ_بندی(x: i64) -> i64 {
  اگر x > 0 { واپس 1; } ورنہ اگر x < 0 { واپس -1; } ورنہ { واپس 0; }
}
فنکشن main() -> i64 {
  یقینی درجہ_بندی(5) == 1;
  یقینی درجہ_بندی(-3) == -1;
  یقینی درجہ_بندی(0) == 0;
  لکھو "Urdu control flow OK";
  واپس 0;
}
