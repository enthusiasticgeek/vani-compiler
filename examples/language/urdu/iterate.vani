// vani-lang: urdu
مقصد "Urdu iterate smoke-test";
فنکشن main() -> i64 {
  مانیں فہرست: Vec<i64> = vec();
  فہرست = push(فہرست, 10);
  فہرست = push(فہرست, 20);
  فہرست = push(فہرست, 30);
  یقینی فہرست[0] == 10;
  یقینی فہرست[1] == 20;
  یقینی فہرست[2] == 30;
  مانیں کل: i64 = 0;
  مانیں i: i64 = 0;
  دوران i < (len(فہرست) بطور i64) {
    کل = کل + فہرست[i];
    i = i + 1;
  }
  یقینی کل == 60;
  لکھو "Urdu iterate OK";
  واپس 0;
}
