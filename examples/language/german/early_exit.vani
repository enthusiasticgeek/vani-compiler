// vani-lang: german
//
// build & run:
//   vanic run examples/language/german/early_exit.vani              # LLVM
//   vanic run examples/language/german/early_exit.vani --backend=c  # C

intent "break and continue in loops";

// This file uses English `break`/`continue` (no German alias for
// either in v1 -- an earlier "auflösen" = break claim here was
// wrong: auflösen actually means "to dissolve/resolve", not
// "break", and was never a registered keyword for this file to use)

fn count_odd(limit: i64) -> i64 {
  let count: i64 = 0;
  für i from 1 to limit {
    if i * 2 == i + i {
      continue;
    }
    count = count + 1;
  }
  zurück count;
}

fn main() -> i64 {
  überprüfe count_odd(4) == 2;
  drucken count_odd(4);
  zurück 0;
}
