// vani-lang: german
//
// build & run:
//   vanic run examples/language/german/option_types.vani              # LLVM
//   vanic run examples/language/german/option_types.vani --backend=c  # C

intent "Payloaded enums via Option<i64>";

// `aufzählung` = enum; `übereinstimmen` = match; English `then`

aufzählung Opt { Some(i64), None }

fn unwrap_or(o: Opt, def: i64) -> i64 {
  return übereinstimmen o {
    Opt.Some(v) then v,
    Opt.None    then def,
  };
}

fn is_some(o: Opt) -> i64 {
  return übereinstimmen o {
    Opt.Some(v) then 1,
    Opt.None    then 0,
  };
}

fn main() -> i64 {
  let a: Opt = Opt.Some(42);
  let b: Opt = Opt.None;

  let x: i64 = unwrap_or(a, 0);
  let y: i64 = unwrap_or(b, 100);

  überprüfe x == 42;
  überprüfe y == 100;
  überprüfe is_some(a) == 1;
  überprüfe is_some(b) == 0;

  drucken "Some(42) unwrapped =", x;
  drucken "None with default 100 =", y;
  zurück 0;
}
