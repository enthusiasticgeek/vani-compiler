// vani-lang: german
//
// build & run:
//   vanic run examples/language/german/vec_invariants.vani              # LLVM
//   vanic run examples/language/german/vec_invariants.vani --backend=c  # C

intent "Loop invariants over Vec length, end-to-end";

fn main() -> i64 {
  let xs: Vec<i64> = vec(0);
  let i: i64 = 1;

  während i < 5
  invariant len(xs) == (i as u64);
  invariant i >= 1;
  invariant i <= 5;
  {
    xs = push(xs, i * 10);
    i = i + 1;
  }

  prove i == 5;
  prove len(xs) == 5;

  ausführe xs[0];
  ausführe xs[1];
  ausführe xs[2];
  ausführe xs[3];
  ausführe xs[4];

  zurück 0;
}
