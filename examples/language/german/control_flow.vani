// vani-lang: german
//
// build & run:
//   vanic run examples/language/german/control_flow.vani              # LLVM
//   vanic run examples/language/german/control_flow.vani --backend=c  # C

intent "if/else and while control flow";

fn sign(x: i64) -> i64 {
  if x > 0 {
    zurück 1;
  } else {
    if x < 0 {
      zurück 0 - 1;
    } else {
      zurück 0;
    }
  }
}

fn main() -> i64 {
  überprüfe sign(5) == 1;
  überprüfe sign(0 - 3) == 0 - 1;
  überprüfe sign(0) == 0;

  let i: i64 = 0;
  während i < 5 {
    i = i + 1;
  }
  überprüfe i == 5;

  ausführe sign(42);
  zurück 0;
}
