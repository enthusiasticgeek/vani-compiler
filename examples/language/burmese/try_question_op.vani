// vani-lang: burmese
//
// build & run:
//   vanic run examples/language/burmese/try_question_op.vani              # LLVM
//   vanic run examples/language/burmese/try_question_op.vani --backend=c  # C

ရည်ရွယ်ချက် "Burmese ? operator smoke-test";

လုပ်ဆောင်ချက် စစ်ဆေး(n: i64) -> Option<i64> {
  ဆိုလျှင် n < 0 {
    ပြန် Option.None;
  }
  ပြန် Option.Some(n * 3);
}

လုပ်ဆောင်ချက် တွက်ချက်(n: i64) -> Option<i64> {
  ထား v: i64 = စစ်ဆေး(n)?;
  ပြန် Option.Some(v + 1);
}

လုပ်ဆောင်ချက် ဖြေရှင်း(o: Option<i64>, မူလတန်ဖိုး: i64) -> i64 {
  ပြန် ကိုက်ညီ o {
    Option.Some(v) ထို့နောက် v,
    Option.None ထို့နောက် မူလတန်ဖိုး,
  };
}

လုပ်ဆောင်ချက် main() -> i64 {
  ထား ကောင်း: Option<i64> = တွက်ချက်(4);
  ထား v1: i64 = ဖြေရှင်း(ကောင်း, 0 - 999);
  သေချာ v1 == 13;
  ထား မကောင်း: Option<i64> = တွက်ချက်(-1);
  ထား v2: i64 = ဖြေရှင်း(မကောင်း, 0 - 999);
  သေချာ v2 == 0 - 999;
  ပုံနှိပ် "Burmese ? op OK";
  ပြန် 0;
}
