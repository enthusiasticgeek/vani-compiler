// vani-lang: burmese
//
// build & run:
//   vanic run examples/language/burmese/verified.vani              # LLVM
//   vanic run examples/language/burmese/verified.vani --backend=c  # C

ရည်ရွယ်ချက် "Burmese requires/proves smoke-test";

လုပ်ဆောင်ချက် clamp(x: i64, lo: i64) -> i64
လို lo >= 0;
{
  ဆိုလျှင် x < lo {
    ပြန် lo;
  } မဟုတ်ပါက {
    ပြန် x;
  }
}

လုပ်ဆောင်ချက် နုတ်ပလုံ(က: i64, ခ: i64) -> i64
လို က >= ခ;
လို ခ >= 0;
{
  သက်သေပြ က - ခ >= 0;
  ပြန် က - ခ;
}

လုပ်ဆောင်ချက် main() -> i64 {
  ထား x: i64 = clamp(0 - 5, 0);
  သေချာ x == 0;
  ထား d: i64 = နုတ်ပလုံ(10, 3);
  သေချာ d == 7;
  ပုံနှိပ် "Burmese verified OK", d;
  ပြန် 0;
}
