// vani-lang: burmese
//
// build & run:
//   vanic run examples/language/burmese/early_exit.vani              # LLVM
//   vanic run examples/language/burmese/early_exit.vani --backend=c  # C

ရည်ရွယ်ချက် "Burmese early-exit (break) smoke-test";

လုပ်ဆောင်ချက် main() -> i64 {
  ထား n: i64 = 0;
  နေစဉ် n < 100 {
    ဆိုလျှင် n == 5 {
      ရပ်;
    }
    n = n + 1;
  }
  သေချာ n == 5;
  ပုံနှိပ် "Burmese early exit OK", n;
  ပြန် 0;
}
