// vani-lang: burmese
//
// build & run:
//   vanic run examples/language/burmese/iterate.vani              # LLVM
//   vanic run examples/language/burmese/iterate.vani --backend=c  # C

ရည်ရွယ်ချက် "Burmese Vec iteration smoke-test";

လုပ်ဆောင်ချက် main() -> i64 {
  ထား ပစ္စည်း: Vec<i64> = vec();
  ပစ္စည်း = push(ပစ္စည်း, 10);
  ပစ္စည်း = push(ပစ္စည်း, 20);
  ပစ္စည်း = push(ပစ္စည်း, 30);
  သေချာ ပစ္စည်း[0] == 10;
  သေချာ ပစ္စည်း[1] == 20;
  သေချာ ပစ္စည်း[2] == 30;
  ပုံနှိပ် "Burmese iterate OK";
  ပြန် 0;
}
