// vani-lang: konkani
उद्देश्य "Konkani control flow smoke-test";
कार्य वर्गीकरण(x: i64) -> i64 {
  यदि x > 0 { लौटाओ 1; } अन्यथा यदि x < 0 { लौटाओ -1; } अन्यथा { लौटाओ 0; }
}
कार्य main() -> i64 {
  सिद्ध वर्गीकरण(5) == 1;
  सिद्ध वर्गीकरण(-3) == -1;
  सिद्ध वर्गीकरण(0) == 0;
  लिखो "Konkani control flow OK";
  लौटाओ 0;
}
