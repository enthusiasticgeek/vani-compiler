// vani-lang: konkani
//
// build & run:
//   vanic run examples/language/konkani/box_recursive_drop.vani              # LLVM
//   vanic run examples/language/konkani/box_recursive_drop.vani --backend=c  # C

उद्देश्य "Konkani Box recursive drop smoke-test";

संरचना Bag {
  contents: Box<Vec<i64>>,
}

कार्य main() -> i64 {
  माना v: Vec<i64> = vec();
  v = push(v, 10);
  v = push(v, 20);
  v = push(v, 30);
  माना b: Box<Vec<i64>> = box(v);
  माना v2: Vec<i64> = vec();
  v2 = push(v2, 7);
  माना थैला: Bag = Bag { contents: box(v2) };
  लिखो "Konkani box recursive drop OK";
  लौटाओ 0;
}
