// vani-lang: konkani
उद्देश्य "Konkani early exit smoke-test";
कार्य पहिलो_शून्य(सूची: Vec<i64>) -> i64 {
  माना i: i64 = 0;
  जबतक i < (len(सूची) यथा i64) {
    यदि सूची[i] == 0 { लौटाओ i; }
    i = i + 1;
  }
  लौटाओ -1;
}
कार्य main() -> i64 {
  माना व: Vec<i64> = vec(0);
  व = push(व, 3);
  व = push(व, 0);
  व = push(व, 7);
  सिद्ध पहिलो_शून्य(व) == 1;
  माना i: i64 = 0;
  जबतक i < 5 {
    यदि i == 3 { विराम; }
    i = i + 1;
  }
  सिद्ध i == 3;
  लिखो "Konkani early exit OK";
  लौटाओ 0;
}
