// vani-lang: konkani
उद्देश्य "Konkani keywords smoke-test";
संरचना बिंदू {
  x: i64,
  y: i64,
}
गणन रंग { लाल, हिरवा, निळा }
कार्य बेरीज(क: i64, ख: i64) -> i64 {
  लौटाओ क + ख;
}
कार्य main() -> i64 {
  माना प: बिंदू = बिंदू { x: 3, y: 4 };
  सुनिश्चित प.x == 3;
  सुनिश्चित बेरीज(2, 3) == 5;
  लिखो "Konkani keywords OK";
  लौटाओ 0;
}
