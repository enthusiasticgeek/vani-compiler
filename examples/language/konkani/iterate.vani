// vani-lang: konkani
उद्देश्य "Konkani iterate smoke-test";
कार्य main() -> i64 {
  माना सूची: Vec<i64> = vec(0);
  सूची = push(सूची, 10);
  सूची = push(सूची, 20);
  सूची = push(सूची, 30);
  सिद्ध सूची[0] == 10;
  सिद्ध सूची[1] == 20;
  सिद्ध सूची[2] == 30;
  माना एकूण: i64 = 0;
  माना i: i64 = 0;
  जबतक i < (len(सूची) यथा i64) {
    एकूण = एकूण + सूची[i];
    i = i + 1;
  }
  सिद्ध एकूण == 60;
  लिखो "Konkani iterate OK";
  लौटाओ 0;
}
