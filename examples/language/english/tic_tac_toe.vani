// build & run:
//   vanic run examples/language/english/tic_tac_toe.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/tic_tac_toe.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/tic_tac_toe.vani -o /tmp/ttt && /tmp/ttt   # native binary

intent "Terminal tic-tac-toe -- two human players share one terminal, taking turns to type a cell number 1-9";

// A minimal interactive game, meant as a from-scratch demonstration of
// vāṇी: Vec<i64> as mutable game state, stdin_read_line() + parse_int()
// for input, string concatenation (`+`) to build the printed board, and
// plain control flow (no structs/interfaces needed for something this
// small).
//
// Board layout (empty cells show their own position number as a
// prompt, exactly like the boxes on a real tic-tac-toe sheet):
//
//    1 | 2 | 3
//   ---+---+---
//    4 | 5 | 6
//   ---+---+---
//    7 | 8 | 9
//
// Board state is a flat Vec<i64> of length 9: 0 = empty, 1 = X, 2 = O.
//
// Color is ANSI escape codes (`\x1b[...m`), built via the `\x` hex
// escape in string literals. `const` initializers in v1 must be a
// bare literal (`42`, `true`, ...) -- no string literals, function
// calls, or concatenation -- so the named colors below are tiny
// wrapper functions instead of constants: still one named place to
// change a color, just spelled as `fn` instead of `const`. Each
// color is reset immediately after so it doesn't bleed into the
// board's `|`/`-` separators. Empty cells stay uncolored (they're
// just a position number, not a player's mark).

fn ansi_red() -> Str { return "\x1b[31m"; }
fn ansi_blue() -> Str { return "\x1b[34m"; }
fn ansi_yellow() -> Str { return "\x1b[33m"; }
fn ansi_reset() -> Str { return "\x1b[0m"; }

fn player_label(player: i64) -> OwnedStr {
  if player == 1 {
    return ansi_red() + "X" + ansi_reset();
  }
  return ansi_blue() + "O" + ansi_reset();
}

fn symbol_for(v: i64, pos: i64) -> OwnedStr {
  if v == 1 {
    return player_label(1);
  }
  if v == 2 {
    return player_label(2);
  }
  return i64_to_str(pos);
}

fn print_board(board: ref Vec<i64>) -> i64 {
  let row1: OwnedStr = " " + symbol_for(board[0], 1) + " | " + symbol_for(board[1], 2) + " | " + symbol_for(board[2], 3);
  let row2: OwnedStr = " " + symbol_for(board[3], 4) + " | " + symbol_for(board[4], 5) + " | " + symbol_for(board[5], 6);
  let row3: OwnedStr = " " + symbol_for(board[6], 7) + " | " + symbol_for(board[7], 8) + " | " + symbol_for(board[8], 9);
  print row1;
  print "---+---+---";
  print row2;
  print "---+---+---";
  print row3;
  return 0;
}

// Returns 0 (no winner yet), 1 (X has three in a row), or 2 (O does).
// `lines` is the flat list of the 8 winning triples (3 rows, 3
// columns, 2 diagonals), 3 board indices each.
fn winner_of(board: ref Vec<i64>) -> i64 {
  let lines: Vec<i64> = vec(
    0, 1, 2,  3, 4, 5,  6, 7, 8,
    0, 3, 6,  1, 4, 7,  2, 5, 8,
    0, 4, 8,  2, 4, 6
  );
  let li: u64 = 0;
  while li < 8 as u64 {
    let base: u64 = li * 3 as u64;
    let a: i64 = board[lines[base] as u64];
    let b: i64 = board[lines[base + 1 as u64] as u64];
    let c: i64 = board[lines[base + 2 as u64] as u64];
    if a != 0 {
      if a == b {
        if b == c {
          return a;
        }
      }
    }
    li = li + 1 as u64;
  }
  return 0;
}

// Prompts the current player until they either type a valid, empty
// cell number (1-9), or ask to quit (typing "quit", or a blank line).
// A blank line also covers real end-of-input: on a closed/piped
// stdin with nothing left to read, stdin_read_line() returns "" just
// like a literal empty Enter press -- vāṇी's runtime doesn't expose a
// separate EOF signal, so treating "" as "quit" is what keeps this
// loop from spinning forever when stdin isn't an interactive terminal.
// Returns the chosen move as a 0-based board index, or -1 for quit.
//
// The `ensures` clause below isn't a runtime check -- it's a claim
// the SMT solver must *prove* holds on every return path in this
// function, at compile time. Try tightening it to
// `_return >= 0 && _return <= 5` and re-running `vanic check` on
// this file: the solver rejects it with a concrete counterexample
// (idx = 6, from n = 7) instead of silently shipping a bug.
fn read_move(board: ref Vec<i64>, player: i64) -> i64
requires len(board) == 9 as u64;
ensures _return == 0 - 1 || (_return >= 0 && _return <= 8);
{
  while true {
    let prompt: OwnedStr = "Player " + player_label(player) + ", enter a position (1-9), or 'quit' to exit:";
    print prompt;
    flush_stdout();
    let input: OwnedStr = stdin_read_line();
    let trimmed: OwnedStr = str_trim(input);
    if trimmed == "" {
      return 0 - 1;
    }
    if trimmed == "quit" {
      return 0 - 1;
    }
    if let Option.Some(n) = parse_int(trimmed) {
      if n >= 1 {
        if n <= 9 {
          let idx: i64 = n - 1;
          if board[idx as u64] == 0 {
            return idx;
          } else {
            print "That cell is already taken -- try again.";
          }
        } else {
          print "Please enter a number from 1 to 9.";
        }
      } else {
        print "Please enter a number from 1 to 9.";
      }
    } else {
      print "That's not a number -- try again.";
    }
  }
  return 0 - 1;
}

fn main() -> i64 {
  let board: Vec<i64> = vec_fill(9, 0);
  let player: i64 = 1;
  let winner: i64 = 0;
  let moves_made: i64 = 0;

  print "vani tic-tac-toe -- two players, one terminal";
  print "";

  while true {
    print_board(ref board);
    print "";
    let idx: i64 = read_move(ref board, player);
    if idx < 0 {
      print "Goodbye!";
      return 0;
    }
    board[idx as u64] = player;
    moves_made = moves_made + 1;

    winner = winner_of(ref board);
    if winner != 0 {
      print "";
      print_board(ref board);
      let win_msg: OwnedStr = player_label(winner) + " wins!";
      print win_msg;
      break;
    }
    if moves_made >= 9 {
      print "";
      print_board(ref board);
      let draw_msg: OwnedStr = ansi_yellow() + "It's a draw." + ansi_reset();
      print draw_msg;
      break;
    }

    if player == 1 {
      player = 2;
    } else {
      player = 1;
    }
  }

  return 0;
}
