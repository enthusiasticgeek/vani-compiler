// build & run:
//   vanic run examples/language/english/option_box_recursive_struct.vani
//   vanic run examples/language/english/option_box_recursive_struct.vani --backend=c

intent "Regression for BUG-35: Option<Box<Node>> -- the canonical recursive-struct shape the Box<T>/RAII tutorial itself demonstrates -- crashed the LLVM backend. Same bug class as BUG-29 (2026-07-28): the payload_zero placeholder for a payload-less enum variant (Option.None here) only handled Str/OwnedStr as needing LLVM's `null` literal for a pointer-shaped slot; Box<T> (and raw pointers) also lower to a bare pointer but fell through to the integer `0` default, and `lli` rejected the resulting `insertvalue %Enum_X %s0, %Struct_Node* 0, 1` with 'integer constant must have integer type'. Fixed by adding Type::Box/Type::Ptr/Type::PtrMut to the same null-literal match arm BUG-29 already covers for Str/OwnedStr. Also the primary regression coverage for two later, deeper bugs found auditing this same file: BUG-95 (2026-08-03) -- the bare `Option.Some(...)` constructor written directly inside each struct literal's `next` field (as written below, no intermediate `let`) failed to resolve at all; and BUG-97 (2026-08-04) -- the C backend leaked every node in the chain, since the checker never even emitted a scope-exit Drop for a `Node` local (an unrelated masking bug made the checker treat `Node` as Copy). `valgrind --leak-check=full` on native AOT C builds: 0 errors, all heap blocks freed, since the BUG-97 fix.";

struct Node {
  value: i64,
  next: Option<Box<Node>>,
}

fn main() -> i64 {
  let tail: Node = Node { value: 3, next: Option.None };
  let mid: Node = Node { value: 2, next: Option.Some(box(tail)) };
  let head: Node = Node { value: 1, next: Option.Some(box(mid)) };
  print head.value;
  return 0;
}
