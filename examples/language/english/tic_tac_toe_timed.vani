// build & run:
//   vanic run examples/language/english/tic_tac_toe_timed.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/tic_tac_toe_timed.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/tic_tac_toe_timed.vani -o /tmp/ttt_timed && /tmp/ttt_timed

intent "Terminal tic-tac-toe, timed edition -- each player has 15 seconds per move; run out of time and you forfeit the game";

// A `task`/`join`/`Atomic<T>` demonstration built on top of
// examples/language/english/tic_tac_toe.vani's board/win-detection/
// color logic (duplicated here rather than shared, since this is a
// standalone example, not a library). See that file (and its
// tutorial, Intermediate 17) for the non-timed version's own
// commentary -- this file's comments focus on what's NEW: the timer.
//
// The core idea: each turn, spawn a `task` that does the actual
// blocking `stdin_read_line()` + validation loop (identical to the
// non-timed game's read_move), while the main thread independently
// polls a shared `Atomic<bool>` "done" flag on a short sleep_ms
// cadence, counting elapsed time. Whichever finishes first -- the
// human typing a valid move, or the clock -- decides the outcome.
//
// This is deliberately NOT a general-purpose "any blocking call with
// a timeout" pattern -- see the "Known limitation" note above
// read_move_worker below for why cancellation doesn't actually work
// here, and what the code does about it.

fn ansi_red() -> Str { return "\x1b[31m"; }
fn ansi_blue() -> Str { return "\x1b[34m"; }
fn ansi_yellow() -> Str { return "\x1b[33m"; }
fn ansi_reset() -> Str { return "\x1b[0m"; }

fn player_label(player: i64) -> OwnedStr {
  if player == 1 {
    return ansi_red() + "X" + ansi_reset();
  }
  return ansi_blue() + "O" + ansi_reset();
}

fn symbol_for(v: i64, pos: i64) -> OwnedStr {
  if v == 1 {
    return player_label(1);
  }
  if v == 2 {
    return player_label(2);
  }
  return i64_to_str(pos);
}

fn print_board(board: ref Vec<i64>) -> i64 {
  let row1: OwnedStr = " " + symbol_for(board[0], 1) + " | " + symbol_for(board[1], 2) + " | " + symbol_for(board[2], 3);
  let row2: OwnedStr = " " + symbol_for(board[3], 4) + " | " + symbol_for(board[4], 5) + " | " + symbol_for(board[5], 6);
  let row3: OwnedStr = " " + symbol_for(board[6], 7) + " | " + symbol_for(board[7], 8) + " | " + symbol_for(board[8], 9);
  print row1;
  print "---+---+---";
  print row2;
  print "---+---+---";
  print row3;
  return 0;
}

fn win_lines() -> Vec<i64> {
  return vec(
    0, 1, 2,  3, 4, 5,  6, 7, 8,
    0, 3, 6,  1, 4, 7,  2, 5, 8,
    0, 4, 8,  2, 4, 6
  );
}

fn winner_of(board: ref Vec<i64>) -> i64 {
  let lines: Vec<i64> = win_lines();
  let li: u64 = 0;
  while li < 8 as u64 {
    let base: u64 = li * 3 as u64;
    let a: i64 = board[lines[base] as u64];
    let b: i64 = board[lines[base + 1 as u64] as u64];
    let c: i64 = board[lines[base + 2 as u64] as u64];
    if a != 0 {
      if a == b {
        if b == c {
          return a;
        }
      }
    }
    li = li + 1 as u64;
  }
  return 0;
}

// Runs in a spawned `task` (a real OS thread), one per turn. Identical
// read-validate-retry loop to the non-timed game's read_move, except
// the result is published through `done`/`result` (Atomic<bool> /
// Atomic<i64>) instead of just being a return value -- the main
// thread needs to observe "are we done yet?" from OUTSIDE this
// thread, without blocking on it, which a plain return value can't
// do.
//
// KNOWN LIMITATION -- there is no way to cancel this task once
// spawned. vāṇी has no non-blocking or cancellable stdin read in v1
// (checked: `tcp_set_nonblocking`/`tcp_recv_nb` exist for sockets,
// nothing equivalent exists for stdin), and `Task<R>` is affine --
// the compiler requires every spawned task to eventually be `join`ed,
// no exceptions, no "fire and forget." So when the countdown below
// expires first, this thread is still sitting inside a real blocking
// `stdin_read_line()` call, and the game HAS to `join` it before the
// process can fully exit -- see the comment on that `join` in main()
// for what this means for the player who timed out.
fn read_move_worker(board: ref Vec<i64>, player: i64, done: mut ref Atomic<bool>, result: mut ref Atomic<i64>) -> i64 {
  while true {
    let prompt: OwnedStr = "Player " + player_label(player) + ", enter a position (1-9), or 'quit' to exit:";
    print prompt;
    flush_stdout();
    let input: OwnedStr = stdin_read_line();
    let trimmed: OwnedStr = str_trim(input);
    if trimmed == "" {
      let _ = atomic_store(result, 0 - 1);
      let _ = atomic_store(done, true);
      return 0 - 1;
    }
    if trimmed == "quit" {
      let _ = atomic_store(result, 0 - 1);
      let _ = atomic_store(done, true);
      return 0 - 1;
    }
    if let Option.Some(n) = parse_int(trimmed) {
      if n >= 1 {
        if n <= 9 {
          let idx: i64 = n - 1;
          if board[idx as u64] == 0 {
            let _ = atomic_store(result, idx);
            let _ = atomic_store(done, true);
            return idx;
          } else {
            print "That cell is already taken -- try again.";
          }
        } else {
          print "Please enter a number from 1 to 9.";
        }
      } else {
        print "Please enter a number from 1 to 9.";
      }
    } else {
      print "That's not a number -- try again.";
    }
  }
  return 0 - 1;
}

fn main() -> i64 {
  let board: Vec<i64> = vec_fill(9, 0);
  let player: i64 = 1;
  let winner: i64 = 0;
  let moves_made: i64 = 0;
  let turn_timeout_ms: i64 = 15000;
  let poll_ms: i64 = 200;

  print "vani tic-tac-toe -- timed edition (15 seconds per move, or you forfeit)";
  print "";

  while true {
    print_board(ref board);
    print "";

    let done: Atomic<bool> = atomic_new(false);
    let result: Atomic<i64> = atomic_new(0 - 1);
    let t: Task<i64> = task read_move_worker(ref board, player, mut ref done, mut ref result);

    // Race: poll `done` on a 200ms cadence against the countdown.
    // `task`/`join` must appear in the same block (v1 doesn't support
    // cross-block joins), so `t` is both spawned and joined here in
    // main(), not inside a helper -- this loop only ever READS `done`
    // through the atomic, it never joins.
    let elapsed_ms: i64 = 0;
    let timed_out: bool = false;
    while true {
      if atomic_load(ref done) {
        break;
      }
      if elapsed_ms >= turn_timeout_ms {
        timed_out = true;
        break;
      }
      sleep_ms(poll_ms);
      elapsed_ms = elapsed_ms + poll_ms;
    }

    if timed_out {
      let timeout_msg: OwnedStr = player_label(player) + "'s time ran out!";
      print timeout_msg;
      print "(the game is over -- still waiting on that player's pending input so the program can fully exit; press Enter or Ctrl-D)";
    }
    // Always exactly one `join`, always right here (same block as the
    // spawn above) -- required either way, but the WAIT differs: if
    // `done` was already true, this returns instantly. If we got here
    // via timeout, the worker thread is still blocked on a real
    // stdin_read_line() call with no way to interrupt it, so this
    // blocks for real until that player's pending input actually
    // arrives (or the process is killed) -- the honest consequence of
    // "no cancellable blocking I/O in v1," not a bug.
    let idx: i64 = join t;

    if timed_out {
      let winner_by_time: i64 = 3 - player;
      print "";
      print_board(ref board);
      let win_msg: OwnedStr = player_label(winner_by_time) + " wins on time!";
      print win_msg;
      return 0;
    }

    if idx < 0 {
      print "Goodbye!";
      return 0;
    }

    board[idx as u64] = player;
    moves_made = moves_made + 1;

    winner = winner_of(ref board);
    if winner != 0 {
      print "";
      print_board(ref board);
      let win_msg2: OwnedStr = player_label(winner) + " wins!";
      print win_msg2;
      break;
    }
    if moves_made >= 9 {
      print "";
      print_board(ref board);
      let draw_msg: OwnedStr = ansi_yellow() + "It's a draw." + ansi_reset();
      print draw_msg;
      break;
    }

    if player == 1 {
      player = 2;
    } else {
      player = 1;
    }
  }

  return 0;
}
