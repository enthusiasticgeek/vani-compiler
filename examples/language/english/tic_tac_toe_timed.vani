// build & run:
//   vanic run examples/language/english/tic_tac_toe_timed.vani                          # LLVM backend, JIT via lli
//   vanic run examples/language/english/tic_tac_toe_timed.vani --backend=c              # C backend, gcc
//   vanic build examples/language/english/tic_tac_toe_timed.vani -o /tmp/ttt_timed && /tmp/ttt_timed

intent "Terminal tic-tac-toe, timed edition -- each player has 15 seconds per move; run out of time and you forfeit the game";

// A `stdin_ready_within_ms` demonstration built on top of
// examples/language/english/tic_tac_toe.vani's board/win-detection/
// color logic (duplicated here rather than shared, since this is a
// standalone example, not a library). See that file (and its
// tutorial, Intermediate 17) for the non-timed version's own
// commentary -- this file's comments focus on what's NEW: the timer.
//
// The core idea: `stdin_ready_within_ms(timeout_ms) -> bool` is a
// genuinely NON-BLOCKING readiness poll on stdin (POSIX `poll()` on
// fd 0 / Windows `WaitForSingleObject` on the console input handle)
// -- it returns whether a full line is available WITHOUT reading it.
// `read_move` below calls it in short slices, clamped to whatever
// time is left in the turn's budget, and only calls the blocking
// `stdin_read_line()` once a slice reports readiness. That means a
// timeout is checked between every slice with nothing ever left
// half-read or half-blocked -- when time runs out, `read_move`
// returns immediately, no thread, no task, no lingering wait.
//
// This file used to spawn a `task` (a real OS thread) per turn and
// race it against a polled `Atomic<bool>` -- see this example's git
// history / the tutorial's older revision if you want to compare.
// That version had a real, unavoidable limitation: `Task<R>` is
// affine (every spawned task must eventually be `join`ed, no
// exceptions), and there was no way to interrupt a thread stuck
// inside a blocking `stdin_read_line()` call -- so when the clock
// ran out, the game still had to wait for that thread's pending
// read to actually complete before the process could exit. Async
// (`async fn`/`await`) wouldn't have fixed that either: v1's async
// surface still desugars synchronously (see docs/v1_limitations.md),
// so wrapping the same blocking call in `async fn` doesn't make it
// non-blocking, it just moves the same block onto whatever runs the
// async body. The actual fix was a non-blocking I/O primitive, not
// a different way to run a blocking one -- `stdin_ready_within_ms`
// is exactly that, and it means this game never needs a second
// thread at all.

fn ansi_red() -> Str { return "\x1b[31m"; }
fn ansi_blue() -> Str { return "\x1b[34m"; }
fn ansi_yellow() -> Str { return "\x1b[33m"; }
fn ansi_reset() -> Str { return "\x1b[0m"; }

fn player_label(player: i64) -> OwnedStr {
  if player == 1 {
    return ansi_red() + "X" + ansi_reset();
  }
  return ansi_blue() + "O" + ansi_reset();
}

fn symbol_for(v: i64, pos: i64) -> OwnedStr {
  if v == 1 {
    return player_label(1);
  }
  if v == 2 {
    return player_label(2);
  }
  return i64_to_str(pos);
}

fn print_board(board: ref Vec<i64>) -> i64 {
  let row1: OwnedStr = " " + symbol_for(board[0], 1) + " | " + symbol_for(board[1], 2) + " | " + symbol_for(board[2], 3);
  let row2: OwnedStr = " " + symbol_for(board[3], 4) + " | " + symbol_for(board[4], 5) + " | " + symbol_for(board[5], 6);
  let row3: OwnedStr = " " + symbol_for(board[6], 7) + " | " + symbol_for(board[7], 8) + " | " + symbol_for(board[8], 9);
  print row1;
  print "---+---+---";
  print row2;
  print "---+---+---";
  print row3;
  return 0;
}

fn win_lines() -> Vec<i64> {
  return vec(
    0, 1, 2,  3, 4, 5,  6, 7, 8,
    0, 3, 6,  1, 4, 7,  2, 5, 8,
    0, 4, 8,  2, 4, 6
  );
}

fn winner_of(board: ref Vec<i64>) -> i64 {
  let lines: Vec<i64> = win_lines();
  let li: u64 = 0;
  while li < 8 as u64 {
    let base: u64 = li * 3 as u64;
    let a: i64 = board[lines[base] as u64];
    let b: i64 = board[lines[base + 1 as u64] as u64];
    let c: i64 = board[lines[base + 2 as u64] as u64];
    if a != 0 {
      if a == b {
        if b == c {
          return a;
        }
      }
    }
    li = li + 1 as u64;
  }
  return 0;
}

// Reads one validated move for `player`, racing against
// `turn_timeout_ms` total budget. Polls stdin readiness in
// `poll_ms` slices (clamped to whatever's left of the budget) so no
// slice ever overruns the deadline, and only calls the blocking
// `stdin_read_line()` once a full line is already known to be
// available -- so a timeout never leaves anything blocked. Returns
// the chosen 0-based board index, or:
//   -1  timed out (deadline reached with no valid move entered)
//   -2  player typed 'quit' or hit Enter on an empty line
fn read_move(board: ref Vec<i64>, player: i64, turn_timeout_ms: i64, poll_ms: i64) -> i64 {
  let elapsed_ms: i64 = 0;
  let prompted: bool = false;
  while true {
    if elapsed_ms >= turn_timeout_ms {
      return 0 - 1;
    }
    if !prompted {
      let prompt: OwnedStr = "Player " + player_label(player) + ", enter a position (1-9), or 'quit' to exit:";
      print prompt;
      flush_stdout();
      prompted = true;
    }
    let budget: i64 = turn_timeout_ms - elapsed_ms;
    let slice: i64 = poll_ms;
    if slice > budget {
      slice = budget;
    }
    let ready: bool = stdin_ready_within_ms(slice);
    elapsed_ms = elapsed_ms + slice;
    if !ready {
      continue;
    }
    let input: OwnedStr = stdin_read_line();
    let trimmed: OwnedStr = str_trim(input);
    if trimmed == "" {
      return 0 - 2;
    }
    if trimmed == "quit" {
      return 0 - 2;
    }
    if let Option.Some(n) = parse_int(trimmed) {
      if n >= 1 {
        if n <= 9 {
          let idx: i64 = n - 1;
          if board[idx as u64] == 0 {
            return idx;
          } else {
            print "That cell is already taken -- try again.";
            prompted = false;
          }
        } else {
          print "Please enter a number from 1 to 9.";
          prompted = false;
        }
      } else {
        print "Please enter a number from 1 to 9.";
        prompted = false;
      }
    } else {
      print "That's not a number -- try again.";
      prompted = false;
    }
  }
  return 0 - 1;
}

fn main() -> i64 {
  let board: Vec<i64> = vec_fill(9, 0);
  let player: i64 = 1;
  let winner: i64 = 0;
  let moves_made: i64 = 0;
  let turn_timeout_ms: i64 = 15000;
  let poll_ms: i64 = 200;

  print "vani tic-tac-toe -- timed edition (15 seconds per move, or you forfeit)";
  print "";

  while true {
    print_board(ref board);
    print "";

    let idx: i64 = read_move(ref board, player, turn_timeout_ms, poll_ms);

    if idx == 0 - 1 {
      let winner_by_time: i64 = 3 - player;
      let timeout_msg: OwnedStr = player_label(player) + "'s time ran out!";
      print timeout_msg;
      let win_msg: OwnedStr = player_label(winner_by_time) + " wins on time!";
      print win_msg;
      return 0;
    }

    if idx == 0 - 2 {
      print "Goodbye!";
      return 0;
    }

    board[idx as u64] = player;
    moves_made = moves_made + 1;

    winner = winner_of(ref board);
    if winner != 0 {
      print "";
      print_board(ref board);
      let win_msg2: OwnedStr = player_label(winner) + " wins!";
      print win_msg2;
      break;
    }
    if moves_made >= 9 {
      print "";
      print_board(ref board);
      let draw_msg: OwnedStr = ansi_yellow() + "It's a draw." + ansi_reset();
      print draw_msg;
      break;
    }

    if player == 1 {
      player = 2;
    } else {
      player = 1;
    }
  }

  return 0;
}
