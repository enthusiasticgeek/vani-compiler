// break value / loop-as-expression feature.
//
// Tests:
//   1. Simple `let x = while ... { break val; }` lowering.
//   2. Labeled loops with `break 'label val;`.
//   3. `continue 'label;` jumping to outer loop.
//
// build & run:
//   vanic run examples/language/english/break_value.vani --backend=c

intent "break value and labeled loops";

fn search_first_positive(limit: i64) -> i64 {
  let n: i64 = 0 - limit;
  let result: i64 = while true {
    let i: i64 = n;
    n = n + 1;
    if i > 0 {
      // Regression test for BUG-174 (fixed): `break i;` used to
      // be ambiguously parsed as "break to the loop label named
      // i" even though no such label is in scope here -- the
      // parser now only takes the label interpretation when the
      // identifier matches an actual active loop label. This
      // path actually executes (n counts up from -limit), so it
      // exercises both the parse AND the runtime break-value.
      break i;
    }
  };
  return result;
}

fn labeled_break_outer() -> i64 {
  let found: i64 = 0;
  'outer: for i from 0 to 5 {
    for j from 0 to 5 {
      if i + j == 6 {
        found = i + j;
        break 'outer;
      }
    }
  }
  return found;
}

fn main() -> i64 {
  let r1: i64 = search_first_positive(10);
  print "break value:", r1;

  let r2: i64 = labeled_break_outer();
  print "labeled break outer found:", r2;

  return 0;
}
