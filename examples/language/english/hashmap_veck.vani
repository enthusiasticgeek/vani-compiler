// ARC 4.6 — HashMap<Vec<i64>, V>: Vec<i64> keys. Hash is
// length-prefixed FNV-1a over each element; equality is
// lengths-equal then memcmp of data. Map deep-clones each
// Vec's data buffer on insert (same affine workaround as
// ARC 4.1/4.2 — sidesteps local-drop double-free); drop
// walks free each stored data buffer.
//
// build & run:
//   vanic run examples/language/english/hashmap_veck.vani                   # LLVM backend
//   vanic run examples/language/english/hashmap_veck.vani --backend=c       # C backend

intent "HashMap<Vec<i64>, V> — Vec-keyed open-addressing map (ARC 4.6)";

fn unwrap_or(o: Option<i64>, def: i64) -> i64 {
  return match o {
    Option.Some(v) then v,
    Option.None then def,
  };
}

fn main() -> i64 {
  let m: HashMap<Vec<i64>, i64> = hashmap_new();

  let k1: Vec<i64> = vec(1, 2, 3);
  let _ = hashmap_insert(mut ref m, k1, 100);
  let k2: Vec<i64> = vec(4, 5, 6);
  let _ = hashmap_insert(mut ref m, k2, 200);
  let k3: Vec<i64> = vec(1, 2, 3);
  let p3: Option<i64> = hashmap_insert(mut ref m, k3, 999);
  print "overwrite [1,2,3] prev (100):", unwrap_or(p3, 0 - 1);

  let lk1: Vec<i64> = vec(1, 2, 3);
  print "get [1,2,3] (999):", unwrap_or(hashmap_get(ref m, lk1), 0 - 1);
  let lk2: Vec<i64> = vec(4, 5, 6);
  print "get [4,5,6] (200):", unwrap_or(hashmap_get(ref m, lk2), 0 - 1);
  let lk_miss: Vec<i64> = vec(7, 8, 9);
  print "get [7,8,9] (none):", unwrap_or(hashmap_get(ref m, lk_miss), 0 - 1);

  // Vecs that differ by length must hash to a different
  // bucket than [1,2,3] — exercises the length-prefix path.
  let lk_short: Vec<i64> = vec(1, 2);
  print "contains [1,2]:", hashmap_contains_key(ref m, lk_short);

  let ck1: Vec<i64> = vec(1, 2, 3);
  print "contains [1,2,3]:", hashmap_contains_key(ref m, ck1);

  let rk: Vec<i64> = vec(1, 2, 3);
  let r: Option<i64> = hashmap_remove(mut ref m, rk);
  print "remove [1,2,3] (999):", unwrap_or(r, 0 - 1);
  let ck_after: Vec<i64> = vec(1, 2, 3);
  print "contains [1,2,3] after remove:", hashmap_contains_key(ref m, ck_after);
  print "len after remove (1):", hashmap_len(ref m);

  return 0;
}
