// ARC 4.5 — HashMap<f64, V>: f64 keys with built-in `==` and
// reinterpret-bits FNV-1a hashing.
//
// build & run:
//   vanic run examples/hashmap_f64.vani                   # LLVM backend
//   vanic run examples/hashmap_f64.vani --backend=c       # C backend
//
// NaN caveat: NaN != NaN per IEEE 754, so a NaN key inserted
// into the map cannot ever be looked up by another NaN. Use
// `f64_is_nan` to guard insertion if you need NaN-safe maps.

intent "HashMap<f64, V> — f64-keyed open-addressing map (ARC 4.5)";

fn unwrap_or(o: Option<i64>, def: i64) -> i64 {
  return match o {
    Option.Some(v) then v,
    Option.None then def,
  };
}

fn main() -> i64 {
  let m: HashMap<f64, i64> = hashmap_new();

  let p1: Option<i64> = hashmap_insert(mut ref m, 3.14, 100);
  let p2: Option<i64> = hashmap_insert(mut ref m, 2.71, 200);
  let p3: Option<i64> = hashmap_insert(mut ref m, 3.14, 999);
  print "insert k=3.14 prev (None):", unwrap_or(p1, 0 - 1);
  print "insert k=2.71 prev (None):", unwrap_or(p2, 0 - 1);
  print "overwrite k=3.14 prev (100):", unwrap_or(p3, 0 - 1);

  print "get k=3.14 (999):", unwrap_or(hashmap_get(ref m, 3.14), 0 - 1);
  print "get k=2.71 (200):", unwrap_or(hashmap_get(ref m, 2.71), 0 - 1);
  print "get k=42.0 (none):", unwrap_or(hashmap_get(ref m, 42.0), 0 - 1);

  print "contains 3.14:", hashmap_contains_key(ref m, 3.14);
  print "contains 42.0:", hashmap_contains_key(ref m, 42.0);

  let r1: Option<i64> = hashmap_remove(mut ref m, 3.14);
  print "remove k=3.14 prev (999):", unwrap_or(r1, 0 - 1);
  print "contains 3.14 after remove:", hashmap_contains_key(ref m, 3.14);

  let n: i64 = hashmap_len(ref m);
  print "len after remove (1):", n;

  return 0;
}
