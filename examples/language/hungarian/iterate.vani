// vani-lang: hungarian
//
// build & run:
//   vanic run examples/language/hungarian/iterate.vani              # LLVM
//   vanic run examples/language/hungarian/iterate.vani --backend=c  # C

cél "Hungarian vec iteration";

fuggveny osszeg_vec(v: Vec<i64>) -> i64 {
  legyen osszeg: i64 = 0;
  minden i from 0 to len(v) {
    osszeg = osszeg + v[i];
  }
  visszatér osszeg;
}

fuggveny max_vec(v: Vec<i64>) -> i64 {
  legyen m: i64 = v[0];
  minden i from 1 to len(v) {
    ha v[i] > m {
      m = v[i];
    }
  }
  visszatér m;
}

fn main() -> i64 {
  legyen v: Vec<i64> = vec(3, 1, 4, 1, 5, 9);
  állítsd osszeg_vec(v) == 23;
  állítsd max_vec(v) == 9;
  nyomtass "osszeg =", osszeg_vec(v);
  nyomtass "max =", max_vec(v);
  visszatér 0;
}
