// vani-lang: hungarian
//
// build & run:
//   vanic run examples/language/hungarian/async_cancel_auto.vani              # LLVM
//   vanic run examples/language/hungarian/async_cancel_auto.vani --backend=c  # C

cél "Hungarian async/await smoke";

async fuggveny delay(ms: i64, v: i64) -> i64 {
  sleep_ms(ms);
  visszatér v;
}

fn main() -> i64 {
  legyen a: i64 = await(delay(5, 42));
  legyen b: i64 = await(delay(10, 7));

  állítsd a == 42;
  állítsd b == 7;
  nyomtass "delays:", a, b;
  visszatér 0;
}
