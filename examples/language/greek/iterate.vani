// vani-lang: greek
//
// build & run:
//   vanic run examples/language/greek/iterate.vani              # LLVM
//   vanic run examples/language/greek/iterate.vani --backend=c  # C

σκοπός "Greek vec iteration";

συνάρτηση athroisma_vec(v: αναφορά Vec<i64>) -> i64 {
  έστω total: i64 = 0;
  για i από 0 μέχρι len(v) {
    total = total + v[i];
  }
  επιστροφή total;
}

συνάρτηση megisto_vec(v: αναφορά Vec<i64>) -> i64 {
  έστω m: i64 = v[0];
  για i από 1 μέχρι len(v) {
    αν v[i] > m {
      m = v[i];
    }
  }
  επιστροφή m;
}

συνάρτηση main() -> i64 {
  έστω v: Vec<i64> = vec(3, 1, 4, 1, 5, 9);
  επιβεβαίωση athroisma_vec(αναφορά v) == 23;
  επιβεβαίωση megisto_vec(αναφορά v) == 9;
  εκτύπωση "sum =", athroisma_vec(αναφορά v);
  εκτύπωση "max =", megisto_vec(αναφορά v);
  επιστροφή 0;
}
