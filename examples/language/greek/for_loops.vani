// vani-lang: greek
//
// build & run:
//   vanic run examples/language/greek/for_loops.vani              # LLVM
//   vanic run examples/language/greek/for_loops.vani --backend=c  # C

σκοπός "Greek for-range loops — για/από/μέχρι";

συνάρτηση range_sum(start: i64, end: i64) -> i64 {
  έστω total: i64 = 0;
  για i από start μέχρι end {
    total = total + i;
  }
  επιστροφή total;
}

συνάρτηση count() -> i64 {
  έστω n: i64 = 0;
  για _i από 0 μέχρι 5 {
    n = n + 1;
  }
  επιστροφή n;
}

συνάρτηση main() -> i64 {
  επιβεβαίωση range_sum(1, 5) == 10;
  επιβεβαίωση count() == 5;
  εκτύπωση "athroisma =", range_sum(1, 5);
  επιστροφή 0;
}
