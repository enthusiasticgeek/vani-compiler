// vani-lang: finnish
//
// build & run:
//   vanic run examples/language/finnish/iterate.vani              # LLVM
//   vanic run examples/language/finnish/iterate.vani --backend=c  # C

tarkoitus "Finnish vec iteration";

funktio summa_vec(v: Vec<i64>) -> i64 {
  olkoon summa: i64 = 0;
  jokaiselle i lähtien 0 asti len(v) {
    summa = summa + v[i];
  }
  palaa summa;
}

funktio max_vec(v: Vec<i64>) -> i64 {
  olkoon m: i64 = v[0];
  jokaiselle i lähtien 1 asti len(v) {
    jos v[i] > m {
      m = v[i];
    }
  }
  palaa m;
}

fn main() -> i64 {
  olkoon v: Vec<i64> = vec(3, 1, 4, 1, 5, 9);
  vahvista summa_vec(v) == 23;
  vahvista max_vec(v) == 9;
  tulosta "summa =", summa_vec(v);
  tulosta "max =", max_vec(v);
  palaa 0;
}
