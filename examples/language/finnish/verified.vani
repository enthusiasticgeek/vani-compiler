// vani-lang: finnish
//
// build & run:
//   vanic run examples/language/finnish/verified.vani              # LLVM
//   vanic run examples/language/finnish/verified.vani --backend=c  # C

tarkoitus "SMT-verified clamp_low";

funktio clamp_low(x: i64, kynnys: i64) -> i64
vaatii kynnys >= 0;
{
  jos x < kynnys {
    palaa kynnys;
  } muuten {
    palaa x;
  }
}

fn main() -> i64 {
  vahvista clamp_low(0 - 5, 0) == 0;
  vahvista clamp_low(10, 3) == 10;
  tulosta clamp_low(0 - 5, 0);
  tulosta clamp_low(10, 3);
  palaa 0;
}
