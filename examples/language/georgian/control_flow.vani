// vani-lang: georgian
//
// build & run:
//   vanic run examples/language/georgian/control_flow.vani              # LLVM
//   vanic run examples/language/georgian/control_flow.vani --backend=c  # C

მიზანი "Georgian if/else and match control flow";

ჩამოთვლა ნიშანი { დადებითი, ნული, უარყოფითი }

ფუნქცია ნიშანი(x: i64) -> ნიშანი {
  თუ x > 0 {
    დაბრუნება ნიშანი.დადებითი;
  } სხვა თუ x == 0 {
    დაბრუნება ნიშანი.ნული;
  } სხვა {
    დაბრუნება ნიშანი.უარყოფითი;
  }
}

ფუნქცია ნიშნის_მნიშვნელობა(ნ: ნიშანი) -> i64 {
  დაბრუნება შესაბამისობა ნ {
    ნიშანი.დადებითი  მაშინ 1,
    ნიშანი.ნული      მაშინ 0,
    ნიშანი.უარყოფითი მაშინ 0 - 1,
  };
}

ფუნქცია main() -> i64 {
  დაამოწმე ნიშნის_მნიშვნელობა(ნიშანი(5))    == 1;
  დაამოწმე ნიშნის_მნიშვნელობა(ნიშანი(0))    == 0;
  დაამოწმე ნიშნის_მნიშვნელობა(ნიშანი(0-3))  == 0 - 1;
  ბეჭდვა "control flow OK";
  დაბრუნება 0;
}
