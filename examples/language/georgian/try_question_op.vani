// vani-lang: georgian
//
// build & run:
//   vanic run examples/language/georgian/try_question_op.vani              # LLVM
//   vanic run examples/language/georgian/try_question_op.vani --backend=c  # C

მიზანი "Georgian postfix ? early-return sugar on payloaded enums";

ჩამოთვლა არჩ { ზოგი(i64), არა }

ფუნქცია გაორმაგება_q(ო: არჩ) -> არჩ {
  მიეცი v: i64 = ო?;
  დაბრუნება არჩ.ზოგი(v * 2);
}

ფუნქცია გახსნა_ან(ო: არჩ, ნაგ: i64) -> i64 {
  დაბრუნება შესაბამისობა ო {
    არჩ.ზოგი(v) მაშინ v,
    არჩ.არა    მაშინ ნაგ,
  };
}

ფუნქცია main() -> i64 {
  მიეცი ა: არჩ = გაორმაგება_q(არჩ.ზოგი(5));
  დაამოწმე გახსნა_ან(ა, 0) == 10;

  მიეცი ბ: არჩ = გაორმაგება_q(არჩ.არა);
  დაამოწმე გახსნა_ან(ბ, 99) == 99;

  ბეჭდვა "ზოგი(5)? გაორმაგდა =", გახსნა_ან(ა, 0);
  ბეჭდვა "არა? ნაგ", გახსნა_ან(ბ, 99);
  დაბრუნება 0;
}
