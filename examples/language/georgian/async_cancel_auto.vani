// vani-lang: georgian
//
// build & run:
//   vanic run examples/language/georgian/async_cancel_auto.vani              # LLVM
//   vanic run examples/language/georgian/async_cancel_auto.vani --backend=c  # C

მიზანი "Georgian async/await smoke";

async ფუნქცია delay(ms: i64, v: i64) -> i64 {
  sleep_ms(ms);
  დაბრუნება v;
}

ფუნქცია main() -> i64 {
  მიეცი a: i64 = await(delay(5, 42));
  მიეცი b: i64 = await(delay(10, 7));

  დაამოწმე a == 42;
  დაამოწმე b == 7;
  ბეჭდვა "delays:", a, b;
  დაბრუნება 0;
}
