// vani-lang: georgian
//
// build & run:
//   vanic run examples/language/georgian/option_types.vani              # LLVM
//   vanic run examples/language/georgian/option_types.vani --backend=c  # C

მიზანი "Georgian payloaded enums via Opt<i64>";

ჩამოთვლა არჩ { ზოგი(i64), არა }

ფუნქცია გახსნა_ან(ო: არჩ, ნაგ: i64) -> i64 {
  დაბრუნება შესაბამისობა ო {
    არჩ.ზოგი(v) მაშინ v,
    არჩ.არა    მაშინ ნაგ,
  };
}

ფუნქცია არის_ზოგი(ო: არჩ) -> i64 {
  დაბრუნება შესაბამისობა ო {
    არჩ.ზოგი(v) მაშინ 1,
    არჩ.არა    მაშინ 0,
  };
}

ფუნქცია main() -> i64 {
  მიეცი ა: არჩ = არჩ.ზოგი(42);
  მიეცი ბ: არჩ = არჩ.არა;

  მიეცი x: i64 = გახსნა_ან(ა, 0);
  მიეცი y: i64 = გახსნა_ან(ბ, 100);

  დაამოწმე x == 42;
  დაამოწმე y == 100;
  დაამოწმე არის_ზოგი(ა) == 1;
  დაამოწმე არის_ზოგი(ბ) == 0;

  ბეჭდვა "ზოგი(42) =", x;
  ბეჭდვა "არა ნაგ 100 =", y;
  დაბრუნება 0;
}
