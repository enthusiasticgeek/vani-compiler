// vani-lang: swahili
//
// build & run:
//   vanic run examples/language/swahili/iterate.vani              # LLVM
//   vanic run examples/language/swahili/iterate.vani --backend=c  # C

lengo "Swahili vec iteration";

kazi jumla_vec(v: ref Vec<i64>) -> i64 {
  acha jumla: i64 = 0;
  kwa i kutoka 0 hadi len(v) {
    jumla = jumla + v[i];
  }
  rudi jumla;
}

kazi kubwa_vec(v: ref Vec<i64>) -> i64 {
  acha m: i64 = v[0];
  kwa i kutoka 1 hadi len(v) {
    ikiwa v[i] > m {
      m = v[i];
    }
  }
  rudi m;
}

kazi main() -> i64 {
  acha v: Vec<i64> = vec(3, 1, 4, 1, 5, 9);
  thibitisha jumla_vec(ref v) == 23;
  thibitisha kubwa_vec(ref v) == 9;
  chapisha "jumla =", jumla_vec(ref v);
  chapisha "kubwa =", kubwa_vec(ref v);
  rudi 0;
}
