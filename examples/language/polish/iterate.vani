// vani-lang: polish
//
// build & run:
//   vanic run examples/language/polish/iterate.vani              # LLVM
//   vanic run examples/language/polish/iterate.vani --backend=c  # C

cel "Polish vec iteration";

funkcja suma_vec(v: Vec<i64>) -> i64 {
  niech suma: i64 = 0;
  dla i od 0 to len(v) {
    suma = suma + v[i];
  }
  wroc suma;
}

funkcja max_vec(v: Vec<i64>) -> i64 {
  niech m: i64 = v[0];
  dla i od 1 to len(v) {
    jesli v[i] > m {
      m = v[i];
    }
  }
  wroc m;
}

fn main() -> i64 {
  niech v: Vec<i64> = vec(3, 1, 4, 1, 5, 9);
  potwierdz suma_vec(v) == 23;
  potwierdz max_vec(v) == 9;
  drukuj "suma =", suma_vec(v);
  drukuj "max =", max_vec(v);
  wroc 0;
}
