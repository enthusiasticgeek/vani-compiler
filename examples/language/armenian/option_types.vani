// vani-lang: armenian
//
// build & run:
//   vanic run examples/language/armenian/option_types.vani              # LLVM
//   vanic run examples/language/armenian/option_types.vani --backend=c  # C

նպատակ "Armenian payloaded enums via Opt<i64>";

թվարկում Ընտ { Ոմն(i64), Ոչ }

ֆունկցիա բաց_կամ(o: Ընտ, կանխ: i64) -> i64 {
  վերադարձ համապատասխանեցնել o {
    Ընտ.Ոմն(v) ապա v,
    Ընտ.Ոչ    ապա կանխ,
  };
}

ֆունկցիա կա_ոմն(o: Ընտ) -> i64 {
  վերադարձ համապատասխանեցնել o {
    Ընտ.Ոմն(v) ապա 1,
    Ընտ.Ոչ    ապա 0,
  };
}

ֆունկցիա main() -> i64 {
  թող ա: Ընտ = Ընտ.Ոմն(42);
  թող բ: Ընտ = Ընտ.Ոչ;

  թող x: i64 = բաց_կամ(ա, 0);
  թող y: i64 = բաց_կամ(բ, 100);

  հաստատել x == 42;
  հաստատել y == 100;
  հաստատել կա_ոմն(ա) == 1;
  հաստատել կա_ոմն(բ) == 0;

  տպել "Ոմն(42) =", x;
  տպել "Ոչ կանխ 100 =", y;
  վերադարձ 0;
}
