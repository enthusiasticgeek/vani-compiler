// vani-lang: armenian
//
// build & run:
//   vanic run examples/language/armenian/control_flow.vani              # LLVM
//   vanic run examples/language/armenian/control_flow.vani --backend=c  # C

նպատակ "Armenian if/else and match control flow";

թվարկում Նշան { Դրական, Զրո, Բացասական }

ֆունկցիա նշան(x: i64) -> Նշան {
  եթե x > 0 {
    վերադարձ Նշան.Դրական;
  } այլապես եթե x == 0 {
    վերադարձ Նշան.Զրո;
  } այլապես {
    վերադարձ Նշան.Բացասական;
  }
}

ֆունկցիա արժեք_նշան(ն: Նշան) -> i64 {
  վերադարձ համապատասխանեցնել ն {
    Նշան.Դրական     ապա 1,
    Նշան.Զրո        ապա 0,
    Նշան.Բացասական  ապա 0 - 1,
  };
}

ֆունկցիա main() -> i64 {
  հաստատել արժեք_նշան(նշան(5))   == 1;
  հաստատել արժեք_նշան(նշան(0))   == 0;
  հաստատել արժեք_նշան(նշան(0-3)) == 0 - 1;
  տպել "control flow OK";
  վերադարձ 0;
}
