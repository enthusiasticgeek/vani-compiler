// vani-lang: pashto
موخه "Pashto early exit smoke-test";
کار لومړی_صفر(لیست: Vec<i64>) -> i64 {
  ووایه i: i64 = 0;
  تا i < (len(لیست) بطور i64) {
    که لیست[i] == 0 { بېرته i; }
    i = i + 1;
  }
  بېرته -1;
}
کار main() -> i64 {
  ووایه v: Vec<i64> = vec(0);
  v = push(v, 3);
  v = push(v, 0);
  v = push(v, 7);
  تایید لومړی_صفر(v) == 1;
  ووایه i: i64 = 0;
  تا i < 5 {
    که i == 3 { ودروه; }
    i = i + 1;
  }
  تایید i == 3;
  ولیکه "Pashto early exit OK";
  بېرته 0;
}
