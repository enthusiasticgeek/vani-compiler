// vani-lang: pashto
موخه "Pashto iterate smoke-test";
کار main() -> i64 {
  ووایه لیست: Vec<i64> = vec(0);
  لیست = push(لیست, 10);
  لیست = push(لیست, 20);
  لیست = push(لیست, 30);
  تایید لیست[0] == 10;
  تایید لیست[1] == 20;
  تایید لیست[2] == 30;
  ووایه ټول: i64 = 0;
  ووایه i: i64 = 0;
  تا i < (len(لیست) بطور i64) {
    ټول = ټول + لیست[i];
    i = i + 1;
  }
  تایید ټول == 60;
  ولیکه "Pashto iterate OK";
  بېرته 0;
}
