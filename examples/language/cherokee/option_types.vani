// vani-lang: cherokee
//
// build & run:
//   vanic run examples/language/cherokee/option_types.vani              # LLVM
//   vanic run examples/language/cherokee/option_types.vani --backend=c  # C
//
// Note: Cherokee has no native match keyword; Option<T> tested via ? chaining.

ᎤᎲᏍᏛ "Cherokee Option types smoke-test";

ᏗᎦᏬᏂᎯᏍᏗ safe_div(a: i64, b: i64) -> Option<i64> {
  ᎢᏳᏃ b == 0 {
    ᏗᎬᏎᏗ Option.None;
  } ᎪᎯ {
    ᏗᎬᏎᏗ Option.Some(a / b);
  }
}

ᏗᎦᏬᏂᎯᏍᏗ chain(a: i64, b: i64) -> Option<i64> {
  ᎠᏁᎳ v: i64 = safe_div(a, b)?;
  ᏗᎬᏎᏗ Option.Some(v * 2);
}

ᏗᎦᏬᏂᎯᏍᏗ main() -> i64 {
  ᎠᏁᎳ r1: Option<i64> = chain(10, 2);
  ᎠᏁᎳ r2: Option<i64> = chain(5, 0);
  ᎠᎴᏂᏍᎬᎢ "Cherokee option types OK";
  ᏗᎬᏎᏗ 0;
}
