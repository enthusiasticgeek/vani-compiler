// vani-lang: cherokee
//
// build & run:
//   vanic run examples/language/cherokee/verified.vani              # LLVM
//   vanic run examples/language/cherokee/verified.vani --backend=c  # C
//
// Note: Cherokee has no native requires keyword; ᎠᎩᏠᏯᏍᏗ (prove) used instead.

ᎤᎲᏍᏛ "Cherokee verified arithmetic smoke-test";

ᏗᎦᏬᏂᎯᏍᏗ clamp(x: i64, lo: i64, hi: i64) -> i64 {
  ᎢᏳᏃ x < lo {
    ᏗᎬᏎᏗ lo;
  } ᎪᎯ ᎢᏳᏃ x > hi {
    ᏗᎬᏎᏗ hi;
  } ᎪᎯ {
    ᏗᎬᏎᏗ x;
  }
}

ᏗᎦᏬᏂᎯᏍᏗ safe_subtract(a: i64, b: i64) -> i64 {
  ᎠᏁᎳ result: i64 = a - b;
  ᎠᎩᏠᏯᏍᏗ result + b == a;
  ᏗᎬᏎᏗ result;
}

ᏗᎦᏬᏂᎯᏍᏗ main() -> i64 {
  ᎯᏍᏗᏎᏍᏗ clamp(5, 1, 10) == 5;
  ᎯᏍᏗᏎᏍᏗ clamp(0, 1, 10) == 1;
  ᎯᏍᏗᏎᏍᏗ clamp(15, 1, 10) == 10;
  ᎯᏍᏗᏎᏍᏗ safe_subtract(10, 3) == 7;
  ᎠᎴᏂᏍᎬᎢ "Cherokee verified OK";
  ᏗᎬᏎᏗ 0;
}
