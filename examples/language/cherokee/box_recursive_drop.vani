// vani-lang: cherokee
//
// build & run:
//   vanic run examples/language/cherokee/box_recursive_drop.vani              # LLVM
//   vanic run examples/language/cherokee/box_recursive_drop.vani --backend=c  # C

ᎤᎲᏍᏛ "Cherokee Box recursive drop smoke-test";

ᎠᏙᏢᏍᎩ Node {
  val: i64,
  next: Option<Box<Node>>,
}

ᏗᎦᏬᏂᎯᏍᏗ main() -> i64 {
  ᎠᏁᎳ n3: Node = Node { val: 30, next: Option.None };
  ᎠᏁᎳ n2: Node = Node { val: 20, next: Option.Some(box(n3)) };
  ᎠᏁᎳ n1: Node = Node { val: 10, next: Option.Some(box(n2)) };
  ᎯᏍᏗᏎᏍᏗ n1.val == 10;
  ᎠᎴᏂᏍᎬᎢ "Cherokee box recursive drop OK";
  ᏗᎬᏎᏗ 0;
}
