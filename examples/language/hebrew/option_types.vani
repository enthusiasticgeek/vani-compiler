// vani-lang: hebrew
//
// build & run:
//   vanic run examples/language/hebrew/option_types.vani              # LLVM
//   vanic run examples/language/hebrew/option_types.vani --backend=c  # C

מטרה "Hebrew payloaded enums via Opt<i64>";

ספירה אפשרות { כן(i64), לא }

פונקציה פתח_או(א: אפשרות, ברירת_מחדל: i64) -> i64 {
  החזר התאם א {
    אפשרות.כן(ק) אז ק,
    אפשרות.לא   אז ברירת_מחדל,
  };
}

פונקציה יש_כן(א: אפשרות) -> i64 {
  החזר התאם א {
    אפשרות.כן(ק) אז 1,
    אפשרות.לא   אז 0,
  };
}

פונקציה main() -> i64 {
  יהי א: אפשרות = אפשרות.כן(42);
  יהי ב: אפשרות = אפשרות.לא;

  יהי ס: i64 = פתח_או(א, 0);
  יהי ץ: i64 = פתח_או(ב, 100);

  ודא ס == 42;
  ודא ץ == 100;
  ודא יש_כן(א) == 1;
  ודא יש_כן(ב) == 0;

  הדפס "כן(42) =", ס;
  הדפס "לא ברירת מחדל 100 =", ץ;
  החזר 0;
}
