// vani-lang: hebrew
//
// build & run:
//   vanic run examples/language/hebrew/control_flow.vani              # LLVM
//   vanic run examples/language/hebrew/control_flow.vani --backend=c  # C

מטרה "Hebrew if/else and match control flow";

ספירה סימן { חיובי, אפס, שלילי }

פונקציה סימן_מספר(ס: i64) -> סימן {
  אם ס > 0 {
    החזר סימן.חיובי;
  } אחרת אם ס == 0 {
    החזר סימן.אפס;
  } אחרת {
    החזר סימן.שלילי;
  }
}

פונקציה ערך_סימן(ס: סימן) -> i64 {
  החזר התאם ס {
    סימן.חיובי אז 1,
    סימן.אפס   אז 0,
    סימן.שלילי אז 0 - 1,
  };
}

פונקציה main() -> i64 {
  ודא ערך_סימן(סימן_מספר(5))    == 1;
  ודא ערך_סימן(סימן_מספר(0))    == 0;
  ודא ערך_סימן(סימן_מספר(0-3))  == 0 - 1;
  הדפס "control flow OK";
  החזר 0;
}
