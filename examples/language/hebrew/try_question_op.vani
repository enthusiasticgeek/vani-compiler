// vani-lang: hebrew
//
// build & run:
//   vanic run examples/language/hebrew/try_question_op.vani              # LLVM
//   vanic run examples/language/hebrew/try_question_op.vani --backend=c  # C

מטרה "Hebrew postfix ? early-return sugar on payloaded enums";

ספירה אפשרות { כן(i64), לא }

פונקציה כפול_שאלה(א: אפשרות) -> אפשרות {
  יהי ק: i64 = א?;
  החזר אפשרות.כן(ק * 2);
}

פונקציה פתח_או(א: אפשרות, ברירת_מחדל: i64) -> i64 {
  החזר התאם א {
    אפשרות.כן(ק) אז ק,
    אפשרות.לא   אז ברירת_מחדל,
  };
}

פונקציה main() -> i64 {
  יהי א: אפשרות = כפול_שאלה(אפשרות.כן(5));
  ודא פתח_או(א, 0) == 10;

  יהי ב: אפשרות = כפול_שאלה(אפשרות.לא);
  ודא פתח_או(ב, 99) == 99;

  הדפס "כן(5)? כופל =", פתח_או(א, 0);
  הדפס "לא? ברירת מחדל", פתח_או(ב, 99);
  החזר 0;
}
