// vani-lang: khmer
//
// build & run:
//   vanic run examples/language/khmer/option_types.vani              # LLVM
//   vanic run examples/language/khmer/option_types.vani --backend=c  # C

គោលបំណង "Khmer Option<T> smoke-test";

មុខងារ ចែកសុវត្ថិភាព(a: i64, b: i64) -> Option<i64> {
  បើ b == 0 {
    ត្រលប់ Option.None;
  }
  ត្រលប់ Option.Some(a / b);
}

មុខងារ ស្រាយ(o: Option<i64>, លំនាំដើម: i64) -> i64 {
  ត្រលប់ ផ្គូផ្គង o {
    Option.Some(v) បន្ទាប់មក v,
    Option.None បន្ទាប់មក លំនាំដើម,
  };
}

មុខងារ main() -> i64 {
  អោយ លទ្ធផល: Option<i64> = ចែកសុវត្ថិភាព(10, 2);
  អោយ v: i64 = ស្រាយ(លទ្ធផល, 0 - 999);
  បញ្ជាក់ v == 5;
  បោះពុម្ព "Khmer option OK", v;
  ត្រលប់ 0;
}
