// vani-lang: khmer
//
// build & run:
//   vanic run examples/language/khmer/iterate.vani              # LLVM
//   vanic run examples/language/khmer/iterate.vani --backend=c  # C

គោលបំណង "Khmer Vec iteration smoke-test";

មុខងារ main() -> i64 {
  អោយ បញ្ជី: Vec<i64> = vec();
  បញ្ជី = push(បញ្ជី, 10);
  បញ្ជី = push(បញ្ជី, 20);
  បញ្ជី = push(បញ្ជី, 30);
  បញ្ជាក់ បញ្ជី[0] == 10;
  បញ្ជាក់ បញ្ជី[1] == 20;
  បញ្ជាក់ បញ្ជី[2] == 30;
  បោះពុម្ព "Khmer iterate OK";
  ត្រលប់ 0;
}
