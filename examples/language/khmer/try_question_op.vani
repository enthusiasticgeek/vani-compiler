// vani-lang: khmer
//
// build & run:
//   vanic run examples/language/khmer/try_question_op.vani              # LLVM
//   vanic run examples/language/khmer/try_question_op.vani --backend=c  # C

គោលបំណង "Khmer ? operator smoke-test";

មុខងារ វិភាគ(n: i64) -> Option<i64> {
  បើ n < 0 {
    ត្រលប់ Option.None;
  }
  ត្រលប់ Option.Some(n * 3);
}

មុខងារ គណនា(n: i64) -> Option<i64> {
  អោយ v: i64 = វិភាគ(n)?;
  ត្រលប់ Option.Some(v + 1);
}

មុខងារ ស្រាយ(o: Option<i64>, លំនាំដើម: i64) -> i64 {
  ត្រលប់ ផ្គូផ្គង o {
    Option.Some(v) បន្ទាប់មក v,
    Option.None បន្ទាប់មក លំនាំដើម,
  };
}

មុខងារ main() -> i64 {
  អោយ ល្អ: Option<i64> = គណនា(4);
  អោយ v1: i64 = ស្រាយ(ល្អ, 0 - 999);
  បញ្ជាក់ v1 == 13;
  អោយ អាក្រក់: Option<i64> = គណនា(-1);
  អោយ v2: i64 = ស្រាយ(អាក្រក់, 0 - 999);
  បញ្ជាក់ v2 == 0 - 999;
  បោះពុម្ព "Khmer ? op OK";
  ត្រលប់ 0;
}
