// vani-lang: punjabi
//
// build & run:
//   vanic run examples/language/punjabi/control_flow.vani              # LLVM
//   vanic run examples/language/punjabi/control_flow.vani --backend=c  # C

ਉਦੇਸ਼ "if/else and while loops with Vec mutation";

// `ਜਦੋਂ` = while, `ਵੇਖੋ` = ref

ਕਾਰਜ sum(xs: ਵੇਖੋ Vec<i64>) -> i64 {
  ਮੰਨੋ total: i64 = 0;
  ਮੰਨੋ i: u64 = 0;
  ਮੰਨੋ n: u64 = len(xs);
  ਜਦੋਂ i < n {
    total = total + xs[i];
    i = i + 1;
  }
  ਮੁੜੋ total;
}

ਕਾਰਜ build_range(n: i64) -> Vec<i64> {
  ਮੰਨੋ xs: Vec<i64> = vec(0);
  ਮੰਨੋ i: i64 = 1;
  ਜਦੋਂ i < n {
    xs = push(xs, i);
    i = i + 1;
  }
  ਮੁੜੋ xs;
}

ਕਾਰਜ main() -> i64 {
  ਮੰਨੋ xs: Vec<i64> = build_range(5);
  ਮੰਨੋ total: i64 = sum(ਵੇਖੋ xs);
  ਜੇ total > 5 {
    ਨਿਸ਼ਚਿਤ total == 10;
  } ਵਰਨਾ {
    ਨਿਸ਼ਚਿਤ total <= 5;
  }
  ਲਿਖੋ total;
  ਮੁੜੋ 0;
}
