// vani-lang: swedish
//
// build & run:
//   vanic run examples/language/swedish/vec_invariants.vani              # LLVM
//   vanic run examples/language/swedish/vec_invariants.vani --backend=c  # C

syfte "Loop invariants over Vec length, end-to-end";

fn main() -> i64 {
  låt xs: Vec<i64> = vec(0);
  låt i: i64 = 1;

  medan i < 5
  oföränderlig len(xs) == (i som u64);
  oföränderlig i >= 1;
  oföränderlig i <= 5;
  {
    xs = push(xs, i * 10);
    i = i + 1;
  }

  bevisa i == 5;
  bevisa len(xs) == 5;

  skriv xs[0];
  skriv xs[1];
  skriv xs[2];
  skriv xs[3];
  skriv xs[4];

  återvänd 0;
}
