// vani-lang: italian
//
// build & run:
//   vanic run examples/language/italian/control_flow.vani              # LLVM
//   vanic run examples/language/italian/control_flow.vani --backend=c  # C

scopo "if/else and while control flow";

funzione sign(x: i64) -> i64 {
  se x > 0 {
    ritornare 1;
  } altrimenti {
    se x < 0 {
      ritornare 0 - 1;
    } altrimenti {
      ritornare 0;
    }
  }
}

funzione main() -> i64 {
  affermare sign(5) == 1;
  affermare sign(0 - 3) == 0 - 1;
  affermare sign(0) == 0;

  sia i: i64 = 0;
  mentre i < 5 {
    i = i + 1;
  }
  affermare i == 5;

  stampare sign(42);
  ritornare 0;
}
