// vani-lang: italian
//
// build & run:
//   vanic run examples/language/italian/async_cancel_auto.vani              # LLVM
//   vanic run examples/language/italian/async_cancel_auto.vani --backend=c  # C

scopo "Italian async/await smoke";

async funzione delay(ms: i64, v: i64) -> i64 {
  sleep_ms(ms);
  ritornare v;
}

funzione main() -> i64 {
  sia a: i64 = await(delay(5, 42));
  sia b: i64 = await(delay(10, 7));

  affermare a == 42;
  affermare b == 7;
  stampare "delays:", a, b;
  ritornare 0;
}
