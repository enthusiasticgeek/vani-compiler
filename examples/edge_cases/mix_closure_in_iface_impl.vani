// Iface method whose impl uses a closure inline.
interface Counter { fn tick(self: ref Self) -> i64; }
struct C { n: i64 }
implement Counter for C {
  fn tick(self: ref C) -> i64 {
    let f = fn(x: i64) -> i64 { return x + 1; };
    return f(self.n);
  }
}
fn main() -> i64 {
  let c: C = C { n: 41 };
  return c.tick();
}
