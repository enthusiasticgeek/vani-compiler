// श्री।
// Regression for bug #14: SSA-LLVM and tree-LLVM both emitted
// `fcmp one` (Ordered Not Equal) for the `!=` operator on
// floats. `one` returns FALSE when either operand is NaN, so
// `NaN != NaN` evaluated to 0 on the LLVM backend while the C
// backend's `!=` correctly returned 1 per IEEE 754.
// Fix routes `Ne` through `fcmp une` (Unordered Not Equal) so
// both backends agree: NaN != NaN is true.
fn main() -> i64 {
  let n: f64 = f64_nan();
  if n != n { return 1; }
  return 0;
}
