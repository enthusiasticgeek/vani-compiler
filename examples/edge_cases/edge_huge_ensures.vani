// Edge case: huge `ensures` clause with many conjunctions to
// stress-test SMT discharge.
fn classify(n: i64) -> i64
requires n >= 0;
requires n <= 100;
ensures _return >= 0;
ensures _return <= 5;
ensures (_return == 0) || (_return == 1) || (_return == 2)
     || (_return == 3) || (_return == 4) || (_return == 5);
{
  if n < 10 { return 0; }
  if n < 20 { return 1; }
  if n < 40 { return 2; }
  if n < 60 { return 3; }
  if n < 80 { return 4; }
  return 5;
}

fn main() -> i64 {
  print classify(35);
  return 0;
}
