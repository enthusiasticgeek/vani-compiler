// श्री।
// Regression for bug #12: `as` between integer types should
// wrap (two-complement truncate) at compile time too, matching
// Rust/C semantics. Pre-fix the const-fold path called the
// range-checked `eval_cast_constant` which rejected with
// "constant value 200 cannot be represented as i8" even though
// the user explicitly wrote `as i8`.
fn main() -> i64 {
  let x: i64 = 200;
  let y: i8 = x as i8;      // wraps to -56
  let z: i64 = y as i64;
  // Exit code returns -56 — shell wraps that to 200, which is
  // what we want the runtime + the const-fold to agree on.
  return z;
}
