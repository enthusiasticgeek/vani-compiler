// Arc 8 v3.1 Phase 2.1c — nested ifs inside suspending branches.
//
// Phase 2.1a/b accepted `if cond { suspend; return } else
// { return }` but rejected nested ifs INSIDE suspending
// branches. Phase 2.1c lifts that restriction: the recursive
// `collect_into` in the segment collector already handles
// arbitrary depth via recursive state allocation; only the
// branch validator was blocking it.
//
// build & run:
//   vanic run examples/echo_nested_if.vani                # LLVM
//   vanic run examples/echo_nested_if.vani --backend=c    # C

intent "Phase 2.1c — nested ifs inside a suspending branch";

async fn echo_nested(fd: i64, mode: i64, retries: i64) -> i64 {
  if mode > 0 {
    // Suspending branch with a NESTED if inside.
    let n: i64 = io_recv_async(fd, 64);
    if retries > 0 {
      // Nested then-branch returns — Phase 2.1c handles this
      // recursively, allocating its own state chain.
      return n + retries;
    } else {
      // Nested else-branch falls through to the outer return.
      return n;
    }
  }
  return 0 - 1;
}

fn drive(ep: i64, t: mut ref Task__echo_nested) -> i64 {
  while true {
    let r: i64 = __poll_echo_nested(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn main() -> i64 {
  let ep: i64 = epoll_new();
  let server: i64 = tcp_listen(0);
  let port: i64 = tcp_socket_port(server);
  print "server bound (port > 0):", port > 0;

  task client {
    let _ = sleep_ms(10);
    let c: i64 = tcp_connect_local(port);
    let _ = tcp_send_str(c, "abc");
    let _ = sleep_ms(50);
    let _ = tcp_close(c);
  }

  let cfd: i64 = tcp_accept(server);
  let _ = tcp_set_nonblocking(cfd);
  let _ = epoll_add_read(ep, cfd);

  // mode=1, retries=2 → outer-then, nested-then → n + retries
  let t: Task__echo_nested = echo_nested(cfd, 1, 2);
  let r: i64 = drive(ep, mut ref t);
  print "nested-then result:", r;

  join client;
  let _ = tcp_close(cfd);
  let _ = tcp_close(server);
  let _ = epoll_close(ep);
  return 0;
}
