// Arc 8 v3.1 Phase 2.1b — fall-through merge state.
//
// Phase 2.1a required both `if` branches to end with `return`.
// Phase 2.1b lifts that: a branch can fall through to a merge
// state holding the post-if code. The compiler allocates the
// merge state AFTER both branch recursions (so its index is
// monotonically highest), and emits a `Jump` at the tail of
// each non-return-terminated branch to transfer control to
// the merge state.
//
// build & run:
//   vanic run examples/echo_fall_through.vani                # LLVM
//   vanic run examples/echo_fall_through.vani --backend=c    # C

intent "Phase 2.1b fall-through — branch without return + merge state";

async fn cond_recv_then_merge(fd: i64, mode: i64) -> i64 {
  if mode > 0 {
    // Suspend, then fall through (no Return here) — Jumps to merge.
    let _ = io_recv_async(fd, 64);
  } else {
    // Explicit Return — Phase 2.1a path within Phase 2.1b mix.
    return 0 - 5;
  }
  // Merge-state code: runs after the then-branch falls through.
  return 100;
}

fn drive(ep: i64, t: mut ref Task__cond_recv_then_merge) -> i64 {
  while true {
    let r: i64 = __poll_cond_recv_then_merge(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn main() -> i64 {
  let ep: i64 = epoll_new();
  let server: i64 = tcp_listen(0);
  let port: i64 = tcp_socket_port(server);
  print "server bound (port > 0):", port > 0;

  task client {
    let _ = sleep_ms(10);
    let c: i64 = tcp_connect_local(port);
    let _ = tcp_send_str(c, "hi");
    let _ = sleep_ms(50);
    let _ = tcp_close(c);
  }

  let cfd: i64 = tcp_accept(server);
  let _ = tcp_set_nonblocking(cfd);
  let _ = epoll_add_read(ep, cfd);

  // Then-branch (mode = 1 > 0): recv suspend → fall through →
  // merge state runs `return 100`.
  let t: Task__cond_recv_then_merge = cond_recv_then_merge(cfd, 1);
  let r1: i64 = drive(ep, mut ref t);
  print "then-fall-through result:", r1;

  // Else-branch (mode = 0): explicit Return -5.
  let t2: Task__cond_recv_then_merge = cond_recv_then_merge(cfd, 0);
  let r2: i64 = drive(ep, mut ref t2);
  print "else-return result:", r2;

  join client;
  let _ = tcp_close(cfd);
  let _ = tcp_close(server);
  let _ = epoll_close(ep);
  return 0;
}
