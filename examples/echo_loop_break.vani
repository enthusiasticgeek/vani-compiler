// Arc 8 v3.1 Phase 2.5b — break/continue inside suspending loops.
//
// Phase 2.5 added loops with suspends inside. Phase 2.5b adds
// `break` and `continue` keywords:
// - `break` jumps to the innermost loop's post_loop state
// - `continue` jumps to the innermost loop's loop_header state
//
// The collector maintains a loop_stack of (loop_header,
// post_loop) pairs. When `break` / `continue` appear directly
// at the top of a loop body (or recursively inside a Verbatim
// Stmt::If's branches), they translate to state_tag jumps +
// `Stmt::Continue` to re-enter the synthesized while-true
// wrapping the poll fn body.
//
// build & run:
//   vanic run examples/echo_loop_break.vani                # LLVM
//   vanic run examples/echo_loop_break.vani --backend=c    # C

intent "Phase 2.5b — break inside a suspending while loop";

async fn read_until_eof(fd: i64) -> i64 {
  let total: i64 = 0;
  let i: i64 = 0;
  while i < 5 {
    let n: i64 = io_recv_async(fd, 64);
    if n == 0 {
      // EOF reached — break out of the loop. Compiler
      // rewrites this break to:
      //   __t.state_tag = post_loop;
      //   continue;  (the synthesized while-true's continue)
      break;
    }
    if n < 0 {
      return 0 - 1;
    }
    total = total + n;
    i = i + 1;
  }
  return total;
}

fn drive(ep: i64, t: mut ref Task__read_until_eof) -> i64 {
  while true {
    let r: i64 = __poll_read_until_eof(t);
    if r != 0 - 2 { return r; }
    let _ = epoll_wait_one(ep, 1000);
  }
  return 0;
}

fn main() -> i64 {
  let ep: i64 = epoll_new();
  let server: i64 = tcp_listen(0);
  let port: i64 = tcp_socket_port(server);
  print "server bound (port > 0):", port > 0;

  task client {
    let _ = sleep_ms(10);
    let c: i64 = tcp_connect_local(port);
    let _ = tcp_send_str(c, "stop");
    let _ = sleep_ms(50);
    let _ = tcp_close(c);
  }

  let cfd: i64 = tcp_accept(server);
  let _ = tcp_set_nonblocking(cfd);
  let _ = epoll_add_read(ep, cfd);

  // First read = "stop" = 4 bytes, total=4, i=1.
  // Second read = 0 (EOF after client closed), `break` jumps
  // to post_loop, returns total=4.
  let t: Task__read_until_eof = read_until_eof(cfd);
  let r: i64 = drive(ep, mut ref t);
  print "break-on-eof total:", r;

  join client;
  let _ = tcp_close(cfd);
  let _ = tcp_close(server);
  let _ = epoll_close(ep);
  return 0;
}
